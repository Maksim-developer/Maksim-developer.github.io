.main
	display flex
	width 100%
	min-height 100vh
	/ .wrapper--inner &
		padding-left 59px
		padding-top 59px
		transition padding .2s
		@media $mLandscapeMax
			padding-left 0
			padding-top 44px
			transition none
		/ .menu-open &
			padding-left 180px
			@media $mLandscapeMax
				padding-left 0
	/ .wrapper--chat
		& ^[0]__top
			align-items center
			padding-top 20px
			padding-bottom 19px
	&__burger
		display flex
		justify-content center
		align-items center
		position absolute
		top -59px
		left 0
		width 59px
		height 59px
		padding 0
		background none
		border none
		border-radius 0
		z-index 1
		@media $mLandscapeMax
			display none
		span
			display block
			position relative
			width 16px
			height 2px
			background-color #2d2d2d
			border-radius 1px
			&:before,
			&:after
				@extend .psElem
				left 0
				width 16px
				height 2px
				background-color #2d2d2d
				border-radius 1px
			&:before
				top -5px
			&:after
				bottom -5px
	&__logo
		display block
		position absolute
		top -59px
		left 0
		width 59px
		height 59px
		flex-shrink 0
		transition left .2s
		z-index 2
		@media $mLandscapeMax
			display none
		/ .menu-active &,
		/ .menu-open &
			left 59px
		&__logo-img
			width 100%
			height 100%
			object-fit cover
	&__aside
		display flex
		flex-direction column
		position fixed
		left 0
		top 59px
		max-width 190px
		height calc(100vh - 59px)
		background-color #2E2E2E
		z-index 1000
		@media $mLandscapeMax
			display none
			width 100%
			max-width 100%
			height calc(100% - 44px)
			top 44px
			background-color $default
			overflow-y auto
		&:before
			@extend .psElem
			left 100%
			top 0
			width calc(100vw - 180px)
			height 100%
			background-color rgba(#000, .25)
			opacity 0
			visibility hidden
			pointer-events none
			transition opacity .3s ease-in, visibility .3s ease-in
			z-index -1
			@media $mLandscapeMax
				display none
			/.open-submenu &
				opacity 1
				visibility visible
				pointer-events auto
	&__aside-bottom
		margin-top auto
		padding-bottom 24px
	&__exit
		display flex
		align-items center
		text-align left
		position relative
		width 100%
		background none
		border-radius 0
		border none
		user-select none
		&:hover
			&  ^[0]__exit-ico
				&:after
					opacity 1
					@media $mLandscapeMax
						opacity 0
			&  ^[0]__exit-title
				color #edeae6
				@media $mLandscapeMax
					color #d9d6d3
	&__exit-ico
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 59px
		height 48px
		flex-shrink 0
		font-size 0
		line-height 0
		transition opacity $duration
		opacity .8
		&:before
			content ''
			display block
			position relative
			width 14px
			height 16px
			background url('data:image/png;base64,') no-repeat center
			z-index 2
		&:after
			@extend .psElem
			top 50%
			left 50%
			transform translate(-50%, -50%)
			width 10px
			height 10px
			background #ff4747
			border-radius 50%
			box-shadow 0 0 15px 10px #ff4747
			transition opacity $duration
			opacity 0
			z-index 1
	&__exit-title
		position relative
		width 131px
		max-width 0
		color #d9d6d3
		font-size 12px
		font-weight 500
		line-height 14px
		white-space nowrap
		transition color $duration, max-width .2s, opacity $duration
		opacity 0
		overflow hidden
		@media $mLandscapeMax
			max-width 100%
			opacity 1
		/ .menu-active &,
		/ .menu-open &
			max-width 131px
			opacity 1
			@media $mLandscapeMax
				max-width 100%
	&__version
		position relative
	&__version-toggle
		display flex
		color #7f7f7f
		font-size 10px
		font-weight 300
		line-height 12px
		margin-top 38px
		padding-left 13px
		background none
		border none
		border-radius 0
		white-space nowrap
		user-select none
		cursor pointer
		span
			display block
			width 119px
			max-width 0
			flex-shrink 0
			opacity 0
			transition max-width .2s, opacity $duration
			pointer-events none
			overflow hidden
			@media $mLandscapeMax
				max-width 100%
				opacity 1
			/ .menu-active &,
			/ .menu-open &
				max-width 119px
				opacity 1
				@media $mLandscapeMax
					max-width 100%
	&__version-dropdown
		display none
		position absolute
		left 12px
		bottom calc(100% + 4px)
		width 248px
		padding 7px 0
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 2
		.os-host-overflow-y
			& ^[0]__version-item
				padding-right 20px
	&__version-axis-y
		max-height 238px
	// &__version-item
	&__version-href
		display block
		padding 6px 10px 8px
		color $default
		font-size 12px
		line-height 16px
		font-weight 400
		strong
			font-weight 600
	&__menu-toggle
		display flex
		align-items center
		position absolute
		bottom 21px
		right -32px
		width 32px
		height 32px
		padding 0
		background none
		border-radius 0
		border none
		z-index 1
		@media $mLandscapeMax
			display none
		span
			display flex
			flex-direction column
			justify-content center
			align-items center
			position relative
			width 16px
			height 20px
			background-color #d9d9d9
			border-radius 0px 3px 3px 0px
			pointer-events none
			&:before
				content ''
				display block
				width 5px
				height 8px
				background url('data:image/png;base64,') no-repeat center
				transition transform $duration
				/ .menu-open &
					transform scaleX(-1)
	&__content
		display flex
		flex-direction column
		position relative
		width 100%
		overflow hidden
		&--padding
			padding 31px 0 32px 24px
			@media $mLandscapeMax
				padding 15px 0
			& ^[0]__top
				padding-top 0
				padding-left 0
		> .table-wrap
			&:last-child
				padding-bottom 32px
		&--no-pb
			padding-bottom 0
			> .table-wrap
				&:last-child
					padding-bottom 0
	&__top
		display flex
		width 100%
		padding 30px 24px 29px
		@media $tPortraitMax
			padding 15px 16px
		@media $mLandscapeMax
			align-items center
		&--in-tabs
			align-items center
			padding 0 24px 30px 0
			& ^[0]__top-left
				margin-right 21px
			& + .table-wrap
				&:not(.table-wrap--height-auto)
					height 100%
				@media $mLandscapeMax
					border-top none
				.table
					&__head 
						.table__cell
							@media $mLandscapeMax
								padding-top 0
								min-height auto
					&__edit
						@media $mLandscapeMax
							align-items flex-start
					&__edit-checkbox
						@media $mLandscapeMax
							padding-top 0
		&--have-period
			& ^[0]__summ + ^[0]__top-search
				max-width: 1062px
		& + .tabs
			padding-top 0
	&__top-left
		display flex
		align-items flex-start
		margin-right 28px
		flex-shrink 0
		@media $tPortraitMax
			margin-right 16px
		.button-group
			margin-bottom -16px
			&__item
				&:last-child
					margin-right 0
	&__top-right
		display flex
		align-items center
		flex-wrap wrap
		width 100%
		.filter-wrap:not(:first-child)
			margin-top 10px
		.table-settings
			width auto
			padding 0
			border none
			&__item
				@media $mLandscapeMax
					display block
		> .table-settings
			display none
			@media $tPortrait
				display none !important
			@media $mLandscapeMax
				margin-left auto
				display block
		.period
			&__items
				margin-bottom 6px
	&__top-search
		display flex
		align-items center
		width 100%
		@media $mLandscapeMax
			justify-content flex-end
		@media $mLandscapeMax
			display none
	&__btn
		position relative
		margin-right 29px
		@media $tPortraitMax
			margin-right 12px
		&:last-child
			margin-right 0
		&.active
			& ^[0]__btn-add
				background-color $red
				border-color $red
				&:before
					background-image url('data:image/png;base64,')
	&__btn + &__title
		/.main__top .main__top-left &
			margin-top 8px
			@media $tPortraitMax
				margin-top 4px
	&__btn-add,
	&__btn-reload
		display flex
		justify-content center
		align-items center
		position relative
		width 42px
		height 42px
		padding 0
		background #fff
		border 1px solid $border
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		user-select none
		@media $tPortraitMax
			width 32px
			height 32px
		&:hover
			background-color $red
			border-color $red
		&:active
			transform scale(.97)
		&:before
			content ''
			display block
			background-repeat no-repeat
			background-position center
			transition background $duration
	&__btn-add
		&:hover
			&:before
				background-image url('data:image/png;base64,')
		&:before
			width 12px
			height 12px
			background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAMAAABhq6zVAAAAM1BMVEUAAAAyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjK5CPmRAAAAEHRSTlMA6wRCSfLRtS7idTUlHBUJQAiCmQAAAEhJREFUCNdljUkOgDAMA52t7OD/v5aoorRS5xArUWyjsmwXGkp6X4SGH+HxnVUfoaekVxIychZwALeZeXBPWVvAOUXPpShR/1+zYgJWuDBrBQAAAABJRU5ErkJggg==')
	&__btn-reload
		&:hover
			&:before
				background-image url('data:image/png;base64,')
		&:active
			&:before
				animation rotateReloadIcon .3s linear forwards
		&:before
			width 18px
			height 18px
			background-image url('data:image/png;base64,')
			transition background $duration, transform $duration
	&__btn-dropdown
		display none
		position absolute
		top calc(100% + 4px)
		left 0
		width 291px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 5
	&__btn-list
		padding 15px 0
	&__btn-list-href
		display block
		padding 9px 16px 8px
		color $default
		font-size 14px
		line-height 16px
		font-weight 500
		transition background $duration
		@media $mLandscapeMax
			padding-top 7px
			padding-bottom 8px
			font-size 12px
			line-height 14px
		&:hover
			background-color #fff7f7
		&:active
			font-weight 600
	&__btn-bookmark
		display flex
		justify-content center
		align-items center
		width 27px
		height 27px
		margin-left 6px
		padding 0
		background none
		border none
		transition transform .2s
		&:before
			content ''
			display block
			width 15px
			height 15px
			background url('data:image/png;base64,') no-repeat center
			transition background $duration
		&:active
			transform scale(.93)
		&:hover,
		&--active
			&:before
				background-image url('data:image/png;base64,')
	&__title
		color $default
		font-size 22px
		font-weight 600
		line-height 27px
		margin-bottom 30px
		@media $tPortraitMax
			font-size 18px
			line-height 24px
		@media $mLandscapeMax
			margin-bottom 2px
		/.main__top &
			margin-bottom 0
		.status
			position relative
			top 5px
			margin-left 10px
		&:first-child
			/.main__top .main__top-left &
				margin-top 8px
				@media $tPortraitMax
					margin-top 4px
		&--combi
			display flex
			width 100%
			@media $mLandscapeMax
				flex-wrap wrap
				padding 12px 16px
				border-bottom 1px solid $border
			@media $mPortraitMax
				font-size 14px
				line-height 16px
		& + ^[0]__top
			padding-top 0
			padding-left 0
			& ^[0]__btn
				&:first-child
					margin-top 3px
	&__title-number,
	&__title-dates
		display none
	&__title-number
		margin-left 6px
		font-size 18px
		line-height 24px
		@media $mLandscapeMax
			display block
		@media $mPortraitMax
			font-size 14px
			line-height 16px
	&__title-dates
		width 100%
		margin-top 11px
		@media $mLandscapeMax
			display flex
		@media $mPortraitIphoe6Max
			justify-content space-between
	&__title-date
		display flex
		align-items center
		margin-right 52px
		color #acacac
		font-size 12px
		font-weight 500
		line-height 14px
		@media $mPortraitIphoe6Max
			margin-right 16px
		&:last-child
			margin-right 0
		&:before
			content ''
			display block
			flex-shrink 0
			width 12px
			height 12px
			margin-right 6px
			background url('data:image/png;base64,') no-repeat center
			background-size contain
		&--post
			&:before
				background-image url('data:image/png;base64,')
	&__title-summ
		color $green
		font-size 18px
		font-weight 600
		line-height 22px
		margin-right 8px
		&:last-child
			margin-right 0
		&--warning
			color $red
	&__title-props
		display flex
		align-items center
		margin-left 13px
	&__title-prop
		display flex
		align-items baseline
		position relative
		margin-right 12px
		padding-left 19px
		&:last-child
			margin-right 0
		&:before
			content '·'
			display block
			position absolute
			top 50%
			left 0
			font-size 22px
			color #e2e2e2
			line-height 22px
			transform translateY(-50%)
	&__title-sutext
		color #c2c0bd
		font-size 14px
		font-weight 400
		line-height 16px
		margin-top 5px
	&__quantity
		display flex
		align-items center
		flex-shrink 0
		margin-top 15px
		margin-left 45px
	&__quantity-item
		display flex
		align-items center
		flex-shrink 0
		margin-right 19px
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		white-space nowrap
		&:last-child
			margin-right 0
		&:before
			content ''
			display block
			margin-right 10px
			background-repeat no-repeat
			background-position center
		&--users
			&:before
				width 10px
				height 13px
				background-image url('data:image/png;base64,')
		&--telegram
			&:before
				width 15px
				height 13px
				background url('data:image/png;base64,')
		&--cars
			&:before
				width 18px
				height 13px
				background-image url('data:image/png;base64,')
	&__table-settings,
	&__table-settings-toggle,
	&__table-settings-common
		flex-shrink 0
		width 38px
		height 38px
		padding 0
		background-repeat no-repeat
		background-position center
		background-color #fff
		border 1px solid #eeedec
		border-radius 6px
		transition background $duration, border $duration, transform .2s
		@media $tPortraitMax
			width 32px
			height 32px
		&:hover,
		&.active
			background-color $red
			border-color $red
		&:active
			transform scale(0.97)
	&__table-settings
		background-image url('data:image/png;base64,')
		&:hover,
		&.active
			background-image: url('data:image/png;base64,')
	&__table-settings-toggle
		background-image url('data:image/png;base64,')
		@media $mLandscapeMax
			display none
		&:hover,
		&.active
			background-image url('data:image/png;base64,')
	&__table-settings-common
		background-image url('data:image/png;base64,');
		&:hover,
		&.active
			background-image url('data:image/png;base64,')
	&__summ
		flex-shrink 0
		position relative
		margin-right 31px
		&.active
			& ^[0]__summ-btn
				&:after
					transform scaleY(-1)
		& + .main__top-search
			max-width 942px
			@media screen and (max-width: 1800px)
				max-width 768px
			@media $LargeDesktopMax
				max-width 608px
			@media screen and (max-width: 1439px)
				max-width 372px
	&__summ-btn
		position relative
		width 220px
		height 48px
		background white
		border 1px solid #eeedec
		border-radius 10px
		color $default
		font-size 20px
		font-weight 700
		line-height 46px
		text-align right
		padding 0 39px 0 16px
		white-space nowrap
		transition transform .2s
		&:active
			transform scale(.97)
		&:after
			@extend .psElem
			top 20px
			right 15px
			width 9px
			height 5px
			background url('data:image/png;base64,') no-repeat center
			transition transform $duration
			z-index 1
	&__summ-dropdown
		display none
		position absolute
		top calc(100% + 4px)
		left 0
		width 291px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 5
	&__summ-list
		padding 9px 0
	&__summ-list-item
		&:not(:last-child)
			margin-bottom 5px
	&__summ-list-item-href
		display flex
		justify-content space-between
		padding 9px 27px 9px 19px
		color $default
		font-size 12px
		font-weight 500
		line-height 20px
		transition background $duration
		&:hover
			background-color #fff7f7
	&__summ-list-item-left
		max-width calc(100% - 106px)
	&__summ-list-item-right
		text-align right
		font-size 14px
		font-weight 700
	&__bottom
		position absolute
		left 0
		right 0
		bottom 0
		margin-top auto
		border-top 1px solid $border
		background #fff
		z-index 1
		&--fixed
			position fixed
			left 59px
			transition left .2s
			/ .menu-open &
				left 180px
	&__bottom-container
		display flex
		align-items center
		position relative
		width 100%
		padding 14px 25px
		.pagination 
			&:not(:first-child)
				margin-left 321px
	&__bottom-toggle
		display flex
		align-items flex-end
		justify-content center
		position absolute
		top -32px
		right 34px
		width 32px
		height 32px
		padding 0
		background none
		border none
		border-radius 0
		transition transform .2s
		z-index 1
		&:active
			transform scale(.94)
		&.active
			span
				&:before
					transform scaleY(-1)
		span
			display flex
			justify-content center
			align-items center
			width 20px
			height 16px
			background-color #d9d9d9
			border-radius 3px 3px 0px 0px
			&:before
				content ''
				display block
				width 8px
				height 5px
				background url('data:image/png;base64,') no-repeat center
				transition transform $duration


@keyframes rotateReloadIcon
	from
		transform rotate(0deg)
	to
		transform rotate(360deg)
