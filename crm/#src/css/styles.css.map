.checkbox
	position relative
	font-size 0
	line-height 0
	&__input
		position absolute
		top 0
		left 0
		opacity 0
		pointer-events none
		&:checked ~ label
			background-color $red
			&:after
				opacity 1
	&__label
		display block
		width 17px
		height 17px
		background-color #edeceb
		border-radius 4px
		transition background $duration, transform .2s
		user-select none
		cursor pointer
		&:hover
			background-color $red
		&:after
			@extend .psElem
			top 5px
			left 5px
			width 8px
			height 4px
			border-left 1px solid #fff
			border-bottom 1px solid #fff
			transform rotate(-45deg)
			opacity 0
			transition opacity $duration
			cursor pointer
			z-index 2
	&--with-label
		display inline-block
		vertical-align top
		& ^[0]__input
			&:checked ~ label
				background none
				&:before
					background-color $red
		& ^[0]__label
			padding-left 30px
			width auto
			height auto
			color black
			font-size 12px
			font-weight 400
			line-height 17px
			border-radius 0
			background none
			&:hover
				background none
				&:before
					background-color $red
			&:active
				&:before
					transform scale(.9)
				&:after
					transform rotate(-45deg) scale(.9)
			&:before
				@extend .psElem
				top 0
				left 0
				width 17px
				height 17px
				background-color #edeceb
				border-radius 4px
				transition background $duration, opacity $duration, transform .2s
				z-index 1
			&:after
				transition opacity $duration, transform .2s
	&--with-actions
		& ^[0]__input
			&:checked ~ label
				.actions
					opacity 1
					visibility visible
		& ^[0]__label
			display flex
			align-items center
			justify-content space-between
			width 100%
			padding 1px 25px 1px 55px
			&:hover
				.actions
					opacity 1
					visibility visible
		.actions
			flex-shrink 0
			margin-left 12px
			opacity 0
			visibility hidden
			transition opacity $duration, visibility $duration
			&__item-btn:hover
				background-color #fff
	&:not(.checkbox--with-label)
		& ^[0]__label
			&:active
				transform scale(.90)
	&--accent,
	&--empty
		& ^[0]__label
			font-size 14px
			font-weight 600
	&--accent
		& ^[0]__label
			color $red
			span
				border-bottom 1px solid $red
				transition border $duration
			&:hover
				span
					border-bottom-color transparent
	&--empty
		& ^[0]__label
			color $default
			span
				border-bottom none
