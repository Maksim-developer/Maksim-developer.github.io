.mail
	display flex
	position relative
	width 100%
	height calc(100vh - 145px)
	border-top 1px solid $border
	&__aside
		width 319px
		height 100%
		border-right 1px solid $border
	&__aside-head
		display flex
		width 100%
		height 75px
		padding 15px 25px
		border-bottom 1px solid $border
	&__aside-body,
	&__content-body
		height calc(100% - 75px)
	&__aside-content
		padding 14px 25px
	&__axis-y
		width 100%
		height 100%
	&__content
		width calc(100% - 319px)
		height 100%
	&__content-head
		display flex
		align-items center
		width 100%
		height 75px
		padding-left 38px
		border-bottom 1px solid $border
	&__create-letter-btn,
	&__refresh-btn
		height 45px
	&__create-letter-btn
		flex-grow 1
	&__refresh-btn
		width 45px
		padding 0
		margin-left 10px
	&__folders
		margin-bottom 14px
		&:last-child
			margin-bottom 0
	&__folder
		display flex
		align-items center
		position relative
		width 100%
		height 36px
		padding-left 39px
		padding-right 7px
		border-radius 6px
		transition background $duration
		cursor pointer
		&:before
			@extend .psElem
			top 50%
			left 15px
			width 16px
			height 16px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAMBAMAAACZySCyAAAAJ1BMVEXY1tIAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tILbIYAAAAADHRSTlPyAGe07dPHtpeSWw4A9wB+AAAALUlEQVQI12NocXGJFgQChjNnzhxVUlJaCGSAwUkY4xiMcZgUxnGEdgMGMGACAE3SPy2MVBVeAAAAAElFTkSuQmCC') no-repeat center
			transform translateY(-50%)
			transition background $duration
		&:hover,
		&--active
			background-color #fef8f8
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAMBAMAAACZySCyAAAAJ1BMVEX/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AADSC5fvAAAADHRSTlPyAGe07dPHtpeSWw4A9wB+AAAALUlEQVQI12NocXGJFgQChjNnzhxVUlJaCGSAwUkY4xiMcZgUxnGEdgMGMGACAE3SPy2MVBVeAAAAAElFTkSuQmCC')
		&--active
			& ^[0]__folder-title
				font-weight 600
		&--incoming
			&:before
				background-image url('data:image/png;base64,')
		&--incoming:hover,
		&--incoming&--active
			&:before
				background-image url('data:image/png;base64,')
		&--my
			&:before
				background-image url('data:image/png;base64,')
		&--my:hover,
		&--my&--active
			&:before
				background-image url('data:image/png;base64,')
		&--sent
			&:before
				background-image url('data:image/png;base64,')
		&--sent:hover,
		&--sent&--active
			&:before
				background-image url('data:image/png;base64,')
		&--basket
			&:before
				background-image url('data:image/png;base64,')
		&--basket:hover
		&--basket&--active
			&:before
				background-image url('data:image/png;base64,')
		&--spam
			&:before
				background-image url('data:image/png;base64,')
		&--spam:hover,
		&--spam&--active
			&:before
				background-image url('data:image/png;base64,')
		&--drafts
			&:before
				background-image url('data:image/png;base64,')
		&--drafts:hover
		&--drafts&--active
			&:before
				background-image url('data:image/png;base64,')
	&__folder-title
		width calc(100% - 76px)
		color $default
		font-size 14px
		font-weight 400
		line-height 16px
		@extend .textOverflow
	&__folder-right
		width 68px
		display flex
		justify-content flex-end
	&__folder-numbers
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
	&__folder-button
		display block
		position relative
		height 24px
		padding 0
		background none
		border none
		&--toggle
			width 24px
			height 24px
			&:before,
			&:after
				@extend .psElem
				width 10px
				height 2px
				background-color #d8d6d2
				transition background $duration
			&:before
				top 11px
				left 7px
			&:after
				top 11px
				left 7px
				transform rotate(90deg)
			&:hover
				&:before,
				&:after
					background-color red
		&--clear
			color #d8d6d2
			font-size 12px
			font-weight 400
			line-height 20px
			transition color $duration
			&:hover
				color red
	&__filter-items
		display flex
		justify-content space-between
	&__filter-item
		width calc(50% - 5px)
	&__filter-button
		display flex
		justify-content center
		align-items center
		width 100%
		height 37px
		padding 0
		color #625f5a
		font-size 12px
		font-weight 500
		line-height 37px
		background-color #f9f9f8
		border-radius 6px
		border none
		transition background $duration 
		&:hover
			background-color #fef8f8
		&:before
			content ''
			display block
			background-repeat no-repeat
			background-position center
			transition background $duration
		&--bookmark
			&:before
				width 10px
				height 17px
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAARBAMAAAAWDSDWAAAALVBMVEXY1tIAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tK6YZOLAAAADnRSTlPyAO164cC4m4yEclJORPxHw8UAAAAxSURBVAjXY2hgYGBgYXgHAgx8QOIBgx6Z5DMwedEOSL4RlHzH8G6joGAdQ5SgoKAwAKu6N2eoXc+lAAAAAElFTkSuQmCC')
			&:hover
				&:before
					background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAARBAMAAAAWDSDWAAAAMFBMVEX/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AABoIZ3IAAAAD3RSTlPyAO3weuHAuJuMhHJSTkRiJR6PAAAAM0lEQVQI12OYzMDAwMrwHwQY7IHEBwZ9MsnvYPKh/2cG/b+CUv8Z/h8UFOxnyBYUFBQBAJJKO5ohwzB1AAAAAElFTkSuQmCC')
		&--unread
			&:before
				width 8px
				height 8px
				margin-right 10px
				border-radius 4px
				background-color #d8d6d2
			&:hover
				&:before
					background-color red
		&--write
			&:before
				width 17px
				height 17px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')

	&__letter
		display flex
		align-items center
		width 100%
		padding 15px
		border-bottom 1px solid $border
		transition background $duration
		cursor pointer
		&:hover,
		&--selected
			background-color #fef8f8
			& ^[0]__letter-checkbox-img
				opacity 0
				visibility hidden
			& ^[0]__letter-checkbox-item,
			& ^[0]__letter-bookmark
				opacity 1
				visibility visible
		&--unread
			& ^[0]__letter-status
				&:before
					background-color red
					border-color transparent
			& ^[0]__letter-title,
			& ^[0]__letter-from
				font-weight 600
		&--selected
			& ^[0]__letter-checkbox-img
				opacity 0
				visibility hidden
			& ^[0]__letter-checkbox-item
				background-image url('data:image/png;base64,')
				background-color red
				border-color red
				opacity 1
				visibility visible
		&--bookmark
			& ^[0]__letter-bookmark
				opacity 1
				visibility visible
				&:before
					background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAMBAMAAACtsOGuAAAALVBMVEX/AAD/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD5k6lJAAAADnRSTlPc8gDXkPTOzYuCZ1xMQ3+LdHAAAAAoSURBVAjXY3AUFBRhiHv37iED37t3DwgQdm/uPWZ4t0j7HUOGktJ0AGorHfCRsQezAAAAAElFTkSuQmCC')
	&__letter-actions
		display flex
		align-items center
		width 100%
		max-width 312px
		padding-right 5px
	&__letter-status
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		width 20px
		height 36px
		margin-right 4px
		padding 0
		background none
		border none
		&:before
			content ''
			display block
			width 9px
			height 9px
			background-color white
			border 1px solid #d8d6d2
			border-radius 5px
			box-sizing border-box
			transition background $duration, border $duration
		&:hover
			&:before
				background-color red
				border-color transparent
	&__letter-checkbox
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		position relative
		width 36px
		height 36px
		margin-right 18px
		padding 0
		background none
		border none
		transition background $duration
		z-index 1
		&:hover
			& ^[0]__letter-checkbox-item
				background-image url('data:image/png;base64,')
				background-color red
				border-color red
	&__letter-checkbox-img
		position absolute
		top 0
		left 0
		width 100%
		height 100%
		background-repeat no-repeat
		background-position center
		background-size cover
		z-index -1
		transition opacity .2s, visibility .2s
	&__letter-checkbox-item
		width 17px
		height 17px
		background-repeat no-repeat
		background-position center
		background-color white
		border 1px solid #eeedec
		border-radius 2px
		opacity 0
		visibility hidden
		transition background .2s, border .2s, opacity .2s, visibility .2s
	&__letter-from
		flex-grow 1
		margin-right 8px
		color $default
		font-size 14px
		font-weight 400
		line-height 16px
		@extend .textOverflow
		transition font .2s
	&__letter-bookmark
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		width 24px
		height 36px
		padding 0
		background none
		border none
		opacity 0
		visibility hidden
		transition opacity .2s, visibility .2s
		&:before
			content ''
			display block
			width 8px
			height 12px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAMBAMAAACtsOGuAAAALVBMVEXY1tLY1tIAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tIwIxZIAAAADnRSTlPc8wDXkPHOzYuCZ1xMQ+iK6LoAAAAoSURBVAjXY3AVFBRhkHv37iED37t3DwgQdm/uPWZ4t0j7HUOGktJ0AF2XHbQqhct+AAAAAElFTkSuQmCC') no-repeat center
			transition background $duration
		&:hover
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAMBAMAAACtsOGuAAAALVBMVEX/AAD/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD5k6lJAAAADnRSTlPc8gDXkPTOzYuCZ1xMQ3+LdHAAAAAoSURBVAjXY3AUFBRhiHv37iED37t3DwgQdm/uPWZ4t0j7HUOGktJ0AGorHfCRsQezAAAAAElFTkSuQmCC')
	&__letter-content
		display flex
		align-items center
		width calc(100% - 312px)
	&__letter-cell
		margin-right 24px
		&:last-child
			margin-right 0
		&--info
			display flex
			align-items center
			flex-grow 1
			@extend .textOverflow
		&--folder
			flex-shrink 0
			width 110px
		&--date
			flex-shrink 0
			width 172px
	&__letter-title,
	&__letter-text,
	&__letter-folder,
	&__letter-date
		display block
		font-size 14px
		font-weight 400
		line-height 16px
		@extend .textOverflow
	&__letter-title
		flex-shrink 0
		color $default
		margin-right 24px
		transition font .2s
	&__letter-text,
	&__letter-folder,
	&__letter-date
		color #acacac

	&__actions
		display flex
		align-items center
		margin-right 50px
		&:last-child
			margin-right 0
	&__action
		position relative
		margin-right 25px
		&:last-child
			margin-right 0
	&__action-button
		display flex
		align-items center
		min-width 32px
		text-align left
		padding 8px 0
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		@extend .textOverflow
		background none
		border none
		transition transform .2s
		&:active
			transform scale(.97)
		span
			margin-right 14px
		&:before
			content ''
			display block
			margin-right 11px
			background-repeat no-repeat
			background-position center
			transition background $duration, border $duration
		&--select-all
			&:before
				width 16px
				height 16px
				background-image url('data:image/png;base64,')
		&--select-all:hover,
		&--select-all&--active
			&:before
				background-image url('data:image/png;base64,')
		&--mark-all-read,
		&--read
			&:before
				width 12px
				height 12px
				border-radius 6px
				border 3px solid #d8d6d2
			&:hover
				&:before
					border-color red
		&--remove
			&:before
				width 14px
				height 16px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')
		&--move
			&:before
				width 16px
				height 14px
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAMBAMAAACZySCyAAAAJ1BMVEXY1tIAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tILbIYAAAAADHRSTlPyAGe07dPHtpeSWw4A9wB+AAAALUlEQVQI12NocXGJFgQChjNnzhxVUlJaCGSAwUkY4xiMcZgUxnGEdgMGMGACAE3SPy2MVBVeAAAAAElFTkSuQmCC')
			&:hover
				&:before
					background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAMBAMAAACZySCyAAAAJ1BMVEX/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AADSC5fvAAAADHRSTlPyAGe07dPHtpeSWw4A9wB+AAAALUlEQVQI12NocXGJFgQChjNnzhxVUlJaCGSAwUkY4xiMcZgUxnGEdgMGMGACAE3SPy2MVBVeAAAAAElFTkSuQmCC')
		&--spam
			&:before
				width 16px
				height 15px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')
		&--forward
		&--reply
			&:before
				width 14px
				height 12px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')
		&--reply
			&:before
				transform scaleX(-1)
	&__action-dropdown
		width 268px
		& ^[0]__folders
			padding 7px 0

	&__head
		display flex
		align-items center
		height 48px
		padding-right 25px
		padding-bottom 15px
		border-bottom 1px solid $border
		& + ^[0]__content
			height calc(100% - 48px)
	&__head-actions
		display flex
		align-items center
	&__head-actions-item
		margin-right 5px
		&:last-child
			margin-right 0
	&__head-actions-button
		display flex
		width 27px
		height 27px
		padding 0
		background-color #fff
		border none
		border-radius 5px
		transition background $duration, transform .2s
		&:hover
			background-color #f6f6f6
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			width 19px
			height 19px
			margin auto
			background-repeat no-repeat
			background-position center
			transition opacity $duration
			opacity .8
		&--write
			&:before
				background-image url('data:image/png;base64,')
				opacity 1
		&--reload
			&:before
				background-image url('data:image/png;base64,')
		&--search
			&:before
				background-image url('data:image/png;base64,')
		&--evaluate
			&:before
				background-image url('data:image/png;base64,')
		&--record
			&:before
				background-image url('data:image/png;base64,')
		&--settings
			&:before
				background-image url('data:image/png;base64,')
		&--burger
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABMAAAAPBAMAAAD0aukfAAAAJ1BMVEUAAACwrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq1XatBLAAAADHRSTlMAsMG+oJ53WZ1pZVT9/6FCAAAAMUlEQVQI12PY4gIFBQxnYOAAQ7IxFCQwEAQLBaFgApIJyKIEQZISFCQgm1ARCgERBQBbUyY7aWInCgAAAABJRU5ErkJggg==')

	&__menu
		display flex
		justify-content flex-end
		position absolute
		top 0
		right -100%
		width 100%
		height 100%
		background-color rgba(#000, .3)
		opacity 0
		visibility hidden
		transition opacity .2s, visibility .2s, right .2s
		z-index 1
		/ .mail--open-menu &
			right 0
			opacity 1
			visibility visible
			transition opacity .4s, visibility .4s, right .4s
	&__menu-container
		width 100%
		max-width 312px
		height 100%
		background-color white
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		@media $mPortraitIphoe6Max
			max-width 100%
	&__menu-head
		min-height 151px
		padding 24px 24px 22px
		border-bottom 1px solid $border
	&__account
		display flex
		flex-direction column
		align-items center
		text-align center
	&__account-avatar
		width 65px
		height 65px
		flex-shrink 0
		margin-bottom 6px
		border-radius 50%
		user-select none
		overflow hidden
	&__account-avatar-img
		width 100%
		height 100%
		object-fit cover
	&__account-name,
	&__account-email
		font-size 14px
		line-height 16px
		@extend .textOverflow
	&__account-name
		font-weight 500
	&__account-email
		color #c2c0bd
		border-bottom 1px solid #c2c0bd
		transition border $duration
		&:hover
			border-bottom-color transparent
	
	&__menu-actions
		display none
		justify-content center
		width 100%
		padding 15px 16px 0
		border-top 1px solid $border
	&__menu-actions-item
		margin 0 10px
	&__menu-actions-button
		display flex
		position relative
		width 32px
		height 32px
		padding 0
		background none
		border 1px solid #eeedec
		border-radius 50%
		&:before
			content ''
			display block
			width 20px
			height 20px
			margin auto
			background-repeat no-repeat
			background-position center
		&--reload
			&:before
				background-image url('data:image/png;base64,')
		&--search
			&:before
				background-image url('data:image/png;base64,')
		&--evaluate
			&:before
				background-image url('data:image/png;base64,')
		&--record
			&:before
				background-image url('data:image/png;base64,')
		&--settings
			&:before
				background-image url('data:image/png;base64,')

	&__menu-content
		padding 23px 22px 24px
	&__menu-content-title
		margin-bottom 8px
		color #d8d6d2
		font-size 9px
		font-weight 600
		line-height 11px
		text-transform uppercase

	&__create
		display flex
		justify-content flex-end
		position absolute
		top 0
		right -100%
		width 100%
		height 100%
		padding-left 24px
		padding-bottom 24px
		background-color #fff
		opacity 0
		visibility hidden
		transition opacity .2s, visibility .2s, right .2s
		z-index 1
		/ .mail--open-create &
			right 0
			opacity 1
			visibility visible
			transition opacity .4s, visibility .4s, right .4s
	&__create-head
		display flex
		align-items center
		height 38px
		padding-right 24px
		border-bottom 1px solid $border
	&__create-close-btn
		display flex
		align-items center
		margin-right auto
		padding 0
		text-align left
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		background none
		border none
		&:before
			content ''
			display block
			width 14px
			height 12px
			margin-right 24px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAMBAMAAACgrpHpAAAALVBMVEUAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tL3rveqAAAADnRSTlMA2wgQzQ7VxwXnE+3sur4vIdUAAABLSURBVAjXY2BgCBNgAAFWOQgd+EQBwr0A5ho+X2BsbGzAMO/1OyB4xiD38hyQfs6g8nyBkpKSAgOHXwEDGLQ8CwBRQAEBiEAbiAYAOsoWvc4z3EoAAAAASUVORK5CYII=') no-repeat center
	&__create-actions
		display flex
	&__create-action
		position relative
		margin-right 5px
		&:last-child
			margin-right 0
	&__create-action-btn
		display flex
		width 27px
		height 27px
		padding 0
		background-color #fff
		border none
		border-radius 5px
		transition background $duration, transform .2s
		&:hover
			background-color #f6f6f6
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			margin auto
			background-repeat no-repeat
			background-position center
			transition opacity $duration
			opacity .8
		&--attach
			&:before
				width 17px
				height 18px
				background-image url('data:image/png;base64,')
		&--send
			&:before
				width 16px
				height 14px
				background-image url('data:image/png;base64,')
		&--more
			&:before
				width 4px
				height 18px
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAASBAMAAACOUGLLAAAAD1BMVEUAAACwrq2wrq2wrq2wrq0i82qzAAAABHRSTlMA5knnASlJHwAAABhJREFUCNdjUBRiEHEEIhADBhCCykZYBQFY/gN1gz3ErQAAAABJRU5ErkJggg==')

	&--min
		display block
		height 100%
		border-top none
		& ^[0]__head-actions-item
			@media screen and (max-width: 700px)
				display none
			&--write,
			&--burger
				@media screen and (max-width: 700px)
					display block
		& ^[0]__head-actions-button
			@media screen and (max-width: 700px)
				width 32px
				height 32px
				border-radius 16px
			&--write
				&:before
					@media screen and (max-width: 700px)
						width 32px
						height 32px
						background-image url('data:image/png;base64,')
		& ^[0]__content
			position relative
			width 100%
		& ^[0]__content-head
			height 38px
			padding-left 0 
		& ^[0]__content-body
			height calc(100% - 98px)
		& ^[0]__action-button
			font-size 12px
			line-height 14px
		& ^[0]__letter
			justify-content space-between
			align-items flex-start
			padding 10px 22px 2px 0
		& ^[0]__letter-actions
			flex-direction column
			align-items center
			width 36px
			padding-right 0
		& ^[0]__letter-content
			display block
			width calc(100% - 50px)
		& ^[0]__letter-content-top,
		& ^[0]__letter-content-right
			display flex
			align-items flex-start
		& ^[0]__letter-content-top
			width 100%
			margin-bottom 4px
		& ^[0]__letter-content-right
			margin-left auto
		& ^[0]__letter-checkbox
			margin-right 0
		& ^[0]__letter-bookmark
			width 20px
			height 20px
			margin-right 2px
			margin-top -4px
			opacity 1
			visibility visible
		& ^[0]__letter-status
			width 18px
			height 18px
			&:before
				width 7px
				height 7px
		& ^[0]__letter-from,
		& ^[0]__letter-title,
		& ^[0]__letter-text
			font-size 12px
			line-height 12px
		& ^[0]__letter-title
			margin-bottom 4px
			margin-right 0
		& ^[0]__letter-date
			font-size 11px
			line-height 11px
		& ^[0]__content-footer
			padding-top 12px
			padding-bottom 12px
			@media screen and (max-width: 700px)
				padding-right 16px
		& ^[0]__filter-items
			justify-content center
			margin-left -6px
			margin-right -6px
		& ^[0]__filter-item
			width calc(25% - 12px)
			margin-left 6px
			margin-right 6px
			@media screen and (max-width: 700px)
				width calc(100%/3 - 12px)
		& ^[0]__menu-head
			@media screen and (max-width: 700px)
				flex-direction column
				min-height auto
				padding 16px 0
		& ^[0]__menu-content
			@media screen and (max-width: 700px)
				padding 16px
		
		& ^[0]__account
			@media screen and (max-width: 700px)
				width 100%
				flex-direction row
				justify-content center
				align-items center
				flex-grow 1
				padding 0 16px 15px
				@extend .textOverflow
		& ^[0]__account-avatar
			@media screen and (max-width: 700px)
				width 32px
				height 32px
				margin-right 12px
				margin-bottom 0
		& ^[0]__account-content
			@media screen and (max-width: 700px)
				max-width calc(100% - 44px)
				@extend .textOverflow
		& ^[0]__menu-actions
			@media screen and (max-width: 700px)
				display flex

		& ^[0]__create
			@media screen and (max-width: 700px)
				padding-left 0
		& ^[0]__create-head
			@media screen and (max-width: 700px)
				padding-left 16px
				padding-right 16px

	&--order
		& ^[0]__head,
		& ^[0]__content
			padding-left 24px
			@media screen and (max-width: 700px)
				padding-left 16px
		& ^[0]__head
			position relative
			border-bottom none
			@media screen and (max-width: 700px)
				padding-right 16px
			&:after
				@extend .psElem
				bottom 0
				left 24px
				width calc(100% - 24px)
				height 1px
				background-color $border
				pointer-events none
				@media screen and (max-width: 700px)
					left 0
					width 100%

