.notifications-checkboxes
	&__item
		position relative
		line-height 17px
		&:not(:last-child)
			margin-bottom 23px
	&__item-input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
		&:checked ~ label
			font-weight 500
			&:before
				background-color #ffe7e7
				border-color #d6b7b7
			&:after
				opacity 1
	&__item-label
		display inline-block
		vertical-align top
		position relative
		padding-left 43px
		color black
		font-size 14px
		font-weight 300
		line-height 17px
		cursor pointer
		user-select none
		&:hover
			font-weight 500
		&:before, &:after
			@extend .psElem
		&:before
			top 0
			left 0
			width 15px
			height 15px
			border 1px solid #ececec
			transition background $duration
			border-radius 2px
			z-index 1
		&:after
			top 5px
			left 4px
			width 8px
			height 4px
			border-left 1px solid #000
			border-bottom 1px solid #000
			transform rotate(-45deg)
			opacity 0
			transition opacity $duration
			cursor pointer
			z-index 2
