.inspection-act
	width 100%
	height calc(100vh - 316px)
	&__axis
		width 100%
		height 100%
	&__container
		display flex
		width 100%
		max-width 1676px
		padding-bottom 29px
	&__scheme
		display flex
		justify-content center
		width 866px
	&__scheme-toggle
		position absolute
		top 0
		left 0
		z-index 3
	&__scheme-item
		position relative
		width 692px
	&__scheme-area
		width 100%
	&__scheme-img
		display none
		width 100%
		padding-top 90.607%
		background-repeat no-repeat
		background-position center
		background-size contain
		user-select none
		&.active
			display block
	&__content
		width calc(100% - 866px)
		padding-left 40px
		border-left 1px solid #ececec
		padding-bottom 50px
	&__scheme-markers
		position absolute
		top 0
		left 0
		z-index 1
	&__scheme-context
		display none
		position absolute
		left 0
		top 0
		min-width 180px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 2
	&__scheme-context-items
		padding 7px 0
	&__scheme-context-btn
		display flex
		align-items center
		position relative
		width 100%
		padding 5px 16px
		text-align left
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		transition background $duration
		background none
		border none
		&:hover
			background-color #fff7f7

.ico-dent,
.ico-chip,
.ico-crack,
.ico-scratch
	&:before
		content ''
		display block
		flex-shrink 0
		width 30px
		height 30px
		margin-right 15px
		background-repeat no-repeat
		background-position center
		background-size contain

.ico-dent
	&:before
		background-image url('data:image/png;base64,')
.ico-chip
	&:before
		background-image url('data:image/png;base64,')
.ico-crack
	&:before
		background-image url('data:image/png;base64,')
.ico-scratch
	&:before
		background-image url('data:image/png;base64,')
