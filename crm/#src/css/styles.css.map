.uploaded-file
	&__label
		display flex
		justify-content center
		align-items center
		position relative
		width 100%
		height 325px
		background-color snow
		border 1px dashed #ffc3c3
		border-radius 10px
		cursor pointer
		user-select none
		&:hover
		&.drag_over
			border-width 2px
			& ^[0]__download-label-text
				span
					border-bottom-color transparent
	&__label-text
		display flex
		flex-wrap wrap
		justify-content center
		align-items flex-start
		position relative
		font-size 14px
		line-height 17px
		font-weight 300
		color #b4b4b4
		&:before
			content ''
			display block
			width 12px
			height 19px
			margin-top -2px
			margin-right 10px
			background url('data:image/png;base64,') no-repeat center
		span
			color #ff0101
			border-bottom 1px solid #ff0101
			transition border $duration
			margin-left 6px
	&__input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
	&--popup,
	&--min
		& ^[0]__label
			height 69px
			background #fff
			border 1px dashed #eeedec
			border-radius 6px
			transition background $duration, border $duration
			&:hover
				background-color snow
				border-color  #ffc3c3
		& ^[0]__label-text
			color #d8d6d2
			&:before
				width 12px
				height 13px
				margin-top 0
				margin-right 6px
				background-image url('data:image/png;base64,')
			span
				color $blue
				border-bottom none
