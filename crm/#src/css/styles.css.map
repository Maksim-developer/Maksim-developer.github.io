.actions
	display flex
	&__item
		&:not(:last-child)
			margin-right 6px
	&__item-btn
		display block
		position relative
		width 36px
		height 36px
		border-radius 18px
		background-repeat no-repeat
		background-position center
		transition background $duration
		&:hover
			background-color #f2f2f2
			&:after
				opacity 1
				visibility visible
				transition opacity .25s, visibility .25s
		&--edit
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
		&--accept
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
		&--print
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
		&--delete
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
		&--move
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
