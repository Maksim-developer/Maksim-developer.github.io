.btn-wrap
	position relative
	line-height normal

.btn
	display inline-flex
	justify-content center
	align-items center
	position relative
	flex-shrink 0
	padding 13px 24px 15px
	color $default
	font 600 14px/16px 'Montserrat', sans-serif
	background #fff
	border 1px solid #f0f0f0
	border-radius 6px
	transition color $duration, border $duration, background $duration, transform .2s
	cursor pointer
	user-select none
	&:hover
		color #fff
		border-color #e10000
		background-color #e10000
	&:active
		transform scale(0.97)
	&--no-border
		border-color transparent
		&:hover
			border-color transparent
	&--red,
	&--accent
		border-color $red
		&:hover
			border-color #e10000
			background-color #e10000
	&--red
		color $red
	&--accent
		color #fff
		background-color $red
	&--dropdown
		&:after
			content ''
			display block
			width 6px
			height 5px
			margin-left 8px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAFBAMAAACUdoDVAAAAGFBMVEUAAABvb29vb29vb29vb29vb29vb29vb29HCBSZAAAAB3RSTlMAvnJlTBcWcplpoAAAABxJREFUCNdjUGBgYihkEGdgNy5gYCsPYGBwYQAAFacCZhh8VDoAAAAASUVORK5CYII=') no-repeat center
			transition background $duration, transform $duration
		&:hover
			&:after
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAFCAQAAADMUVVtAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QA/4ePzL8AAAAJcEhZcwAACxIAAAsSAdLdfvwAAAAHdElNRQflCBwLEQz22AOtAAAAM0lEQVQI1y3CQQ2AMAAAsS5BA+hBADIwMIHzAyaOD2k185uqlbRqM+TGaUh7VUc2vC48fCo2HEcobB6/AAAAAElFTkSuQmCC')
	&--save,
	&--back,
	&--print,
	&--delete,
	&--phone,
	&--car,
	&--edit
		width 46px
		height 46px
		border-color #eeedec
		padding 0
		@media $mLandscapeMax
			width 30px
			height 30px
			padding 0
		&:after
			content ''
			display block
			background-repeat no-repeat
			background-position center
			transition background $duration
		&.active,
		&:hover
			border-color $red
			background-color $red
	&--save
		&:after
			width 17px
			height 17px
			background-image url('data:image/png;base64,')
			@media $mLandscapeMax
				width 14px
				height 14px
				background-size contain
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--back
		&:after
			width 15px
			height 13px
			background-image url('data:image/png;base64,')
			@media $mLandscapeMax
				width 11px
				height 9px
				background-size contain
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--print
		&:after
			width 19px
			height 17px
			background-image url('data:image/png;base64,')
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--delete
		&:after
			width 15px
			height 17px
			background-image url('data:image/png;base64,')
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--phone
		&:after
			width 17px
			height 17px
			background-image url('data:image/png;base64,')
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--car
		&:after
			width 21px
			height 14px
			background-image url('data:image/png;base64,')
		&.active,
		&:hover
			&:after
				background-image url('data:image/png;base64,')
	&--post
		@media $mLandscapeMax
			width 30px
			padding 0
			font-size 0
			color transparent
			background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAKCAMAAACzB5/1AAAAOVBMVEUAAAD///////////////////////////////////////////////////////////////////////8KOjVvAAAAEnRSTlMAN/FlJQTNcCbe2Luii09FPihTtjOnAAAAQElEQVQI103LSQ7AIAxDUbeFTsy+/2GBIJT83ZNlmNyfjNpJmm2oIkcveocOgLy9Co/YiWYXGcrSNkVq1fx/Wx3C6gKrHWmH4wAAAABJRU5ErkJggg==')
			background-repeat no-repeat
			background-position center
	&--letter,
	&--refresh
		&:before
			content ''
			display block
			background-repeat no-repeat
			background-position center
	&--letter
		&:before
			width 15px
			height 13px
			margin-right 10px
			background-image url('data:image/png;base64,')
			transform translateY(2px)
	&--refresh
		&:before
			width 13px
			height 13px
			background-image url('data:image/png;base64,')
	&--edit
		&:after
			width 17px
			height 17px
			background-image url('data:image/png;base64,')
			@media $mLandscapeMax
				width 14px
				height 14px

.btn-small
	display flex
	justify-content center
	align-items center
	width 24px
	height 24px
	padding 0
	background-repeat no-repeat
	background-position center
	background-color transparent
	border none
	border-radius 0
	transition background $duration
	&--archive
		background-image url('data:image/png;base64,')
		&:hover
			background-image url('data:image/png;base64,')
