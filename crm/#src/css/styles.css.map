.chat
	position relative
	width 100%
	height calc(100vh - 145px)
	border-top 1px solid $border
	&__body,
	&__head
		display flex
		width 100%
	&__head
		height 80px
		border-bottom 1px solid $border
		& ^[0]__aside
			padding 16px 25px 15px
		& ^[0]__content
			display flex
			align-items center
			padding 16px 25px 15px
	&__body
		height calc(100% - 80px)
		& ^[0]__content
			display flex
			flex-direction column
			position relative
			background-repeat no-repeat
			background-position 0 0
			background-size cover
			& ^[0]__axis-y
				flex-grow 1
				height auto
	&__aside
		width 498px
	&__content
		width calc(100% - 498px)
	&__content-wrap
		width 100%
		padding 25px 35px
		max-width 990px
	&__axis-y
		width 100%
		height 100%
		max-height 100%
		&.os-host-scrollbar-vertical-hidden 
			.os-scrollbar-vertical
				opacity 1
				visibility visible
		.os-viewport
			padding-right 12px
	&__user
		display flex
		align-items center
		position relative
		width 100%
		padding 15px 25px 15px 34px
		border-bottom 1px solid $border
		transition background $duration
		cursor pointer
		&:hover
			background-color #fef8f8
		&--pinned
			& ^[0]__user-content
				&:after
					@extend .psElem
					right 1px
					bottom 3px
					width 11px
					height 11px
					background url('data:image/png;base64,') no-repeat center
	&__user-overimg
		flex-shrink 0
		width 51px
		height 51px
		margin-right 16px
		background-color #f8f8f8
		border-radius 26px
		overflow hidden
	&__user-img
		width 100%
		height 100%
		object-fit cover
	&__user-content
		position relative
		width calc(100% - 67px)
	&__user-content-top
		display flex
		align-items center
		width 100%
		margin-bottom 9px
	&__user-name
		display flex
		align-items center
		width 100%
		margin-right auto
		padding-right 15px
		overflow hidden
	&__user-name-item
		flex-shrink 0
		display block
		max-width 100%
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		@extend .textOverflow
	&__user-muted
		width 13px
		height 10px
		flex-shrink 0
		margin-left 6px
		background url('data:image/png;base64,') no-repeat center
	&__user-checkmark
		flex-shrink 0
		width 19px
		height 9px
		margin-left 9px
		background url('data:image/png;base64,') no-repeat center
	&__user-time
		flex-shrink 0
		color #8a8a8a
		font-size 11px
		font-weight 300
		line-height 13px
		margin-left 5px
		&:first-child
			margin-left 0
	&__user-message
		display block
		max-width calc(100% - 32px)
		color #4d4d4d
		font-size 12px
		font-weight 300
		line-height 16px
		@extend .textOverflow
	&__user-unread-messages
		position absolute
		right 1px
		top 20px
		min-width 19px
		height 19px
		padding 0 4px
		text-align center
		color #fff
		font-size 12px
		font-weight 600
		line-height 19px
		background-color red
		border-radius 10px
		z-index 1

	&__user-profile
		display flex
		align-items center
		margin-right auto
	&__user-profile-overimg
		width 44px
		height 44px
		margin-right 27px
		border-radius 22px
		overflow hidden
	&__user-profile-img
		width 100%
		height 100%
		object-fit cover
	&__user-profile-items
		display flex
		align-items center
	&__user-profile-item
		margin-right 28px
		&:last-child
			margin-right 0
	&__user-profile-name
		margin-bottom 4px
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
	&__user-profile-time
		color #4d4d4d
		font-size 11px
		font-weight 300
		line-height 13px
	&__user-profile-summ
		margin-bottom 4px
		color $green
		font-size 14px
		font-weight 600
		line-height 16px
		&--warning
			color $red

	&__actions
		display flex
		align-items center
	&__actions-item
		margin-right 15px
		&:last-child
			margin-right 0
	&__actions-button
		display flex
		width 27px
		height 27px
		padding 0
		background-color #fff
		border none
		border-radius 5px
		transition background $duration, transform .2s
		&:hover
			background-color #f6f6f6
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			margin auto
			background-repeat no-repeat
			background-position center
			transition opacity $duration
			opacity .8
		&--search
			&:before
				width 17px
				height 17px
				background-image url('data:image/png;base64,')
		&--muted
			&:before
				width 17px
				height 13px
				background-image url('data:image/png;base64,')
		&--pin
			&:before
				width 17px
				height 17px
				background-image url('data:image/png;base64,')
		&--call
			&:before
				width 16px
				height 16px
				background-image url('data:image/png;base64,')
		&--create
			&:before
				width 17px
				height 17px
				background-image url('data:image/png;base64,')
		&--block
			&:before
				width 17px
				height 17px
				background-image url('data:image/png;base64,')
		&--evaluate
			&:before
				width 18px
				height 17px
				background-image url('data:image/png;base64,')
		&--record
			&:before
				width 18px
				height 17px
				background-image url('data:image/png;base64,')
		&--burger
			&:before
				width 19px
				height 15px
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABMAAAAPBAMAAAD0aukfAAAAJ1BMVEUAAACwrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq2wrq1XatBLAAAADHRSTlMAsMG+oJ53WZ1pZVT9/6FCAAAAMUlEQVQI12PY4gIFBQxnYOAAQ7IxFCQwEAQLBaFgApIJyKIEQZISFCQgm1ARCgERBQBbUyY7aWInCgAAAABJRU5ErkJggg==')

	&__status
		flex-shrink 0
		margin-left 30px
	&__status-btn
		display flex
		align-items center
		height 32px
		padding 8px
		color $default
		font-size 10px
		font-weight 400
		line-height 12px
		background white
		border 1px solid #eeedec
		border-radius 6px
		transition color $duration, background $duration, border $duration
		&:before
			content ''
			display block
			width 14px
			height 14px
			margin-right 8px
			background-image url('data:image/png;base64,')
			background-repeat no-repeat
			background-position center
			background-size contain
			transition background $duration
		&:hover,
		&--active
			color #288628
			background-color #f2fff2
			border-color #2caf2c
			&:before
				background-image url('data:image/png;base64,')

	&__message
		display flex
		flex-direction column
		width 100%
		margin-top 7px
		&:first-child
			margin-top 0
			& ^[0]__message-date
				padding-top 0
		&--right
			& ^[0]__message-body
				margin-right 0
				margin-left auto
			& ^[0]__message-overimg
				margin-left auto
				margin-right 0
			& ^[0]__message-text
				background-color #f2fff2
				border-radius 12px 12px 0px 12px
		&--img
			& ^[0]__message-body
				padding 0
			& ^[0]__message-overimg + ^[0]__message-info
				background-color rgba(#000, 0.7)
				padding-left 5px
				padding-right 5px
				& ^[0]__message-checkmark
					background-image url('data:image/png;base64,')
				& ^[0]__message-time
					color #fff
	&__message-date
		display flex
		justify-content center
		width 100%
		padding 14px 0
	&__message-date-item
		height 34px
		padding 10px 20px
		text-align center
		color #646464
		font-size 12px
		font-weight 500
		line-height 12px
		white-space nowrap
		background-color #fbfafa
		border-radius 17px
	&__message-container
		display flex
		align-items flex-end
		width 100%
	&__message-avatar
		flex-shrink 0
		width 44px
		height 44px
		margin-right: 16px
		background-color #f8f8f8
		border-radius 26px
		user-select none
		cursor pointer
		overflow hidden
		& + ^[0]__message-body
			max-width 542px
	&__message-avatar-img
		width 100%
		height 100%
		object-fit cover
	&__message-body
		display flex
		flex-direction column
		position relative
		max-width 602px
		margin-right auto
	&__message-text
		padding 17px 70px 17px 15px
		color $default
		font-size 14px
		font-weight 400
		line-height 17px
		background-color white
		border-radius 12px 12px 12px 0px
		box-shadow 0 2px 3px whitesmoke
	&__message-overimg
		position relative
		max-height 342px
		margin-right auto
		font-size 0
		line-height 0
		border-radius 12px
		overflow hidden
		user-select none
		cursor pointer
		& + ^[0]__message-text
			margin-top 5px
		&:hover
			& ^[0]__message-img-info
				opacity 1
				visibility visible
	&__message-img
		max-height 100%
	&__message-img-info
		display flex
		flex-direction column
		position absolute
		top 0
		right 0
		bottom 0
		left 0
		padding 7px
		background-color rgba(#000, .4)
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1
	&__message-img-name,
	&__message-img-size
		color white
		font-size 12px
		line-height 14px
		font-weight 500
	&__message-img-bottom
		display flex
		justify-content space-between
		align-items center
		width 100%
		margin-top auto
	&__message-img-size
		display block
		max-width calc(100% - 32px)
		line-height 19px
		@extend .textOverflow
		&:before
			content ''
			display inline-block
			vertical-align middle
			flex-shrink 0
			width 21px
			height 19px
			margin-right 7px
			background url('data:image/png;base64,') no-repeat center
	&__message-info
		display flex
		justify-content flex-end
		align-items center
		position absolute
		height 16px
		padding-top 1px
		padding-bottom 1px
		border-radius 6px
		right 10px
		bottom 10px
		z-index 1
	&__message-checkmark
		flex-shrink 0
		width 19px
		height 9px
		background url('data:image/png;base64,') no-repeat center
	&__message-time
		flex-shrink 0
		color #8a8a8a
		font-size 11px
		font-weight 300
		line-height 13px
		margin-left 5px
		&:first-child
			margin-left 0
	&__bottom
		width 100%
		min-height 190px
		background-color whitesmoke
		& ^[0]__content-wrap
			position relative
	&__bottom-mobile
		display none
		background-color whitesmoke
		& ^[0]__form-textarea-wrap
			position relative
			padding 8px 16px
		& ^[0]__form-textarea
			padding 13px 116px 13px 42px
			background-color #fff
			border-radius 10px
		& ^[0]__form-controls
			position absolute
			top 50%
			transform translateY(-50%)
			z-index 1
			&--left
				left 22px
			&--right
				right 22px
		& ^[0]__form-controls-item
			margin-right 8px
			&:last-child
				margin-right 0
	
	&__tabs
		width 100%
		height 100%
		padding 14px 14px 9px
		position relative
		background-color white
		border-radius 10px
	&__tabs-controls
		display flex
		align-items center
	&__tabs-controls-item
		margin-right 15px
		&:last-child
			margin-right 0
	&__tabs-controls-button
		display block
		padding 0
		color #939393
		font-size 12px
		font-weight 500
		line-height 14px
		background 0
		border none
		border-bottom 2px solid transparent
		transition color $duration, border $duration
		&:hover,
		&--active
			color $default
			border-bottom-color $default
	&__tabs-items
		position relative
		margin-top 18px
	&__tabs-item
		display none
		&--active
			display block

	&__form-textarea-wrap
		width 100%
		height 56px
	&__form-textarea
		display block
		width 100%
		height 100%
		padding 0
		color $default
		font-size 12px
		font-weight 300
		line-height 14px
		border none
		border-radius 0
		background none
		-ms-overflow-style none
		scrollbar-width none
		overflow hidden auto
		resize none
		&:focus
			outline none
		&::-webkit-scrollbar
			width 0
			height 0
		placeholder()
			color #939393
	&__form-controls
		display flex
		align-items center
		justify-content flex-end
	&__form-controls-item
		position relative
		margin-right 15px
		&:last-child
			margin-right 0
	&__form-controls-button
		display flex
		width 27px
		height 27px
		padding 0
		background-color #fff
		border none
		border-radius 5px
		transition background $duration, transform .2s
		&:hover
			background-color #f6f6f6
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			margin auto
			background-repeat no-repeat
			background-position center
			transition opacity $duration
			opacity .8
		&--template
			&:before
				width 18px
				height 14px
				background-image url('data:image/png;base64,')
		&--emoji
			&:before
				width 18px
				height 18px
				background-image url('data:image/png;base64,')
		&--attach
			&:before
				width 17px
				height 18px
				background-image url('data:image/png;base64,')
		&--voice
			&:before
				width 13px
				height 18px
				background-image url('data:image/png;base64,')
		&--send
			&:before
				width 16px
				height 14px
				background-image url('data:image/png;base64,')
	
	&__search
		display flex
		flex-direction column
		position absolute
		top 0
		right -500px
		width 495px
		height 100%
		background-color #fff
		border-left 1px solid $border
		transition right $duration
		pointer-events none
		z-index 1
		&.show
			right 0
			pointer-events auto
	&__search-head
		display flex
		align-items center
		width 100%
		height 80px
		padding 16px 25px 15px 12px
		border-bottom 1px solid $border
	&__search-close
		display flex
		flex-direction column
		width 44px
		height 44px
		padding 0
		margin-right 12px
		background none
		border none
		&:before
			content ''
			display block
			margin auto
			width 14px
			height 11px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAALCAMAAAB4W0xQAAAAOVBMVEUAAAATExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExKG72a+AAAAEnRSTlMAs0BIw/PjzFQM+OWqp5V6ZjB0BwIUAAAAQUlEQVQI113KWQ4AERRE0UJr9GCo/S+WIOE5fze56JzF5uItyon6VoR26qKHgJ8bBU++UU0eMHwMltbMRyfRlhgqzFQCm87UBc4AAAAASUVORK5CYII=') no-repeat center
		& + .form-searh
			width calc(100% - 81px)
	&__search-body
		height calc(100% - 80px)
		& ^[0]__axis-y
			height 100%
	&__search-result
		display flex
		align-items center
		width 100%
		height 45px
		padding 14px 24px
		border-bottom 1px solid $border
		& + ^[0]__axis-y
			height calc(100%  - 45px)
	&__search-result-text
		display block
		width 100%
		color #c2c0bd
		font-size 13px
		font-weight 300
		line-height 17px
		@extend .textOverflow
	&__scroll-bottom
		position absolute
		top -58px
		right -24px
		display flex
		justify-content center
		align-items center
		width 53px
		height 53px
		padding 0
		background-color white
		border none
		border-radius 50%
		box-shadow 0 2px 3px #e5e5e5
		z-index 1
		&:before
			content ''
			display block
			width 13px
			height 14px
			background url('data:image/png;base64,') no-repeat center
			transition transform .2s
		&:active
			&:before
				transform scale(.93)
		span
			display block
			position absolute
			top 0
			right -2px
			min-width 20px
			height 20px
			padding 0 4px
			text-align center
			color white
			font-size 12px
			font-weight 600
			line-height 20px
			background-color red
			border-radius 10px
			z-index 1

	&__attachment
		position relative
		margin-bottom 10px
		&:last-child
			margin-bottom 0
	&__attachment-close
		position absolute
		top -10px
		right -10px
		width 32px
		height 32px
		padding 0
		background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAsAAAALCAMAAACecocUAAAAM1BMVEUAAAALCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwoLCwqxzxhEAAAAEHRSTlMAhYGPl4uK+aGcfMzGxbylSb7ahAAAAEVJREFUCNctjEkCgEAIw8oIzuLW/79WxOaUHhp0x493DFpp4wPstNINSeRYqYXxZkCcPCAWLzaoEDAaVFDNP60xwaHX5At/KwIAVx3rnwAAAABJRU5ErkJggg==') no-repeat center
		border none
		z-index 1
	&__attachment-content
		margin-bottom 10px
		&:last-child
			margin-bottom 0

	&__menu
		display none
		justify-content flex-end
		position absolute
		top 0
		right -100%
		width 100%
		height 100%
		background-color rgba(#000, .3)
		opacity 0
		visibility hidden
		transition opacity .2s, visibility .2s, right .2s
		z-index 1
		@media screen and (max-width: 700px)
			display flex
		/ .chat--open-menu &
			right 0
			opacity 1
			visibility visible
			transition opacity .4s, visibility .4s, right .4s
	&__menu-container
		display flex
		flex-direction column
		width 100%
		max-width 312px
		height 100%
		background-color white
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		@media $mPortraitIphoe6Max
			max-width 100%
	&__menu-content
		padding 23px 22px 24px
	&__menu-title
		margin-bottom 8px
		color #d8d6d2
		font-size 9px
		font-weight 600
		line-height 11px
		text-transform uppercase
	&__menu-item-button
		display block
		position relative
		width 100%
		height 36px
		padding-left 39px
		padding-right 7px
		text-align left
		color $default
		font-size 14px
		font-weight 400
		line-height 16px
		@extend .textOverflow
		background none
		border none
		border-radius 6px
		transition background $duration
		&:before
			@extend .psElem
			top 50%
			left 15px
			width 17px
			height 17px
			background-repeat no-repeat
			background-position center
			transform translateY(-50%)
		&--active
			background-color #fef8f8
			font-weight 600
		&--search
			&:before
				background-image url('data:image/png;base64,')
		&--search&--active
			&:before
				background-image url('data:image/png;base64,')
		&--muted
			&:before
				background-image url('data:image/png;base64,')
		&--muted&--active
			&:before
				background-image url('data:image/png;base64,')
		&--call
			&:before
				background-image url('data:image/png;base64,')
		&--call&--active
			&:before
				background-image url('data:image/png;base64,')
		&--create
			&:before
				background-image url('data:image/png;base64,')
		&--create&--active
			&:before
				background-image url('data:image/png;base64,')
		&--block
			&:before
				background-image url('data:image/png;base64,')
		&--block&--active
			&:before
				background-image url('data:image/png;base64,')
		&--evaluate
			&:before
				background-image url('data:image/png;base64,')
		&--evaluate&--active
			&:before
				background-image url('data:image/png;base64,')
		&--record
			&:before
				background-image url('data:image/png;base64,')
		&--record&--active
			&:before
				background-image url('data:image/png;base64,')

	&--min
		border-top none
		& ^[0]__axis-y
			.os-viewport
				@media screen and (max-width: 700px)
					padding-right 0
		& ^[0]__head 
			& ^[0]__content
				@media screen and (max-width: 700px)
					padding-right 16px
		& ^[0]__content
			width 100%
		& ^[0]__content-wrap
			padding-left 12px
			padding-right 12px
			@media screen and (max-width: 700px)
				padding 12px
		& ^[0]__status
			@media screen and (max-width: 700px)
				display none
		& ^[0]__actions-item
			margin-right 5px
			@media screen and (max-width: 700px)
				display none
			&:last-child
				margin-right 0
			&--burger
				display none
				@media screen and (max-width: 700px)
					display block
		& ^[0]__status
			margin-left 10px
		& ^[0]__message
			&--right
				& ^[0]__message-body
					max-width calc(100% - 60px)
					@media screen and (max-width: 700px)
						max-width 100%
				& ^[0]__message-info
					@media screen and (max-width: 700px)
						left auto
						right 10px
			&--img
				& ^[0]__message-info
					@media screen and (max-width: 700px)
						left auto
						right 10px
			& + ^[0]__message
				& ^[0]__message-date
					@media screen and (max-width: 700px)
						padding-top 1px
		& ^[0]__message-date
			@media screen and (max-width: 700px)
				padding-top 8px
				padding-bottom 8px
		& ^[0]__message-body
			max-width 100%
		& ^[0]__message-avatar
			@media screen and (max-width: 700px)
				display none
		& ^[0]__message-avatar + ^[0]__message-body
			max-width calc(100% - 66px)
			@media screen and (max-width: 700px)
				max-width 100%
		& ^[0]__message-text
			@media screen and (max-width: 700px)
				min-width 78px
				padding 10px 10px 32px 10px
		& ^[0]__message-info
			@media screen and (max-width: 700px)
				left 10px
				right auto
		& ^[0]__scroll-bottom
			top -65px
			right 24px
			@media screen and (max-width: 700px)
				right 16px
		& ^[0]__menu-content
			@media screen and (max-width: 700px)
				padding 16px
	
	&--order
		& ^[0]__head
			position relative
			height 48px
			padding-left 24px
			border-bottom none
			@media screen and (max-width: 700px)
				padding-left 16px
			&:after
				@extend .psElem
				bottom 0
				left 24px
				width calc(100% - 24px)
				height 1px
				background-color $border
				pointer-events none
				@media screen and (max-width: 700px)
					left 0
					width 100%
			& ^[0]__content
				padding-top 0
				padding-left 0
		& ^[0]__body
			height calc(100% - 48px)
		& ^[0]__axis-y
			& ^[0]__content-wrap
				padding-right 12px
				@media screen and (max-width: 700px)
					padding-right 16px
		& ^[0]__content-wrap
			padding-left 24px
			padding-right 24px
			@media screen and (max-width: 700px)
				padding-left 16px
				padding-right 16px

		& ^[0]__bottom
			@media screen and (max-width: 700px)
				display none
		& ^[0]__bottom-mobile
			@media screen and (max-width: 700px)
				display block
		
		& ^[0]__form-controls-item
			position static
		
		.common-dropdown--chat
			right -14px
			bottom calc(100% + 18px)
