.letter-item-author
	display flex
	align-items center
	width 100%
	&__overimg
		width 36px
		height 36px
		margin-right 14px
		border-radius 50%
		flex-shrink 0
	&__img
		width 100%
		height 100%
		object-fit cover
	&__info
		width calc(100% - 40px)
		line-height 0
	&__title
		margin-right 8px
		margin-bottom 4px
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__email
		display inline-block
		vertical-align baseline
		padding 0
		text-align left
		color #7f7d7c
		font-size 12px
		font-weight 400
		line-height 14px
		flex-shrink 0
		background none
		cursor pointer
		span
			border-bottom 1px solid rgba(#7f7d7c, .7)
			transition border $duration
			pointer-events none
		&:hover
			span
				border-bottom-color transparent
