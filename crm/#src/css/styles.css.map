.payment
	width 100%
	max-width 396px
	&__row
		display flex
		align-items flex-end
		justify-content space-between
		width 100%
		& + ^[0]__row
			margin-top 35px
		&--to-pay
			& ^[0]__row-text,
			& ^[0]__row-number
				font-size 18px
				font-weight 700
			& ^[0]__row-number
				color $red
		&--total ^[0]__row-text,
		&--arrears ^[0]__row-text,
		&--arrears ^[0]__row-number
			font-weight 500
		&--total ^[0]__row-number
			font-size 24px
			font-weight 500
		&--arrears ^[0]__row-number
			color $red
		&--paid ^[0]__row-number
			color $green
	&__row-text,
	&__row-number
		color $default
	&__row-number
		text-align right
		flex-shrink 0
		margin-left 24px
	&__bottom
		border-top 1px solid $border
		margin-top 21px
		padding-top 19px
		@media $mLandscapeMax
			margin-top 14px
			padding-top 14px
	&__btn
		min-width 171px
		margin-top 26px
		@media $tPortraitMax
			margin-top 20px
	&--new
		display flex
		flex-direction column
		align-items flex-start
		width auto
		max-width 100%
		min-width 342px
		@media $mPortraitIphoe6Max
			min-width auto
		& ^[0]__rows
			display table
		& ^[0]__row
			display table-row
			& + ^[0]__row
				margin-top 0
			&--total
				& ^[0]__row-text,
				& ^[0]__row-number
					font-weight 600
				& ^[0]__row-text
					font-size 16px
					@media $mLandscapeMax
						font-size 12px
				& ^[0]__row-number
					font-size 18px
					@media $mLandscapeMax
						font-size 14px
			&--to-pay
				& ^[0]__row-text,
				& ^[0]__row-number
					font-size 18px
					font-weight 700
				& ^[0]__row-text
					@media $mLandscapeMax
						font-size 12px
				& ^[0]__row-number
					@media $mLandscapeMax
						font-size 14px
			&--paid
				& ^[0]__row-text,
				& ^[0]__row-number
					padding-bottom 9px
					@media $mLandscapeMax
						font-size 12px
						padding-bottom 15px
				& ^[0]__row-text
					font-weight 500
				& ^[0]__row-number
					font-weight 600
			&:last-child
				& ^[0]__row-text,
				& ^[0]__row-number
					padding-bottom 0
		& ^[0]__row-text
			min-width 172px
			padding-right 14px
			@media $mPortraitIphoe6Max
				min-width auto
				width 128px
				padding-right 10px
		& ^[0]__row-text,
		& ^[0]__row-number
			display table-cell
			font-size 14px
			line-height 20px
			text-align left
			margin-left 0
			padding-bottom 16px
			@media $mLandscapeMax
				line-height 14px
		& ^[0]__bottom
			@media $mLandscapeMax
				margin-top 14px
				padding-top 14px
		& ^[0]__btn
			@media $mLandscapeMax
				margin-top 22px
			@media $mPortraitIphoe6Max
				width 100%
