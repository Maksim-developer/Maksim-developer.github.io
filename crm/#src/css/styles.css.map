.uploaded-list
	display flex
	flex-wrap wrap
	align-items flex-start
	width 100%
	margin-bottom -10px
	&__item
		display block
		position relative
		width 157px
		height 107px
		margin-right 10px
		margin-bottom 10px
		background-repeat no-repeat
		background-position center
		background-size contain
		border-radius 6px
		overflow hidden
		cursor pointer
		&:hover,
		&--active
			& ^[0]__item-content
				opacity 1
				visibility visible
	&__item-content
		display flex
		flex-direction column
		position absolute
		top 0
		right 0
		bottom 0
		left 0
		padding 7px
		background-color rgba(#000, .4)
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1
	&__item-name,
	&__item-size
		color white
		font-size 12px
		line-height 14px
		font-weight 500
	&__item-bottom
		display flex
		justify-content space-between
		align-items center
		width 100%
		margin-top auto
	&__item-size
		display block
		max-width calc(100% - 32px)
		line-height 19px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
		&:before
			content ''
			display inline-block
			vertical-align middle
			flex-shrink 0
			width 21px
			height 19px
			margin-right 7px
			background url('data:image/png;base64,') no-repeat center
	&__item-delete,
	&__item-download
		flex-shrink 0
		margin-left 12px
		width 19px
		height 19px
		background-repeat no-repeat
		background-position center
		background-color $red
		border none
		outline none
		border-radius 50%
		transition transform .2s
		cursor pointer
		&:active
			transform scale(.97)
	&__item-delete
		background-image url('data:image/png;base64,')
	&__item-download
		background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAJCAMAAADJhsaRAAAAOVBMVEUAAAD///////////////////////////////////////////////////////////////////////8KOjVvAAAAEnRSTlMA9ls2Y1E8HePetKx6c1RMSC+os0I6AAAAN0lEQVQI1x3FyQHAIAzEwLUdyJ2A+i8Wgx4aSXFUzQq+bJTlz5ff1Yk8V1i90YuZ8UgObMr8TAYxagGDgngOowAAAABJRU5ErkJggg==')
