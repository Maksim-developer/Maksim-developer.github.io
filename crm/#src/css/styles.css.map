.letter-item
	&__head
		padding 20px 30px 10px
		border-bottom 1px solid $border
	&__title
		margin-bottom 23px
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
	&__details
		display flex
		width 100%
	&__author
		position relative
		margin-right 14px
		flex-shrink 0
	&__author-overimg
		width 36px
		height 36px
		padding 0
		background none
		border-radius 50%
		border none
	&__author-img
		width 100%
		height 100%
		object-fit cover
		pointer-events none
	&__author-dropdown
		width 268px
	&__details-content
		width calc(100% - 40px)
	&__details-content-top
		display flex
		align-items center
		margin-bottom 4px
	&__author-title,
	&__date
		font-size 12px
		line-height 16px
		flex-shrink 0
	&__author-title
		color $default
		font-weight 600
		margin-right 8px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__date
		margin-right 8px
		color #7f7d7c
		font-weight 300
	&__bookmark-button
		display flex
		justify-content center
		align-items center
		flex-shrink 0
		width 16px
		height 16px
		padding 0
		background none
		border none
		&:before
			content ''
			display block
			width 8px
			height 12px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAMBAMAAACtsOGuAAAALVBMVEXY1tLY1tIAAADY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tLY1tIwIxZIAAAADnRSTlPc8wDXkPHOzYuCZ1xMQ+iK6LoAAAAoSURBVAjXY3AVFBRhkHv37iED37t3DwgQdm/uPWZ4t0j7HUOGktJ0AF2XHbQqhct+AAAAAElFTkSuQmCC') no-repeat center
			transition background $duration
		&:hover,
		&--active
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAMBAMAAACtsOGuAAAALVBMVEX/AAD/AAAAAAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD/AAD5k6lJAAAADnRSTlPc8gDXkPTOzYuCZ1xMQ3+LdHAAAAAoSURBVAjXY3AUFBRhiHv37iED37t3DwgQdm/uPWZ4t0j7HUOGktJ0AGorHfCRsQezAAAAAElFTkSuQmCC')
	&__recipients
		display flex
		width 100%
	&__recipients-text,
	&__recipients-item
		color #7f7d7c
		font-size 12px
		font-weight 400
		line-height 14px
		flex-shrink 0
	&__recipients-text
		margin-right 4px
	&__recipients-items
		display flex
		flex-wrap wrap
		margin-bottom -8px
	&__recipients-item
		display block
		margin-right 8px
		margin-bottom 8px
		padding 0
		text-align left
		background none
		cursor pointer
		span
			border-bottom 1px solid rgba(#7f7d7c, .7)
			transition border $duration
			pointer-events none
		&:hover
			span
				border-bottom-color transparent
	&__attachment
		width 100%
		padding 20px 30px
		border-bottom 1px solid $border
	&__attachment-content
		margin-bottom 12px
		&:last-child
			margin-bottom 0
	&__attachment-download
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		a,
		span
			font-weight 400
		a
			display inline-block
			vertical-align baseline
			margin-left 4px
			margin-right 4px
			color #2d6bd1
			border-bottom 1px solid #2d6bd1
			transition border $duration
			&:hover
				border-bottom-color transparent
		span
			color #bcbcbc
	&__body
		padding 20px 30px
	&__text
		color $default
		font-size 14px
		font-weight 400
		line-height 17px
		p
			margin-bottom 14px
			&:last-child
				margin-bottom 0
