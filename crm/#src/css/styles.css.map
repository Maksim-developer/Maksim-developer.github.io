.checkbox-min
	display block
	position relative
	font-size 0
	line-height 0
	&__input
		position absolute
		top 0
		left 0
		opacity 0
		pointer-events none
		&:checked ~ label
			color $default
			&:before
				background-color $red
				border-color $red
			&:after
				opacity 1
	&__label
		display block
		padding-left 20px
		color #d8d6d2
		font-size 12px
		font-weight 500
		line-height 14px
		transition color $duration
		user-select none
		cursor pointer
		&:hover
			&:before
				background-color $red
				border-color $red
		&:before
			@extend .psElem
			top 0
			left 0
			width 13px
			height 13px
			background-color #fff
			border 1px solid $border
			border-radius 3px
			transition background $duration, border $duration
			cursor pointer
		&:after
			@extend .psElem
			top 4px
			left 4px
			width 7px
			height 3px
			border-left 1px solid #fff
			border-bottom 1px solid #fff
			transform rotate(-45deg)
			opacity 0
			transition opacity $duration
			cursor pointer
