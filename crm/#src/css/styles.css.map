.tabs
	width 100%
	padding-top 8px
	flex-grow 1
	overflow hidden
	&__controls
		display flex
		width 100%
		border-bottom 1px solid #ececec
		@media $mLandscapeMax
			padding-left 16px
			padding-right 16px
	&__controls-item
		&:not(:last-child)
			margin-right 35px
	&__controls-btn
		display block
		position relative
		white-space nowrap
		padding 4px 0
		text-align left
		font 500 16px/16px $baseFontFamily
		color #acacac
		background none
		border none
		border-bottom 2px solid transparent
		user-select none
		transition color $duration, border $duration
		@media $mLandscapeMax
			font-size 14px
			line-height 14px
			padding-bottom 11px
		&:hover,
		&--active
			color $default
			border-bottom-color $red
			span
				color $default
		&--active
			font-weight 600
		&--warning
			&:after
				@extend .psElem
				top -6px
				right -11px
				width 13px
				height 13px
				background url('data:image/png;base64,') no-repeat center
				z-index 1
	&__controls-btn-count
		display block
		position absolute
		top -3px
		right -5px
		color #acacac
		font-size 10px
		line-height 10px
		font-weight 600
		transition color $duration
		z-index 1
	&__controls + &__items
		margin-top 38px
		@media $mLandscapeMax
			margin-top 14px
	&__items
		position relative
	&__item
		display flex
		flex-direction column
		position absolute
		left 0
		top 0
		width 100%
		opacity 0
		visibility hidden
		transition opacity .35s, visibility .35s
		pointer-events none
		@media $mLandscapeMax
			padding-left 16px
			padding-right 16px
		&--active
			position relative
			opacity 1
			visibility visible
			pointer-events auto
	&__axis-y
		height 100%
		&.os-host
			.form,
			.payment,
			.payment-table
				&:last-child
					padding-bottom 30px
		.table-wrap
			&:first-child
				height 100%
				border-top none
				.table
					&__head .table__cell
						padding-top 0
						min-height auto
					&__edit
						align-items flex-start
					&__edit-checkbox
						padding-top 0
	.notifications-checkboxes
		&:first-child
			padding-top 5px
	.filter-checkboxes
		position relative
		top -25px
		left 0
		z-index 1
	.update-history:last-child
		.update-history__items
			padding-bottom 40px
