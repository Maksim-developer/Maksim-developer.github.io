.data-downloaded
	text-align center
	&--success
		& ^[0]__message
			padding-left 40px
			&:before
				@extend .psElem
				top 0
				left 0
				width 26px
				height 26px
				background url('data:image/png;base64,') no-repeat center
				z-index 1
	&--error
		& ^[0]__message
			padding-left 40px
			&:before
				@extend .psElem
				top -1px
				left 0
				width 29px
				height 27px
				background url('data:image/png;base64,') no-repeat center
				z-index 1
	&__message
		display inline-block
		vertical-align top
		position relative
		color black
		font-size 22px
		font-weight 500
		line-height 26px
