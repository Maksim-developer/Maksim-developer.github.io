.new-marker
	display flex
	align-items center
	position relative
	height 29px
	margin-right 10px
	margin-bottom 5px
	padding 7px 29px 7px 10px
	color #f93d3d
	font-size 14px
	font-weight 400
	line-height 14px
	font-family $fontConsolas
	white-space nowrap
	background-color #f7e8e8
	border-radius 6px
	&__delete
		position absolute
		top 2px
		right 0
		width 25px
		height 25px
		padding 0
		background url('data:image/png;base64,')  no-repeat center
		border none
		user-select none
		cursor pointer
		transition transform .2s
		z-index 1
		&:active
			transform scale(.93)
	&--green
		color #37b076
		background-color #e8f7e9
		& ^[0]__delete
			background-image url('data:image/png;base64,')
	&--blue
		color #66779d
		background-color #f4f7fe
		& ^[0]__delete
			background-image url('data:image/png;base64,')
