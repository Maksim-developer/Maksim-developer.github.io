.filter-wrap
	display flex
	flex-wrap wrap
	width 100%
	max-width 1204px

	.download-button
		margin-left auto
		flex-shrink 0

.filter-checkboxes
	display flex
	margin-right 15px
	margin-bottom 8px
	&__item
		position relative
	&__item + &__item &__item-label
		border-left none
	&__item-input
		position absolute
		left 0
		top 0
		opacity 0
		&:checked ~ label
			background-color #fff4f4
			border-color #e3cbcb
	&__item-label
		display block
		padding 6px 10px 7px
		color $default
		font-size 12px
		font-weight 300
		line-height 12px
		white-space nowrap
		border 1px solid #d9d9d9
		transition background $duration, border $duration
		cursor pointer
		user-select none
		&:hover
			background-color #fff4f4
			border-color #e3cbcb
	
	&+.checkbox-oval
		margin-top 6px
