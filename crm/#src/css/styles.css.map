.fuel
	position relative
	max-width 168px
	margin-top 16px
	padding-top 18px
	&:first-child
		margin-top 0
	&__dividers
		display flex
		justify-content space-between
		margin-top -6px
		padding-right 2px
		padding-left 6px
	&__divider
		color $default
		font-size 16px
		font-weight 600
		line-height 16px
		pointer-events none
		&:nth-child(2)
			position absolute
			top 0
			left 50%
			transform translateX(-50%)

.fuel-ico
	// &__sectors
	&__sector
		fill #FFA4A4
		transition fill $duration
		cursor pointer
		&:hover,
		&.active,
		&.selected
			fill $red
