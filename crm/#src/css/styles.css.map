.tooltipster-sidetip
	.tooltipster-box
		background #3a3937
		border-radius 6px
		border none
	.tooltipster-content
		padding 7px 11px
		color white
		font-size 12px
		line-height 14px
		font-weight 500
	&.tooltipster-light
		.tooltipster-box
			background #fff
			border 1px solid #f6f5f3
			border-radius 0
			box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		.tooltipster-content
			padding 12px 14px
			color #131312
