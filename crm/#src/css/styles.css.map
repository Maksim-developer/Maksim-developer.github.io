.providers
	display flex
	flex-grow 1
	width 100%
	border-top 1px solid #ececec
	&__aside
		display flex
		flex-direction column
		width 240px
		flex-shrink 0
		border-right 1px solid #ececec
	&__head
		flex-shrink 0
		height 91px
		padding 12px 4px 12px 0
		border-bottom 1px solid #ececec
	&__all-results-btn
		display flex
		justify-content center
		align-items center
		height 100%
		padding 10px 10px 10px 28px
		color $default
		font-weight 700
		background-color #f7f7f7
		user-select none
		&:before
			content ''
			display block
			width 35px
			height 39px
			margin-right 34px
			background url('data:image/png;base64,') no-repeat center
	&__content
		width 100%
	&__items
		padding-top 10px
		padding-bottom 10px
		&:not(.providers__items--selected)
			// height calc(100vh - 91px - 59px)
			height 100%
			overflow hidden
		& + &
			border-top 1px solid #ececec
	&__items-axix-y
		height 100%
		&.os-host-overflow-y
			padding-right 6px
	// &__item
	&__top
		padding 24px 20px
		border-bottom 1px solid #ececec
	&__info
		display flex
		align-items flex-end
		flex-wrap wrap
		width 100%
		&:not(:first-child)
			margin-top 24px
	&__title
		color $default
		font-size 18px
		line-height 18px
		margin-right 14px
	&__href
		display inline-block
		vertical-align top
		color #00b4ff
		font-size 12px
		font-weight 300
		line-height 16px
		span
			border-bottom 1px solid #00b4ff
			transition border $duration
		&:hover
			span
				border-bottom-color transparent
	&__card
		width 100%
		max-width 736px
		padding 24px 20px
	&__card-title
		color $default
		font-size 18px
		line-height 18px
		margin-bottom 40px
	&__card-form
		&:not(:last-child)
			margin-bottom 30px
	&__card-text
		font-size 12px
		line-height 14px
		font-weight 300
		color #6b6b6b
		b
			font-weight 500
		a
			color #00b4ff
			border-bottom 1px solid #00b4ff
			transition border $duration
			&:hover
				border-bottom-color transparent
		p + p
			margin-top 16px
	
	.table-wrap
		border-top none

.provider
	display flex
	align-items center
	position relative
	width 100%
	padding 7px 37px 7px 27px
	transition background $duration
	&:hover
		background-color #f7f7f7
	&--active,
	&--added
		background-color #f7f7f7
	&--added
		&:after
			@extend .psElem
			top 50%
			transform translateY(-50%)
			right 20px
			width 14px
			height 14px
			background url('data:image/png;base64,') no-repeat center
	&__overlogo
		display block
		width 50px
		flex-shrink 0
		margin-right 20px
	&__logo
		max-width 100%
	&__title
		display block
		color $default
		font-weight 700

.provider-overlogo
	display inline-block
	vertical-align top
	width 29px
	font-size 0
	line-height 0
	&__logo
		width 100%
