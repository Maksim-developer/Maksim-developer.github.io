.popup-context
	display none
	width 280px
	position fixed
	top 0
	left -280px
	background-color white
	border 1px solid #f0f0f0
	border-radius 10px
	box-shadow 0 0 35px rgba(0, 0, 0, 0.2)
	overflow hidden
	z-index 99
	&__list
		padding 10px 0
	&__list-href
		display block
		padding 14px 18px
		color $default
		font-size 14px
		font-weight 300
		line-height 17px
		background-color #fff
		transition background $duration 
		&:hover
			background-color $border
