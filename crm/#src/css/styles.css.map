.period-mobile
	display none
	justify-content space-between
	align-items center
	width 100%
	@media $mLandscapeMax
		display flex
	&__selected
		flex-shrink 0
		color $default
		font-size 12px
		font-weight 600
		line-height 14px
	&__items
		position relative
		flex-shrink 0
		margin-left 16px
	&__items-toggle
		display block
		width 30px
		height 30px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
	&__items-dropdown
		left auto
		right 0
		min-width 120px
