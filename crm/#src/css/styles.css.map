.toasts
	display flex
	flex-direction column
	align-items center
	position fixed
	top 60px
	left 50%
	transform translateX(-50%)
	width 100%
	max-width 348px
	z-index 100000
	@media $mPortraitMax
		max-width 288px
	&__item
		display flex
		align-items center
		position relative
		width 100%
		padding 13px 10px 13px 15px
		background-color #f2fff2
		border 1px solid #2caf2c
		border-radius 3px
		@media $mPortraitMax
			padding 10px 10px 10px 12px
		&:not(:last-child)
			margin-bottom 10px
		&:before
			content ''
			display block
			flex-shrink 0
			width 28px
			height 25px
			margin-right 20px
			background-repeat no-repeat
			background-position center
			background-size contain
			@media $mPortraitMax
				margin-right 16px
				width 20px
				height 20px
		&--succes
			&:before
				background-image url('data:image/png;base64,')
		&--copy
			background-color #fffaf6
			border-color #ff7800
			&:before
				background-image url('data:image/png;base64,')
			& ^[0]__item-title
				color #ff7800
			& ^[0]__item-close
				&:before
					background-image url('data:image/png;base64,')
		&--warning
			background-color #fff7f7
			border-color $red
			&:before
				background-image url('data:image/png;base64,')
			& ^[0]__item-title
				color $red
			& ^[0]__item-close
				&:before
					background-image url('data:image/png;base64,')
	&__item-title
		color #2caf2c
		font-size 14px
		font-weight 500
		margin-right auto
		@media $mPortraitMax
			font-size 12px
			line-height 14px
	&__item-close
		display flex
		flex-shrink 0
		width 24px
		height 24px
		margin-left 11px
		padding 0
		background none
		border none
		border-radius 0
		transition transform .2s
		cursor pointer
		user-select none
		z-index 1
		&:before
			content ''
			display block
			width 10px
			height 10px
			margin auto
			background url('data:image/png;base64,') no-repeat center
			background-size contain
		&:active
			transform scale(.9)
