.period-datepicker
	height 100%
	overflow-y auto
	&__item
		border-bottom 1px solid $border
	.datepicker
		width 100%
		border none
		border-radius 0
		box-shadow none
		&--nav
			max-width 210px
			margin-left auto
			border-bottom none
		&--content
			border-top 1px solid #efefef
	.btn
		width 100%
		border-radius 0
		&:active
			transform none
