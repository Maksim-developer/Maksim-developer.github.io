.nav
	width 100%
	&__list-item
		position relative
		@media $mLandscapeMax
			border-bottom 1px solid #1b1b1a
		&:last-child
			@media $mLandscapeMax
				border-bottom none
		&:hover
			@media $desktop
				& ^[0]__list-btn
					background-color #444342
					&--active
						background-color #444342
					&--accent
						background-color #21211f
					& ^[0]__list-btn-overico
						opacity 1
					& ^[0]__list-btn-title
						color #edeae6
						&:after
							border-color transparent transparent transparent #909090
				& ^[0]__sublist
					opacity 1
					visibility visible
					transition opacity .2s .2s, visibility .2s .2s
		&--active
			& ^[0]__sublist
				@media $mLandscapeMax
					opacity 1
					visibility visible
					left 0
		&--have-sublist
			& ^[0]__list-btn-title
				&:after
					@extend .psElem
					right 15px
					top 50%
					width 0
					height 0
					border-style solid
					border-width 5px 0 5px 5px
					border-color transparent transparent transparent #6d6d6d
					transform translateY(-50%)
					transition border $duration, opacity $duration
					z-index 1
	&__list-btn
		display flex
		align-items center
		text-align left
		position relative
		width 100%
		padding 0
		background none
		border none
		border-radius 0
		transition background $duration
		user-select none
		&--active
			background-color #444342
			& ^[0]__list-btn-overico
				opacity 1
			& ^[0]__list-btn-title
				color #edeae6
				&:after
					border-color transparent transparent transparent #909090
		&--accent
			background-color #706f6e
			@media $mLandscapeMax
				background-color #21211f
	&__list-btn-overico
		display flex
		justify-content center
		align-items center
		position relative
		width 59px
		height 48px
		flex-shrink 0
		font-size 0
		line-height 0
		transition opacity $duration
		opacity .8
	&__list-btn-ico
		max-width 100%
		max-height 100%
		align-self center
	&__list-btn-number
		position absolute
		top 9px
		right 13px
		min-width 14px
		height 14px
		padding-left 4px
		padding-right 4px
		text-align center
		color white
		font-size 8px
		font-weight 600
		line-height 14px
		background-color red
		border-radius 6px
		z-index 1
	&__list-btn-title
		position relative
		width 131px
		max-width 0
		color #d9d6d3
		font-size 12px
		font-weight 500
		line-height 14px
		white-space nowrap
		transition color $duration, max-width .2s, opacity $duration
		opacity 0
		overflow hidden
		@media $mLandscapeMax
			width 100%
			max-width 100%
			opacity 1
		/ .menu-active &,
		/ .menu-open &
			max-width 131px
			opacity 1
			@media $mLandscapeMax
				max-width 100%
		span
			padding-right 24px
	&__sublist
		position absolute
		top 0
		left 100%
		width 240px
		padding 6px 0
		background-color #444342
		border-radius 6px
		box-shadow 0 0 15px rgba(0, 0, 0, 0.1)
		opacity 0
		visibility hidden
		z-index 1
		@media $mLandscapeMax
			position fixed
			top 44px
			width 100%
			height calc(100% - 44px)
			padding 0
			background-color $default
			box-shadow none
			border-radius 0
			transition opacity $duration, visibility $duration, left $duration
			overflow-y auto
			z-index 2
		&--favorites
			& ^[0]__sublist-item
				padding-left 0
			& ^[0]__sublist-href,
			& ^[0]__sublist-btn-back
				padding-left 17px
	&__sublist-item
		display flex
		width 100%
		padding-left 6px
		align-items flex-start
		@media $mLandscapeMax
			border-bottom 1px solid #1b1b1a
		&:last-child
			@media $mLandscapeMax
				border-bottom none
		&:hover
			@media $desktop
				background-color #555452
		&--active
			background-color #555452
		&:hover,
		&--added-favorites
			& ^[0]__sublist-item-favorites
				opacity 1
		&--added-favorites
			& ^[0]__sublist-item-favorites
				background-image url('data:image/png;base64,')
		&--back
			display none
			@media $mLandscapeMax
				display block
	&__sublist-item-favorites
		display block
		flex-shrink 0
		width 32px
		height 38px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
		border-radius 0
		opacity 0
		transition opacity $duration, background $duration
		z-index 1
		@media $mLandscapeMax
			opacity 1
	&__sublist-btn-back,
	&__sublist-href,
	&__sublist-settings
		display block
		flex-grow 1
		text-align left
		color $border
		font-size 12px
		font-weight 500
		line-height 14px
		cursor pointer
		user-select none
	&__sublist-btn-back
		display flex
		align-items center
		width 100%
		height 40px
		padding 5px 6px
		background none
		border none
		border-radius 0
		&:before
			content ''
			display block
			flex-shrink 0
			width 15px
			height 30px
			margin-right 12px
			background url('data:image/png;base64,') no-repeat center
	&__sublist-href
		padding 12px 24px 12px 6px
		transition color $duration, background $duration
	&__sublist-settings
		padding 12px 24px 12px 17px
		background none
		border none
		border-radius 0
		border-top 1px solid #555452
		transition color $duration, background $duration
		@media $mLandscapeMax
			border none
