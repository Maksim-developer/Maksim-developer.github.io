.favorites-settings
	&__item
		display flex
		align-items center
		justify-content space-between
		padding 2px 25px
		border-radius 6px
		transition background $duration
		user-select none
		cursor pointer
		&:hover
			background-color #fff7f7
		&:not(:last-child)
			margin-bottom 7px
	&__item-title
		margin-right 24px
		color black
		font-size 14px
		font-weight 600
		line-height 16px
	&__item-actions
		display flex
		justify-content flex-end
		flex-shrink 0
	&__item-action
		&:not(:first-child)
			margin-left 6px
	&__item-action-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 36px
		height 36px
		border-radius 18px
		padding 0
		border 0
		background none
		transition background $duration
		&:hover
			background #fff
	.actions__item-btn:hover
		background-color #fff
