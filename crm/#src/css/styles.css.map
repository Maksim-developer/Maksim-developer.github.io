.table-settings
	width 100%
	flex-shrink 0
	padding 27px 26px 26px
	border-top 1px solid $border
	@media $tPortraitMax
		padding 13px 16px 14px
	@media $mLandscapeMax
		padding-top 7px
		padding-bottom 8px
	&__container
		display flex
		align-items flex-end
		flex-wrap wrap
		position relative
		width 100%
		max-width 1378px
		margin-bottom -10px
		@media $desktopMax
			padding-top 25px
			padding-left 392px
		@media $tPortraitMax
			padding-top 2px
			padding-left 377px
		@media $mLandscapeMax
			padding 0
	&__item
		display flex
		align-items center
		min-height 30px
		margin-right 10px
		margin-bottom 10px
		@media $mLandscapeMax
			display none
		&:last-child
			margin-right 0
		&--period
			padding-right 28px
			@media $desktopMax
				position absolute
				top 0
				left 0
				margin 0
				z-index 1
				padding-right 0
			@media $mLandscapeMax
				display block
				position relative
				width 100%
				margin-bottom 10px
		&--reset
			@media $tPortraitMax
				order 1
				margin-left 10px
				margin-right 0
			@media $mLandscapeMax
				order 0
				margin-left 0
				margin-right 10px
	&__right
		display flex
		margin-left auto
		flex-shrink 0
		@media $desktopMax
			margin-left 0
	&__filter
		position relative
		&--yield
			& ^[0]__filter-dropdown
				width 334px
		&--segment
			& ^[0]__filter-text
				&:before
					content ''
					display block
					flex-shrink 0
					width 13px
					height 13px
					margin-right 10px
					background url('data:image/png;base64,') no-repeat center
	&__filter-top
		position relative
		height 30px
		background-color white
		border 1px solid #eeedec
		border-radius 6px
		transition border $duration, background $duration, transform .2s
		cursor pointer
		&:active
			transform scale(.97)
		&--open
			& ^[0]__filter-reset
				&:not(.table-settings__filter-reset--active)
					&:before
						transform scaleY(-1)
		&--selected
			background-color #feefef
			border-color #feefef
			& ^[0]__filter-text
				color #f95050
	&__filter-text
		display flex
		align-items center
		padding 9px 38px 9px 15px
		color $default
		font-size 12px
		font-weight 400
		line-height 12px
		white-space nowrap
		background none
		border none
		border-radius 0
		user-select none
		transition color $duration
	&__filter-reset
		display flex
		flex-direction column
		justify-content center
		align-items center
		position absolute
		top 0
		right 8px
		width 24px
		height 100%
		padding 0
		background none
		border none
		border-radius 0
		user-select none
		pointer-events none
		z-index 1
		&:before
			content ''
			display block
			width 9px
			height 5px
			background url('data:image/png;base64,') no-repeat center
			transition transform $duration, background $duration
		&--active
			pointer-events auto
			&:before
				width 8px
				height 8px
				background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAIBAMAAAA2IaO4AAAAIVBMVEUAAAD/ra3/ra3/ra3/ra3/ra3/ra3/ra3/ra3/ra3/ra17b02yAAAACnRSTlMAPDft0oyTdJdxmDWFGwAAACpJREFUCNdjCGRgUGVwVmAyYWBbqNXAwFC1nIGBYRaQYFsolQCWACkRBQCMCwbjGo1KOwAAAABJRU5ErkJggg==') no-repeat center
	&__filter-dropdown
		display none
		position absolute
		left 0
		top calc(100% + 4px)
		width 240px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 1
		&--article
			width 380px
	&__filter-list
		padding 10px 0
	&__filter-list-item
		line-height 17px
		.checkbox
			&--with-label
				display block
			&:not(.checkbox--with-actions)
				.checkbox__label
					display flex
					align-items center
					min-height 37px
					padding 7px 25px 7px 55px
			&__input
				&:checked ~ label
					background-color #fff7f7
			&__label
				&:hover
					background-color #fff7f7
				&:before,
				&:after
					top 50%
				&:before
					left 25px
					transform translateY(-50%)
				&:after
					left 29px
					transform translateY(-50%) rotate(-45deg)
					margin-top -1px
				&:active
					&:before
						transform translateY(-50%) scale(.9)
					&:after
						transform translateY(-50%) rotate(-45deg) scale(.9)
				.rating
					top -1px
					margin-left auto
	&__filter-clear
		display flex
		align-items center
		padding 6px 0
		color $default
		font-size 12px
		font-weight 400
		line-height 14px
		background none
		border none
		cursor pointer
		user-select none
		transition transform .2s
		@media $mLandscapeMax
			display block
			width 30px
			height 30px
			padding 0
			font-size 0
			line-height 0
			color transparent
			background url('data:image/png;base64,') no-repeat center
			border-radius 6px
			border 1px solid #eeedec
		&:active
			font-weight 600
			transform scale(.97)
		&:before
			content ''
			display block
			width 8px
			height 8px
			margin-right 9px
			background url('data:image/png;base64,') no-repeat center
			flex-shrink 0
			transition background $duration
			@media $mLandscapeMax
				display none
				content none
		&:hover
			font-weight 600
			&:before
				background-image url('data:image/png;base64,')
	&__filter-api,
	&__filter-toggle
		display block
		width 30px
		height 30px
		padding 0
		background-repeat no-repeat
		background-position center
		border-radius 6px
		transition transform .2s
		cursor pointer
		user-select none
		&:active
			transform scale(0.97)
	&__filter-api
		background-image url('data:image/png;base64,')
		background-color $red
		border none
	&__filter-toggle
		background-image url('data:image/png;base64,')
		background-color #fff
		background-position-y 9px
		border 1px solid #eeedec
		&:before
			@extend .psElem
			top 4px
			right 2px
			width 6px
			height 6px
			background-color $red
			border-radius 3px
			transition opacity $duration, visibility $duration
			pointer-events none
			z-index 1
		&--active
			&:before
				opacity 1
				visibility visible
	&__column
		display block
		height 30px
		padding 9px 14px 9px
		color $default
		font-size 12px
		font-weight 400
		line-height 12px
		white-space nowrap
		background-color white
		border 1px solid #eeedec
		border-radius 6px
		transition background $duration, border $duration, transform .2s
		cursor pointer
		user-select none
		&:active
			transform scale(.97)
		&:hover
			background-color #fff4f4
			border-color #e3cbcb
	&__filter-search
		position relative
		width 100%
		border-bottom 1px solid $border
	&__filter-search-submit
		position absolute
		top 0
		right 0
		padding 0
		width 46px
		height 46px
		background url('data:image/png;base64,') no-repeat center
		border 0
		opacity 0
		visibility hidden
		cursor pointer
		transition opacity $duration, visibility $duration
		z-index 1
	&__filter-search-input
		display block
		width 100%
		height 45px
		padding 16px 60px 16px 24px
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		background #fff
		border none
		border-radius 0
		border-top-left-radius 6px
		border-top-right-radius 6px
		&.not-empty
			& + ^[0]__filter-search-submit
				opacity 1
				visibility visible
		placeholder()
			color #d8d6d2
			font-weight 500
	&__filter-axis-y
		max-height 440px
	&__filter-group-top
		display flex
		width 100%
		align-items center
		padding 12px 24px 14px
		border-bottom 1px solid $border
		& + ^[0]__filter-list
			padding 0 0 12px
			border-bottom 1px solid $border
	&__filter-group-button
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 19px
		height 19px
		margin-right 12px
		background white
		border 1px solid $border
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		cursor pointer
		user-select none
		&:hover
			background $red
			border-color $red
			&:before,
			&:after
				background-color #fff
		&:before,
		&:after
			content ''
			display block
			width 7px
			height 1px
			background $default
			transition background $duration
		&:after
			position absolute
			top 8px
			left 5px
			transform rotate(90deg)
			z-index 1
		&:active
			transform scale(.95)
	&__filter-group-title
		color $default
		font-size 12px
		font-weight 600
		line-height 14px

