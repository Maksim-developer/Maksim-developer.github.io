.order
	display flex
	flex-direction column
	position absolute
	top -1px
	right -615px
	width 615px
	height calc(100% + 1px)
	background-color white
	border 1px solid $border
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	transition right $duration
	z-index 10
	@media screen and (max-width: 700px)
		display none
	/ .order-visible &
		right 0
	&__toggle-btn
		display flex
		justify-content flex-end
		align-items center
		position absolute
		top 10px
		left -32px
		width 32px
		height 32px
		padding 0
		background none
		border-radius 0
		border none
		cursor pointer
		z-index 1
		span
			display flex
			flex-direction column
			justify-content center
			align-items center
			position relative
			width 16px
			height 20px
			background-color #d9d9d9
			border-radius 3px 0px 0px 3px
			pointer-events none
			&:before
				content ''
				display block
				width 5px
				height 8px
				background url('data:image/png;base64,') no-repeat center
				transition transform $duration
				transform scaleX(-1)
				/ .order-visible &
					transform scaleX(1)
	&__axis-y
		height 100%
	&__top-row
		display flex
		align-items center
		width 100%
		min-height 52px
		padding 8px 40px 8px 24px
	&__last-edit
		padding 20px 24px
		color #c2c0bd
		font-size 12px
		line-height 14px
		font-weight 400
	&__phone
		position relative
		margin-right 26px
		line-height normal
	&__phone-toggle
		width 36px
		height 36px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border 1px solid #eeedec
		border-radius 6px
		transition background $duration, border $duration, transform .2s
		cursor pointer
		user-select none
		&:hover,
		&.active
			background-image url('data:image/png;base64,')
			background-color $red
			border-color $red
		&:active
			transform scale(.93)
	&__dates
		display flex
		justify-content space-between
		align-items center
		width 100%
		&--vertical
			flex-direction column
			justify-content flex-start
			align-items flex-start
	&__date
		color #c2c0bd
		font-size 12px
		line-height 14px
	&__status
		flex-shrink 0
		margin-left 24px
	&__info
		display flex
		justify-content space-between
		width 100%
		padding 23px 40px 22px 24px
		background-color #fafafa
	&__info-left
		width calc(100% - 172px)
	&__title
		color $default
		font-size 14px
		font-weight 500
		line-height 20px
		@extend .textOverflow
		&[href]
			border-bottom 1px solid $default
			transition border $duration
			&:hover
				border-bottom-color transparent
	&__subtitle
		color #c2c0bd
		font-size 12px
		font-weight 400
		line-height 14px
		@extend .textOverflow
		&:not(:first-child)
			margin-top 4px
	&__number
		font-size 20px
		font-weight 700
	&__car
		color #c2c0bd
		font-size 12px
		font-weight 400
		line-height 14px
		@extend .textOverflow
		&:not(:first-child)
			margin-top 4px
	&__info-right
		text-align right
		width 148px
	&__summ
		color $default
		font-size 20px
		font-weight 700
		line-height 20px
	&__discount
		color $red
		font-size 14px
		font-weight 500
		line-height 14px
		&:not(:first-child)
			margin-top 6px
		&--success
			color #2caf2c
	&__content
		flex 1
		overflow hidden
		> .table-wrap
			padding-top 24px
			padding-left 24px
	&__group
		padding 25px 0 30px
		border-bottom 1px solid #F4F4F1
		&:first-child
			padding-top 0
		&:last-child
			padding-bottom 0
			border-bottom none
	&__group-top
		display flex
		align-items flex-end
		justify-content space-between
		width 100%
		margin-bottom 16px
		padding-right 24px
	&__group-title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		span
			margin-left 14px
			font-weight 400
	&__group-content
		padding-right 24px
		&--row
			display flex
			width 100%
	&__client
		margin-right auto
		line-height normal
		@extend .textOverflow
		padding-right 16px
	&__client-name
		display inline-block
		vertical-align top
		position relative
		max-width 100%
		top -3px
		margin-bottom 9px
		color $blue
		font-size 14px
		font-weight 600
		line-height 16px
		@extend .textOverflow
		border-bottom 1px solid $blue
		transition border $duration
		&:hover
			border-bottom-color transparent
		span
			position relative
			top 2px
	&__client-info
		display flex
		align-items center
	&__client-summ
		margin-right 6px
		color $green
		font-size 14px
		font-weight 600
		line-height 14px
		white-space nowrap
		&--warning
			color $red
	&__car
		border 1px solid $border
		border-radius 6px
		&--open
			& ^[0]__car-head
				padding-bottom 5px
			& ^[0]__car-toggle-props
				display none
			& ^[0]__car-action-btn--toggle
				background-image url('data:image/png;base64,')
				background-color $red
				transform rotate(-180deg)
	&__car-head
		display flex
		width 100%
		padding 13px
	&__car-toggle
		display block
		margin-right 16px
		padding 0
		@extend .textOverflow
		background none
		border none
	&__car-toggle-title
		display block
		margin-bottom 9px
		text-align left
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		@extend .textOverflow
		&:last-child
			margin-bottom 0
	&__car-toggle-props
		display flex
		align-items center
	&__car-toggle-prop
		position relative
		padding-right 20px
		color #c2c0bd
		font-size 14px
		font-weight 400
		line-height 14px
		@extend .textOverflow
		&:last-child
			padding-right 0
			&:after
				content none
				display none
		&:after
			@extend .psElem
			top 5px
			right 8px
			width 3px
			height 3px
			background-color #c2c0bd
			border-radius 3px
	&__car-actions
		display flex
		margin-left auto
		flex-shrink 0
	&__car-action
		margin-right 5px
		&:last-child
			margin-right 0
	&__car-action-btn
		display block
		width 20px
		height 20px
		padding 0
		background-color whitesmoke
		background-repeat no-repeat
		background-position center
		border-radius 10px
		border none
		transition background $duration, transform $duration
		&:hover
			background-color $red
		&--add
			background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAkAAAAJAgMAAACd/+6DAAAACVBMVEUAAADJycnJyck8OjZGAAAAAnRSTlMA9iJNmhEAAAAVSURBVAjXY2BoYEDBs1Y1IPgOYBoAZoYFhYwLMUwAAAAASUVORK5CYII=')
			&:hover
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAkAAAAJAgMAAACd/+6DAAAACVBMVEUAAAD///////9zeKVjAAAAAnRSTlMA9iJNmhEAAAAVSURBVAjXY2BoYEDBs1Y1IPgOYBoAZoYFhYwLMUwAAAAASUVORK5CYII=')
		&--delete
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
		&--toggle
			background-image url('data:image/png;base64,')
			&:hover
				background-image url('data:image/png;base64,')
	&__car-content
		padding 0 13px 13px
	&__car-prop
		display flex
		margin-bottom 14px
		color #c2c0bd
		font-size 14px
		font-weight 400
		line-height 16px
		&:last-child
			margin-bottom 0
	&__car-prop,
	&__car-prop-title,
	&__car-prop-value
		@extend .textOverflow
	&__car-prop-title
		margin-right 6px
	&__car-prop-value
		font-weight 500
		color $default

	&__bottom
		margin-top auto
		padding 16px 40px 40px 24px
	&__buttons
		display flex
		justify-content flex-end
		width 100%
		.btn + .btn
			margin-left 4px

	.tabs
		display flex
		flex-direction column
		height 100%
		padding-top 16px
		&__controls
			position relative
			padding-left 24px
			flex-shrink 0
			border-bottom none
			& + .tabs__items
				margin-top 24px
				@media $mLandscapeMax
					margin-top 14px
			&:after
				@extend .psElem
				bottom -1px
				left 24px
				width calc(100% - 24px)
				height 1px
				background-color $border
				pointer-events none
		&__controls-item:not(:last-child)
			margin-right 25px
		&__items
			flex-grow 1
			overflow hidden;
		&__item
			height 100%
			> .table-wrap,
			> .order-summ
				padding-left 24px
				@media $mLandscapeMax
					padding-left 0
		&__item-content
			padding-left 24px
			@media $mLandscapeMax
				padding-left 0

	.table-wrap
		height calc(100% - 64px)
		border-top none
		&--height-auto
			height auto
			.table-wrap__title
				font-size 14px
				line-height 17px
				margin-bottom 7px
				& + .table
					border-top 1px solid $border

	.table
		height auto
		&__cell
			padding 8px 64px 9px 26px
			&:first-child
				padding-right 10px
				padding-left 2px
			&:last-child
				padding-right 40px
		&__body .table__row
			.spare-parts__more-dropdown
				width 312px
				left 50%
				transform translateX(-50%)
				box-shadow 12px 16px 25px rgba(211,207,202, .25)
			&:not(:first-child):last-child,
			&:not(:first-child):nth-last-child(2)
				.spare-parts__more-dropdown
					bottom calc(100% + 4px)
			&:last-child
				border-bottom 1px solid $border
		&--created
			.table
				&__cell
					&:nth-child(2)
						flex-grow 1

	.common-text
		margin-bottom 14px
		&:last-child
			margin-bottom 0
		h5, p, ol
			margin-bottom 7px
			&:last-child
				margin-bottom 0
		h5, p, ol li, ol li:before
			font-size 14px
			line-height 17px

	.tags-dropdown
		&__axis-y
			max-height 240px

	&--visible-mobile
		@media screen and (max-width: 700px)
			display flex
			width 100%
			right -100%
			border none
		& ^[0]__toggle-btn
			@media screen and (max-width: 700px)
				display none
		& ^[0]__last-edit
			@media screen and (max-width: 700px)
				display flex
				align-items center
				padding 16px
				font-size 10px
				line-height 12px
			span
				@media screen and (max-width: 700px)
					margin-right auto
			.btn
				display none
				@media screen and (max-width: 700px)
					display flex
				&--back
					margin-right 16px
				&--edit,
				&--delete
					margin-left 10px
				&--delete
					&:after
						@media screen and (max-width: 700px)
							width 11px
							height 14px
							background-size contain
		& ^[0]__info
			@media screen and (max-width: 700px)
				padding 14px 16px
		& ^[0]__info-left
			@media screen and (max-width: 700px)
				line-height normal
				width calc(100% - 116px)
		& ^[0]__info-right
			@media screen and (max-width: 700px)
				width 116px
		& ^[0]__title
			@media screen and (max-width: 700px)
				display inline-block
				vertical-align top
		& ^[0]__title,
		& ^[0]__number,
		& ^[0]__summ,
		& ^[0]__group-title
			@media screen and (max-width: 700px)
				font-size 14px
				line-height 16px
		& ^[0]__subtitle,
		& ^[0]__discount
			@media screen and (max-width: 700px)
				font-size 12px
				line-height 14px
			&:not(:first-child)
				@media $mLandscapeMax
					margin-top 4px
		& ^[0]__group
			@media screen and (max-width: 700px)
				padding-top 15px
				padding-bottom 15px
			&:first-child
				@media screen and (max-width: 700px)
					padding-top 0
		& ^[0]__group-top,
		& ^[0]__group-content
			@media screen and (max-width: 700px)
				padding-right 16px
		& ^[0]__group-content
			&--row
				@media $mPortraitMax
					display block
		& ^[0]__client
			@media $mPortraitMax
				margin-bottom 16px
				padding-right 0
			&:last-child
				@media $mPortraitMax
					margin-bottom 0
		& ^[0]__car-prop
			@media $mPortraitMax
				flex-direction column
		& ^[0]__car-prop-title
			@media $mPortraitMax
				margin-right 0
				margin-bottom 2px

		& ^[0]__bottom
			@media screen and (max-width: 700px)
				display none

		.tabs
			&__controls
				@media screen and (max-width: 700px)
					padding-left 16px
				&:after
					@media screen and (max-width: 700px)
						left 0
						width 100%
			&__item
				@media $mLandscapeMax
					padding-left 0
					padding-right 0
				> .table-wrap
					@media screen and (max-width: 700px)
						padding-left 16px
				> .order-summ
					@media $mLandscapeMax
						display none
			&__axis-y
				&.os-host-overflow-y
					@media $mLandscapeMax
						padding-right 16px
						margin-right -16px
			&__item-content
				@media screen and (max-width: 700px)
					padding-left 16px

		.table-wrap
			@media $mLandscapeMax
				height 100%
			&__axis-y
				@media screen and (max-width: 700px)
					padding-right 16px

		.table
			&__head .table__cell
				@media $mLandscapeMax
					min-height auto
					padding-top 0
				&:nth-child(2)
					@media $mLandscapeMax
						border-right none
			&__cell
				@media $mLandscapeMax
					padding-left 12px
					padding-right 24px
				&:last-child
					@media $mLandscapeMax
						padding-right 0
			&--works
				.table__cell:nth-child(2)
					@media $mLandscapeMax
						border-right none
