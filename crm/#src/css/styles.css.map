.common-dropdown-wrap
	position relative
	margin-right 24px
	line-height normal
	&:last-child
		margin-right 0
	&__toggle-btn
		padding 0
		background none
		border none
		*
			pointer-events none
	&.active
		.btn--dropdown
			&:after
				transform scaleY(-1)

.common-dropdown
	display none
	position absolute
	left 0
	top calc(100% + 4px)
	min-width 180px
	background-color white
	border 1px solid $border
	border-radius 6px
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	z-index 11
	&__head
		display flex
		align-items center
		padding 13px 16px
		border-bottom 1px solid $border
	&__head-cell
		padding-right 32px
		color #acacac
		font-size 14px
		font-weight 600
		line-height 17px
	&__controls
		display flex
		align-items center
		margin-left 16px
	&__controls-item
		line-height 0
		margin-right 14px
		&:last-child
			margin-right 0
	&__controls-button
		display flex
		flex-direction column
		width 24px
		height 24px
		padding 0
		background #fff
		border none
		border-radius 5px
		transition background $duration, transform .2s
		&:hover
			background-color #f6f6f6
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			margin auto
			background-repeat no-repeat
			background-position center
			transition opacity $duration
			opacity .8
		&--add
			&:before
				width 18px
				height 18px
				background-image url('data:image/png;base64,')
		&--settings
			&:before
				width 18px
				height 18px
				background-image url('data:image/png;base64,')
	&__search
		position relative
		width 100%
		border-bottom 1px solid $border
	&__search-input
		display block
		width 100%
		height 45px
		padding 16px 60px 16px 24px
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		background #fff
		border none
		border-radius 0
		border-top-left-radius 6px
		border-top-right-radius 6px
		&.not-empty
			& + ^[0]__filter-search-submit
				opacity 1
				visibility visible
		placeholder()
			color #d8d6d2
			font-weight 500
	&__search-submit
		position absolute
		top 0
		right 0
		padding 0
		width 46px
		height 46px
		background url('data:image/png;base64,') no-repeat center
		border 0
		opacity 0
		visibility hidden
		cursor pointer
		transition opacity $duration, visibility $duration
		z-index 1
	&__axis-y
		max-height 192px
	&__title
		display flex
		width 100%
		padding 12px 16px 10px
		color #acacac
		font-size 14px
		font-weight 600
		line-height 16px
	
	.checkbox
		&--with-label
			display block
			.checkbox
				&__input:checked ~ label
					font-weight 600
					background-color #fff7f7
				&__label
					padding 9px 16px 8px 45px
					font-size 14px
					line-height 16px
					transition background $duration
					&:hover
						background-color #fff7f7
					&:before
						top 8px
						left 16px
					&:after
						top 13px
						left 21px
		&--have-marker
			.checkbox
				&__label
					padding-top 7px
					padding-bottom 7px
					&:before
						top 10px
					&:after
						top 15px

	&__group
		& ^[0]__list-item
			line-height 17px
		& ^[0]__list-href
			padding-left 24px
			padding-right 24px
		.checkbox
			&--with-label
				display block
				.checkbox
					&__label
						padding-left 55px
						&:before,
						&:after
							top 50%
						&:before
							left 25px
							transform translateY(-50%)
						&:after
							left 29px
							transform translateY(-50%) rotate(-45deg)
							margin-top -1px
						&:active
							&:before
								transform translateY(-50%) scale(.9)
							&:after
								transform translateY(-50%) rotate(-45deg) scale(.9)
			&:not(.checkbox--with-actions)
				.checkbox__label
					padding 10px 25px 10px 55px
			&__input
				&:checked ~ label
					background-color #fff7f7
			&__label
				min-height 38px
				&:hover
					background-color #fff7f7
				&:before,
				&:after
					top 50%
				&:before
					left 25px
					transform translateY(-50%)
				&:after
					left 29px
					transform translateY(-50%) rotate(-45deg)
					margin-top -1px
				&:active
					&:before
						transform translateY(-50%) scale(.9)
					&:after
						transform translateY(-50%) rotate(-45deg) scale(.9)
	&__group-top
		display flex
		width 100%
		align-items center
		padding 12px 24px 14px
		border-bottom 1px solid $border
		& + ^[0]__list
			padding 0 0 12px
			border-bottom 1px solid $border
	&__group-button
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 19px
		height 19px
		margin-right 12px
		background white
		border 1px solid $border
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		cursor pointer
		user-select none
		&:hover
			background $red
			border-color $red
			&:before,
			&:after
				background-color #fff
		&:before,
		&:after
			content ''
			display block
			width 7px
			height 1px
			background $default
			transition background $duration
		&:after
			position absolute
			top 8px
			left 5px
			transform rotate(90deg)
			z-index 1
		&:active
			transform scale(.95)
	&__group-title
		color $default
		font-size 12px
		font-weight 600
		line-height 14px
	
	&__list
		padding 7px 0
	&__list-href,
	&__list-button
		display block
		width 100%
		padding 9px 16px 8px
		text-align left
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		transition background $duration
		background none
		border none
		@media $mLandscapeMax
			padding-top 7px
			padding-bottom 8px
			font-size 12px
			line-height 14px
		&[href]:hover,
		&[type="button"]:hover,
		&--active
			background-color #fff7f7
		&--active,
		strong
			font-weight 600
		&--copy,
		&--write,
		&--search
			position relative
			padding-left 38px
			&:before
				@extend .psElem
				top 50%
				left 16px
				width 14px
				height 14px
				background-repeat no-repeat
				background-position left center
				transform translateY(-50%)
		&--copy
			&:before
				background-image url('data:image/png;base64,')
		&--write
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA0AAAANCAMAAABFNRROAAAAPFBMVEUAAAATExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExITExK/pRS1AAAAE3RSTlMAVUxn5cVyCdrSzLd3YV5LNDElnSvIagAAAD5JREFUCNdtx7cBgEAQxMCFd3in/nslgWMDFGkUbbm0T8D0fkotw4MeDg0pAKsMVEf3g91xOVQdKg6N83IGbltOBAa4kjSZAAAAAElFTkSuQmCC')
		&--search
			&:before
				background-image url('data:image/png;base64,')
	&__list-href-row,
	&__list-button-row
		display flex
		align-items flex-start
	&__list-button-cell
		padding-right 32px
	&__list-href-delim
		margin-left 5px
		margin-right 5px
	&__list-button-title,
	&__list-button-text
		display block
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__list-button-title
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		margin-bottom 6px
	&__list-button-text
		color #4d4d4d
		font-size 12px
		font-weight 300
		line-height 14px
	&--right
		left auto
		right 0
	&--car
		width 100%
		& ^[0]__title,
		& ^[0]__list-href
			display flex
			span
				&:first-child
					flex-shrink 0
					width 210px
				&:nth-child(2)
					flex-grow 1
	.os-host-overflow-y
		& ^[0]__list-href
			padding-right 26px
	&--have-actions
		& ^[0]__list-item
			display flex
			align-items center
			position relative
			&:hover
				.actions
					visibility visible
				& ^[0]__list-href
					background-color #fff7f7
		.actions
			position absolute
			top 1px
			right 25px
			visibility hidden
			z-index 1
			&__item-btn:hover
				background-color #fff
		& ^[0]__list-href
			padding 12px 90px 10px 16px
	&--big
		& ^[0]__axis-y
			max-height 321px
	&--chat
		width 444px
		left auto
		right 0
		top auto
		bottom calc(100% + 4px)
		& ^[0]__axis-y
			max-height 578px
		& ^[0]__list-item
			border-bottom 1px solid $border
			&:last-child
				border-bottom none
	&--context-menu
		width 190px
	&--task-participants
		width 236px
		& ^[0]__axis-y
			max-height 280px
		& ^[0]__list-href,
		& ^[0]__list-button
			font-size 12px
		.checkbox--with-label
			.checkbox__label
				font-size 12px
	&--summ-orders-table-version
		width 1128px
		& ^[0]__axis-y
			max-height 280px
	&--work-order
		& ^[0]__head-cell,
		& ^[0]__list-button-cell
			&--number
				width 256px
			&--dir
				width 290px
			&--price
				width calc(100% - 546px)
			&--number,
			&--dir,
			&--price
				@media $mLandscapeMax
					width 100%
		& ^[0]__head
			@media $mLandscapeMax
				display none
		& ^[0]__list-href-row,
		& ^[0]__list-button-row
			@media $mLandscapeMax
				flex-direction column
