.payment-radio
	display inline-block
	vertical-align top
	position relative
	margin-right 16px
	margin-bottom 12px
	@media $mLandscapeMax
		margin-right 33px
		margin-bottom 0
	&:last-child
		margin-right 0
	&__input
		position absolute
		left 0
		top 0
		opacity 0
		pointer-events none
		&:checked ~ label
			border-color $red
			&:after
				opacity 1
	&__label
		display flex
		align-items center
		position relative
		height 45px
		padding 0 26px
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		white-space nowrap
		border 2px solid #eeedec
		border-radius 8px
		cursor pointer
		user-select none
		transition border $duration
		@media $tPortraitMax
			padding 0 20px
		@media $mLandscapeMax
			padding 0
			font-size 0
			line-height 0
			width 66px
			height 66px
		&:hover
			border-color $red
		&:before,
		&:after
			content ''
			display block
		&:before
			margin-right 14px
			background-repeat no-repeat
			background-position center
			transition background $duration
			@media $mLandscapeMax
				margin auto
		&:after
			position absolute
			top -12px
			right -12px
			width 23px
			height 24px
			background url('data:image/png;base64,') no-repeat center
			background-size contain
			opacity 0
			transition opacity $duration
			pointer-events none
			z-index 1
	&--cash
		& ^[0]__label
			&:before
				width 17px
				height 18px
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					width 25px
					height 25px
					background-image url('data:image/png;base64,')
		& ^[0]__input:checked ~ ^[0]__label
			&:before
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					background-image url('data:image/png;base64,')
	&--digital-cash
		& ^[0]__label
			&:before
				width 18px
				height 18px
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					width 25px
					height 25px
					background-image url('data:image/png;base64,')
		& ^[0]__input:checked ~ ^[0]__label
			&:before
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					background-image url('data:image/png;base64,')
	&--bank-card
		& ^[0]__label
			&:before
				width 18px
				height 12px
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					width 24px
					height 16px
					background-image url('data:image/png;base64,')
		& ^[0]__input:checked ~ ^[0]__label
			&:before
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					background-image url('data:image/png;base64,')
