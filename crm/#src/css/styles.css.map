.custom-hint
	display inline-block
	vertical-align baseline
	margin 0 11px
	&:last-child
		margin-right 0
	&__toggle
		width 18px
		height 18px
		text-align center
		color white
		font-size 12px
		font-weight 600
		line-height 18px
		background #cbcbcb
		border none
		border-radius 5px
		transition background $duration
		cursor pointer
		user-select none
		&:hover
			background-color $red
