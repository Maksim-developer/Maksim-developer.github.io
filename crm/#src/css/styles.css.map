.common-text
	h5
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		margin-bottom 24px
		&:last-child
			margin-bottom 0
	p
		margin-bottom 16px
		&:last-child
			margin-bottom 0
	ol
		counter-reset counterList
		li
			&:before
				counter-increment counterList
				content counters(counterList,".") ". "
				font-size 16px
				line-height 24px
				color $default
				margin-right 2px
