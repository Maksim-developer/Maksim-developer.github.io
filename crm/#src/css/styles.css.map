.custom-wysiwyg
	display flex
	flex-direction column
	width 100%
	min-height 502px
	background-color white
	border 1px solid $border
	border-radius 6px
	overflow hidden
	&__head
		display flex
		align-items flex-start
		padding 9px 12px
		border-bottom 1px solid $border
	&__head-right
		margin-left auto
		flex-shrink 0
		padding-left 16px
	&__body
		display flex
		flex-direction column
		flex-grow 1
		overflow hidden
	&__controls
		display flex
		flex-wrap wrap
		width 100%
		margin-bottom -8px
	&__controls-item
		margin-right 8px
		margin-bottom 8px
	&__btn-add,	
	&__controls-btn
		display flex
		justify-content center
		align-items center
		width 32px
		height 32px
		padding 0
		background-color #fff
		background-repeat no-repeat
		background-position center
		border none
		border-radius 0
		outline none
		user-select none
		cursor pointer
		&:active
			transform scale(.9)
	&__btn-add
		&:before
			content ''
			display block
			width 17px
			height 17px
			background url('data:image/png;base64,') no-repeat center white
			border 1px solid $border
			border-radius 10px
			transition background $duration, border $duration, transform .2s
		&:hover
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAHCAQAAABuW59YAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QA/4ePzL8AAAAJcEhZcwAACxIAAAsSAdLdfvwAAAAHdElNRQfmARcSIhK3zlTfAAAALklEQVQI14XKoRWAMBTAwGv3H5GHgjlS8RWKmDORpGtcAVmwfdoeCcn7N0/3cAAu2BKB1wy/7gAAAABJRU5ErkJggg==')
				background-color $red
				border-color $red
	&__controls-btn
		color #acacac
		font-size 14px
		font-weight 600
		line-height 16px
		transition color $duration, opacity $duration, transform .2s
		&:hover
			color $default
		&--bold
			font-weight bold
		&--italic
			font-style italic
		&--underline
			text-decoration underline
		&--line-through 
			text-decoration line-through
		&--emoji
			background-image url('data:image/png;base64,')
		&--link
			background-image url('data:image/png;base64,')
			opacity .4
			&:hover
				opacity 1
		&--picture
			background-image url('data:image/png;base64,')
			opacity .4
			&:hover
				opacity 1
	&__attachment
		padding 20px 18px
		border-bottom 1px solid $border
	&__axis-y
		flex-grow 1
		overflow hidden auto
		-ms-overflow-style none
		scrollbar-width none
		&::-webkit-scrollbar
			width 0
			height 0
	&__text
		flex-grow 1
		height 100%
		padding 18px
		color $default
		font-size 14px
		font-weight 400
		line-height 17px
		outline none
		overflow-wrap break-word
		user-select text
		cursor text
		p
			margin-bottom 16px
		a[href]
			color $blue
			text-decoration underline
			&:hover
				text-decoration none
		> *
			&:last-child
				margin-bottom 0
		&[data-placeholder]:before
			display block
			color #d8d6d2
			font 400 14px/17px $baseFontFamily
		&[contentEditable=true]:empty:not(:focus):before
			content:attr(data-placeholder)
	&__signature
		padding 18px
	&__signature-top
		position relative
		margin-bottom 14px
	&__signature-toggle
		display flex
		justify-content center
		align-items center
		width 106px
		height 28px
		color $default
		font-size 12px
		font-weight 400
		line-height 28px
		border-radius 14px
		background none
		border 1px solid $border
		user-select none
		cursor pointer
		&:after
			content ''
			display block
			margin-left 6px
			width 9px
			height 6px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAkAAAAGCAMAAAAmGUT3AAAAOVBMVEUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAC8dlA9AAAAEnRSTlMA8RP24tDEu6x0aUg9NiwfFgtHMRIPAAAAL0lEQVQI1x3BhQEAIRAEsTlecNv+i0USnsiRjKAKNHn45Zj62MzcK44hqXMVy8ACI78BLzLTM80AAAAASUVORK5CYII=') no-repeat center
	&__signature-text
		color $default
		font-size 14px
		font-weight 300
		line-height 17px

	&--notification-template
		min-height 158px

	&--task
		min-height 376px
		& ^[0]__axis-y
			height 324px

	&--comment
		min-height 204px
		& ^[0]__axis-y
			height 154px
