.popup
	position relative
	width 100%
	max-width 740px
	margin 35px auto
	background #fff
	border-radius 8px
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	z-index 1
	&__close-btn
		display flex
		justify-content center
		align-items center
		position absolute
		top 16px
		left -35px
		width 35px
		height 30px
		background $red
		border none
		border-top-left-radius 8px
		border-bottom-left-radius 8px
		z-index 1
		&:before
			content ''
			display block
			width 10px
			height 10px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAMAAAC67D+PAAAAM1BMVEUAAAD///////////////////////////////////////////////////////////////+3leKCAAAAEHRSTlMA9op9eXVykVtWUpWEc1hPcTTgCAAAAD9JREFUCNc1y0kSwCAMxEDZJGHJNv9/LQUGnXRpzJk9RtYJcOmGY/yrBONri4MqFaJfahCifNumZX1bxzIztw5obAHUCLDreAAAAABJRU5ErkJggg==') no-repeat center
			transform translateX(-4px)
	&__axis-y
		height 100%
	&__top
		display flex
		align-items center
		padding 20px 90px 18px 30px
		border-bottom 1px solid $border
		& + ^[0]__bottom
			padding-top 30px
		& ^[0]__title
			margin-right 24px
			&:last-child
				margin-right 0
	&__top-btn
		width 34px
		height 34px
		padding 0
		margin-left auto
		&--restore-letter
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA0AAAAJBAMAAAAbVLtZAAAAMFBMVEUAAAD///////////////////////////////////////////////////////////87TQQwAAAAD3RSTlMALfuQ9e6fJB7oqqKgeBhI76a5AAAANElEQVQI12MAAzYHCG3/AUwxfxJgqANxFRkYvjSAuQzrI8BcBu6vtUAuEJz/rwjR+xPEBQCJCwy2f15pDAAAAABJRU5ErkJggg==') center no-repeat, $red
			&:hover
				background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA0AAAAJBAMAAAAbVLtZAAAAMFBMVEUAAAD///////////////////////////////////////////////////////////87TQQwAAAAD3RSTlMALfuQ9e6fJB7oqqKgeBhI76a5AAAANElEQVQI12MAAzYHCG3/AUwxfxJgqANxFRkYvjSAuQzrI8BcBu6vtUAuEJz/rwjR+xPEBQCJCwy2f15pDAAAAABJRU5ErkJggg==') center no-repeat, $red
	&__title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
	&__content
		padding 27px 30px 30px
	&__text
		font-size 14px
		line-height 16px
		color $default
	&__bottom,
	&__btns
		.btn + .btn,
		.btn + .common-dropdown-wrap,
		.common-dropdown-wrap + .btn
			margin-left 16px
		.common-dropdown-wrap
			margin-right 0
	&__bottom
		display flex
		align-items center
		width 100%
		padding 0 30px 60px
		&--left
			justify-content flex-start
		&--right
			justify-content flex-end
	&__btns
		display flex
		justify-content center
		width 100%
	&__edit
		display flex
		align-items center
		flex-shrink 0
		margin-right auto
	&__edit-controls
		display flex
		align-items center
		&:not(:last-child)
			margin-right 14px
	&__edit-controls-item
		&:not(:last-child)
			margin-right 8px
	&__edit-controls-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 34px
		height 34px
		padding 0 0 1px
		background #fff
		border 1px solid #ECEBE9
		border-radius 17px
		transition background $duration, border $duration, trnasform .2s
		cursor pointer
		user-select none
		&:before
			content ''
			display block
			width 5px
			height 9px
			background url('data:image/png;base64,') no-repeat center
			transition background $duration
		&:hover
			background-color $red
			border-color $red
			&:before
				background-image url('data:image/png;base64,')
		&:active
			transform scale(.97)
		&--prev
			padding-right 2px
			&:before
				transform scaleX(-1)
		&--next
			padding-left 2px
	&__edit-count
		font-size 14px
		line-height 16px
		font-weight 600
		color $default
	&__comments
		padding 30px 30px 60px
		border-top 1px solid $border
	&--content-no-padding
		& ^[0]__content
			padding 0
	&--min,
	&--new-prod,
	&--sent-prod,
	&--want-leave,
	&--confirm-delete,
	&--favorites,
	&--entries,
	&--connected,
	&--new-unit, 
	&--new-brand,
	&--new-worker,
	&--new-position,
	&--success-downloaded,
	&--error-downloaded,
	&--create-article,
	&--create-tag
		max-width 500px
	&--table-settings,
	&--multiple-settings
		max-width 869px
		padding 0
		& ^[0]__content
			&:not(:first-child)
				margin-top 0
		& ^[0]__bottom
			.btn
				flex-shrink 0
			& ^[0]__text
				margin-left 114px
				color #bcbcbc
				font-size 12px
				font-weight 400
				line-height 14px
	&--table-settings
		& ^[0]__content
			padding 0 0 30px
	&--multiple-settings
		& ^[0]__content
			padding 0
		& ^[0]__bottom
			padding-top 30px
			border-top 1px solid $border
		.tabs
			&__controls
				padding-left 30px
				padding-right 30px
				& + .tabs__items
					margin-top 0
			&__controls-btn
				padding 11px 0
			&__item
				display flex
				flex-direction column
				min-height 274px
			&__item-content
				padding 27px 30px 0
		.table-settings-column
			border-bottom none
	&--success-downloaded,
	&--error-downloaded
		& ^[0]__content
			padding 122px 26px
			border-bottom none
		.mfp-close
			border-left none
	&--new-client,
	&--new-product,
	&--accept-payment,
	&--template-warranty,
	&--restore-letter,
	&--notification
		max-width 1095px
	&--pin-car
		max-width 1266px
		& ^[0]__content
			padding 0 0 14px
	&--chat
		max-width 774px
	&--move-group
		& ^[0]__content
			padding-left 0
			padding-right 0
	&--restore-letter
		& ^[0]__top
			padding-top 14px
			padding-bottom 14px
	&--creating-letter
		max-width 1187px
		& ^[0]__content
			padding-top 0
			padding-left 0
			padding-right 0
		.mfp-close
			display none
	&--right-position
		position relative
		max-width 1588px
		height 100vh
		right -1640px
		margin 0 0 0 auto
		border-radius 0
		transition right .6s
		@media screen and (max-width: 1700px)
			max-width calc(100vw - 112px)
			right -100%
		/.mfp-ready &
			right 0
			transition right .6s
		& ^[0]__container
			display flex
			flex-direction column
			position relative
			width 100%
			height 100%
		& ^[0]__axis-y
			flex-grow 1
		& ^[0]__top
			padding-top 16px
			padding-bottom 16px
		& ^[0]__title
			font-size 24px
			line-height 30px
			white-space nowrap
			text-overflow ellipsis
			overflow hidden
		& ^[0]__content
			flex-grow 1
		& ^[0]__bottom
			padding-bottom 30px
			&:last-child
				padding-bottom 60px
		.tabs
			display flex
			flex-direction column
			height 100%
			&__items
				flex-grow 1
			&__item
				height 100%
			&__axis-y,
			&__item-content
				width calc(100% + 30px)
				@media $mLandscapeMax
					width calc(100% + 16px)
			&__item-content
				@media $mLandscapeMax
					height 100%
			&__axis-y
				&.os-host-overflow-y
					padding-right 12px
					@media $mLandscapeMax
						padding-right 0
				.form
					padding-right 30px
					@media $mLandscapeMax
						padding-right 16px
	&--accept-payment
		& ^[0]__bottom
			@media $mLandscapeMax
				padding 0 16px 32px
			&--right
				@media $mLandscapeMax
					justify-content flex-start
			.btn
				@media $mLandscapeMax
					margin-left 0
				@media $mPortraitIphoe6Max
					width 100%
				&--no-border
					@media $mLandscapeMax
						display none
	&--work-restriction,
	&--new-record
		& ^[0]__bottom
			@media $mLandscapeMax
				display none
	&--work-restriction
		max-width 658px
		.form
			&__field
				&--flex
					@media $mLandscapeMax
						flex-wrap wrap
				&--min
					@media $mLandscapeMax
						width 100%
					& + .form__field
						@media $mLandscapeMax
							margin-top 12px
	&--accept-payment,
	&--work-restriction,
	&--right-position
		@media $mLandscapeMax
			position fixed
			top 44px
			left 0
			width 100%
			max-width 100%
			height calc(100% - 44px)
			margin 0
			border-radius 0
			box-shadow none
			overflow-y auto
			z-index 1
		& ^[0]__top
			@media $mLandscapeMax
				min-height 64px
				padding 15px 16px 14px 62px
		& ^[0]__title
			@media $mLandscapeMax
				font-size 12px
				font-weight 600
				line-height 12px
				white-space nowrap
				text-overflow ellipsis
				overflow hidden
		& ^[0]__content
			@media $mLandscapeMax
				padding 16px 16px 28px
		.mfp-close
			@media $mLandscapeMax
				display block
				width 32px
				height 32px
				position absolute
				top 16px
				left 16px
				padding 0
				color transparent
				font-size 0
				line-height 0
				background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABIAAAASBAMAAACk4JNkAAAAJFBMVEX////Z19Pl4+Hw7+709PPq6efo5uTe3Nn39vXx8e/8/Pvs7Oo5akDUAAAASElEQVQI12MgCNIboAxWQRgrUBguNAEmVAFlsAmWKgGBCgMDoyAYCDEwsAhWTjY2NrYCSjtKQ5SBBBNgTEcxhKADjOm6AJeLADg/CVgVeUMDAAAAAElFTkSuQmCC') no-repeat center
				border 1px solid $border
				border-radius 6px
				opacity 1
				&:before
					content none
					display none
				&:active
					top 16px
	&--new-record
		& ^[0]__content
			@media $mLandscapeMax
				padding-left 0
				padding-right 0
		.main__top
			@media $mLandscapeMax
				display none
		.form
			&__field
				&--min
					@media $mLandscapeMax
						width 100%
					& + .form__field
						@media $mLandscapeMax
							margin-top 12px

		.table
			&--created
				.table__cell
					&--flex-grow_sm_max
						@media $mLandscapeMax
							flex-grow 1
			&__body
				@media $mLandscapeMax
					height calc(100% - 30px)


	.tabs
		padding-top 0
		overflow visible
		&__controls-item
			&:not(:last-child)
				@media $mLandscapeMax
					margin-right 25px

	.form
		&__row + .form__row
			margin-top 27px
			@media $mLandscapeMax
				margin-top 12px
		&__row--group-mobile + .form__row--group-mobile
			@media $mLandscapeMax
				margin-top 0
		&__row--group-mobile + .form__row:not(.form__row--group-mobile)
			@media $mLandscapeMax
				margin-top 24px
		&__field-input
			height 50px
			line-height 48px
			@media $mLandscapeMax
				height 38px
				font-size 12px
				line-height 38px
				padding 0 15px

	.tags-dropdown
		&__axis-y
			max-height 372px

	.auto
		max-width 100%
