.spare-parts
	display flex
	align-items center
	&__group
		width 100%
		&--red
			& ^[0]__group-title
				color #f93d3d
				background-color #F7E8E8
		&:last-child
			& ^[0]__item
				&:last-child
					border-bottom 1px solid $border
	&__group-title
		padding 11px 15px
		color #37b076
		font-family Montserrat
		font-size 12px
		font-weight 500
		line-height 12px
		background-color #e8f7e9
	&__group-content
		width 100%
		& ^[0]__items
			flex-direction column
			width 100%
			margin-bottom 0
		& ^[0]__item
			height auto
			margin-bottom 0
			padding 8px 15px
			font-size 12px
			line-height 12px
			background-color #fff
			border-radius 0
			border-bottom 1px solid $border
			&:last-child
				border-bottom none
	&__items
		display flex
		margin-bottom -6px
	&__item
		display flex
		align-items center
		height 28px
		margin-bottom 6px
		padding 7px 8px
		text-align left
		color #37b076
		font-size 14px
		font-weight 400
		line-height 14px
		font-family $fontConsolas
		background #e8f7e9
		border none
		border-radius 6px
		@media $mLandscapeMax
			height 17px
			padding 5px
			font-size 11px
			line-height 11px
		&:not(:last-child) 
			margin-right 6px
		&--red
			color #f93d3d
			background-color #f7e8e8
		&--blue
			color $blue
			background-color #f5faff
	&__more
		position relative
		margin-left 6px
	&__more-toggle
		display flex
		align-items center
		justify-content center
		width 29px
		height 29px
		padding 0
		color $default
		font-size 10px
		line-height 10px
		font-weight 700
		background white
		border 1px solid $border
		border-radius 50%
		transition color $duration, background $duration, transform .2s
		@media $mLandscapeMax
			width 22px
			height 22px
		&:hover
			@media $desktopMax
				color #fff
				background $red
		&.active
			color #fff
			background $red
		&:active
			transform scale(.97)
	&__more-dropdown
		display none
		position absolute
		top calc(100% + 2px)
		right 0
		width 318px
		padding 15px
		background white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 1
		@media $mLandscapeMax
			display none !important
		&--right
			left 0
			right auto
		& ^[0]__items
			width 100%
			flex-wrap wrap
	&--mobile
		flex-direction column
		align-items flex-start
