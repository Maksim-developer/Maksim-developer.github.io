.table-settings-column
	display flex
	width 100%
	height 274px
	border-bottom: 1px solid $border;
	&__left
		width 367px
	&__right
		width calc(100% - 356px)
	&__axis-x
		width 100%
		height 100%
	&__items
		padding 15px 38px 8px 26px
	&__item
		line-height 17px
		&:not(:last-child)
			margin-bottom 11px
		.checkbox
			&--with-label
				display block
			&__input
				&:checked ~ label
					background-color #fff7f7
			&__label
				padding 10px 25px 10px 55px
				font-size 14px
				border-radius 6px
				&:hover
					background-color #fff7f7
				&:before
					top 10px
					left 25px
				&:after
					top 14px
					left 29px
	&__drag-area
		width 100%
		height 100%
		padding 15px 24px
	&__drag-items
		display flex
		flex-wrap wrap
		width 100%
		counter-reset columnItem
	&__drag-item
		display flex
		align-items center
		position relative
		height 30px
		margin-right 9px
		margin-bottom 9px
		padding 5px 38px 5px 6px
		border 1px solid #eeedec
		border-radius 6px
		transition border $duration, background $duration
		cursor pointer
		user-select none
		&:before
			counter-increment columnItem
			content counter(columnItem) " "
			flex-shrink 0
			min-width 19px
			height 19px
			margin-right 16px
			text-align center
			color $default
			font-size 9px
			font-weight 600
			line-height 19px
			background-color #faf7f3
			border-radius 10px
	&__drag-item-text
		color $default
		font-size 12px
		line-height 12px
		white-space nowrap
	&__drag-item-delete
		display flex
		flex-direction column
		justify-content center
		align-items center
		position absolute
		top 0
		right 7px
		width 24px
		height 100%
		padding 0
		background none
		border none
		border-radius 0
		user-select none
		z-index 1
		&:before
			content ''
			display block
			width 8px
			height 8px
			background url('data:image/png;base64,') no-repeat center
