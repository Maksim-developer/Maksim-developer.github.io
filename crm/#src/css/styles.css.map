.filter-mobile
	width 100%
	height 100%
	&__head
		display flex
		align-items center
		width 100%
		padding 10px 14px
		height 42px
		border-bottom 1px solid $border
	&__close
		display block
		width 32px
		height 32px
		margin-right 12px
		padding 0
		background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABIAAAASBAMAAACk4JNkAAAAJFBMVEX////Z19Pl4+Hw7+709PPq6efo5uTe3Nn39vXx8e/8/Pvs7Oo5akDUAAAASElEQVQI12MgCNIboAxWQRgrUBguNAEmVAFlsAmWKgGBCgMDoyAYCDEwsAhWTjY2NrYCSjtKQ5SBBBNgTEcxhKADjOm6AJeLADg/CVgVeUMDAAAAAElFTkSuQmCC') no-repeat center
		border none
	&__title
		color $default
		font-size 14px
		font-weight 700
		line-height 16px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__items,
	&__subitems
		height 100%
		overflow-y auto
	&__item
		border-bottom 1px solid $border
		&--active
			& ^[0]__item-dropdown
				left 0
				opacity 1
				visibility visible
	&__item-btn
		display flex
		align-items center
		width 100%
		min-height 41px
		padding 14px
		text-align left
		background none
		border none
	&__item-btn-title,
	&__item-btn-text
		display block
		flex-shrink 0
		font-size 12px
		font-weight 500
		line-height 14px
	&__item-btn-title
		width 40%
		padding-right 12px
		color $default
	&__item-btn-text
		width 60%
		text-align right
		color #d8d6d2
	&__item-dropdown
		position fixed
		top 106px
		left 100%
		bottom 0
		width 100%
		background-color #fff
		opacity 0
		visibility hidden
		transition left $duration, opacity $duration, visibility $duration
		z-index 1
	&__checkbox
		position relative
	&__checkbox-input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
		&:checked ~ label:before
			opacity 1
			visibility visible
	&__checkbox-label
		display flex
		align-items center
		position relative
		width 100%
		min-height 41px
		padding 14px 52px 14px 14px
		text-align left
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		cursor pointer
		&:before
			@extend .psElem
			top 50%
			right 14px
			width 14px
			height 11px
			background url('data:image/png;base64,') no-repeat center
			transform translateY(-50%)
			opacity 0
			visibility hidden
			transition opacity $duration, visibility $duration
			z-index 1
