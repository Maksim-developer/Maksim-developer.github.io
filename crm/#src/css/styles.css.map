.update-history
	display flex
	flex-direction column
	flex-grow 1
	width 100%
	&__axis-y
		width 100%
		height 100%
		padding-right 32px
	&__item
		position relative
		margin-bottom 40px
		padding-left 54px
		&:last-child
			margin-bottom 0
		&:before
			@extend .psElem
			top 0
			left 0
			width 35px
			height 35px
			background url('data:image/png;base64,') no-repeat center, #eeedec
			border-radius 50%
	&__item-href
		display inline-block
		vertical-align top
		margin-bottom 6px
		color $default
		font-size 16px
		font-weight 600
		line-height 20px
		&:hover
			span
				border-bottom-color $default
		span
			border-bottom 1px solid transparent
			transition border $duration
	&__item-details
		display flex
		width 100%
	&__item-date,
	&__item-author
		color #b2afac
		font-size 12px
		font-weight 400
		line-height 14px
		margin-right 12px
		&:last-child
			margin-right 0
	&__item-author
		border-bottom 1px solid #b2afac
		transition border $duration
		&:hover
			border-bottom-color transparent
