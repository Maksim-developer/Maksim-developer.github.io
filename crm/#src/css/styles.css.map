.form
	width 100%
	max-width 1174px
	/.tabs &
		max-width 1055px
		@media $desktopMax
			max-width calc(100% - 24px)
		@media $mLandscapeMax
			max-width 100%
	/.popup--right-position &
		max-width 100%
	&__row
		display flex
		align-items flex-end
		width 100%
		@media $tPortraitMax
			flex-wrap wrap
		&--between
			justify-content space-between
		&--top
			align-items flex-start
		&--center
			align-items center
		&--group-mobile
			@media $mLandscapeMax
				position relative
				padding 25px 0
				&:after
					@extend .psElem
					left -16px
					right -16px
					bottom 0
					border-bottom 1px solid $border
	&__row + &__row
		margin-top 38px
		@media $mLandscapeMax
			margin-top 12px
	&__field-wrap
		width 100%
		padding 13px 15px 15px
		background-color #fffbf8
		border 1px dashed #f3ddcd
		border-radius 6px
		transition background $duration, border $duration
		&.active
			background-color #f2fff2
			border-color #2caf2c
	&__field
		width 100%
		position relative
		&--auto
			width auto
		&--min,
		&--half,
		&--third,
		&--third-x2,
		&--quarter
			margin-right 32px
			&:last-child
				margin-right 0
		&--min
			flex-shrink 0
			width 133px
		&--half
			width calc(50% - 16px)
			@media $mLandscapeMax
				width 100%
				margin-right 0 !important
				margin-bottom 12px
			&:last-child
				@media $mLandscapeMax
					margin-bottom 0
		&--third
			width calc(100%/3 - 18px)
			@media $tPortraitMax
				width calc(50% - 16px)
			@media $mLandscapeMax
				width 100%
				margin-right 0 !important
				margin-bottom 12px
			&:last-child
				@media $tPortraitMax
					margin-bottom 0
		&--third-x2
			width calc((100% - 100%/3) - 4px)
			@media $tPortraitMax
				width 100%
		&--quarter
			width calc(25% - 24px)
			@media $tPortraitMax
				width calc(50% - 16px)
			@media $mPortraitMax
				width 100%
				margin-right 0 !important
				margin-bottom 12px
			&:last-child
				@media $mPortraitMax
					margin-bottom 0
		&--button
			flex-shrink 0
			width auto
			min-width 144px
			margin-left 26px
			&:first-child
				margin-left 0
		&--total
			width auto
			margin-left auto
		&--flex
			display flex
			align-items flex-end
			.checkbox--with-label
				margin-right 40px
				&:last-child
					margin-right 0
		&--right
			display flex
			flex-direction column
			align-items flex-end
			& ^[0]__field-label
				justify-content flex-end
		&--combi-select
			width 150px
			.jq-selectbox
				&__select
					border-top-right-radius 0px
					border-bottom-right-radius 0px
				&__reset
					display none
		&--combi-input
			width calc(100% - 150px)
			& ^[0]__field-input
				border-top-left-radius 0px
				border-bottom-left-radius 0px
				border-left-color transparent
		&--payment
			& ^[0]__field-input
				font-size 24px
				font-weight 600
				@media $mLandscapeMax
					font-size 18px
				&[readonly]
					padding-left 0
					padding-right 0
					background none
					border none
		&.error
			& ^[0]__field-warning
				opacity 1
				visibility visible
		.checkbox-custom
			height 50px
	&__field-settings
		display flex
		flex-wrap wrap
		width 100%
		margin-top 22px
	&__field-setting
		margin-right 26px
		margin-bottom 18px
	&__field-label
		display flex
		width 100%
		margin-bottom 7px
		font-size 14px
		line-height 16px
		font-weight 600
		color $default
		@media $mLandscapeMax
			font-size 12px
			line-height 14px
			margin-bottom 6px
		&--wrap
			display flex
			flex-direction column
			margin-bottom 0
			& ^[0]__field-markers
				margin-top 7px
		sup
			flex-shrink 0
			top 0px
			font-size 14px
			line-height 16px
			color $red
			margin-left 4px
		.count-characters
			margin-left auto
			flex-shrink 0
		.checkbox-min
			margin-left 8px
	&__field-label-btn
		display flex
		align-items center
		color #d8d6d2
		font-size 12px
		font-weight 500
		line-height 14px
		transition color $duration
		&:not(:first-child)
			margin-left 15px
		&:hover
			color $default
			&:before
				background-image url('data:image/png;base64,')
		&:before
			content ''
			display block
			margin-top -1px
			margin-right 10px
			width 15px
			height 15px
			background url('data:image/png;base64,') no-repeat center
			transition background $duration
	&__field-input,
	&__field-textarea
		display block
		width 100%
		color $default
		background #fff
		border 1px solid #ececec
		border-radius 6px
		box-shadow 0px 0px 0px 1px transparent
		transition border $duration, box-shadow $duration
		+placeholder()
			color #d8d6d2
			font-weight 500
		&:hover,
		&:focus,
		/.error &
			border-color $red
			box-shadow 0px 0px 0px 1px $red
		&[readonly]
			background-color #f9f9f9
			border-color #eeedec
			box-shadow 0px 0px 0px 0px transparent
			pointer-events none
			cursor default
			&:hover,
			&:focus
				box-shadow 0px 0px 0px 0px transparent
	&__field-input
		height 50px
		padding 0 17px
		font 500 14px/48px $baseFontFamily
		@media $mLandscapeMax
			height 38px
			font-size 12px
			line-height 38px
			padding 0 15px
	&__field-textarea
		height 109px
		padding 9px 17px
		font 500 14px/17px $baseFontFamily
		resize none
		@media $mLandscapeMax
			height 72px
			font-size 12px
			line-height 14px
			padding 10px 15px
	&__field-wysiwyg
		display block
		width 100%
		height 497px
		border 1px solid #ececec
		border-radius 6px
		box-shadow 0px 0px 0px 1px transparent
	&__field-button
		display inline-flex
		align-items center
		height 50px
		padding 0
		color $default
		font-weight 600
		font-size 14px
		line-height 16px
		white-space nowrap
		user-select none
		transition color $duration
		&:hover
			color #4a4a47
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAHCAQAAABuW59YAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QA/4ePzL8AAAAJcEhZcwAACxIAAAsSAdLdfvwAAAAHdElNRQfmARcSIhK3zlTfAAAALklEQVQI14XKoRWAMBTAwGv3H5GHgjlS8RWKmDORpGtcAVmwfdoeCcn7N0/3cAAu2BKB1wy/7gAAAABJRU5ErkJggg==')
				background-color $red
				border-color $red
		&:before
			content ''
			display block
			width 17px
			height 17px
			margin-right 12px
			background url('data:image/png;base64,') no-repeat center white
			border 1px solid $border
			border-radius 10px
			transition background $duration, border $duration
	&__field-button-add
		position absolute
		right 0
		bottom 0
		width 30px
		height 30px
		background url('data:image/png;base64,') no-repeat center
		border-radius 3px
		border none
		cursor pointer
		user-select none
		z-index 1
	&__field-summ
		display flex
		align-items flex-start
		color $default
		font-size 14px
		font-weight 300
		line-height 16px
		span
			font-size 22px
			font-weight 500
			line-height 22px
			margin-left 20px
	&__field-warning
		position absolute
		left 0
		bottom -10px
		height 21px
		padding 7px 9px 4px
		color white
		font-size 10px
		line-height 10px
		font-weight 500
		background $red
		border-radius 6px
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1
		&:before
			@extend .psElem
			top -4px
			left 15px
			width 0
			height 0
			border-style solid
			border-width 0 6.5px 7px 6.5px
			border-color transparent transparent $red transparent
	&__field-select
		&.jq-selectbox
			ul
				padding 10px 0
			li
				display block
				padding 9px 16px 8px
				color $default
				font-size 14px
				font-weight 500
				line-height 16px
				background-color #fff
				transition background $duration 
				&.sel, 
				&.selected,
				&:hover
					background-color #fff7f7
					color $default
				&.sel,
				&.selected
					font-weight 600
				&:not(:first-child)
					border none
			&--actions
				li
					padding 11px 110px 11px 16px
		.jq-selectbox
			&__dropdown
				background white
				border 1px solid $border
				border-radius 6px
				box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		&--range
			width 50%
			&:first-child
				.jq-selectbox__select
					border-top-right-radius 0px
					border-bottom-right-radius 0px
			& + ^[0]__field-select--range
				width 50%
				.jq-selectbox__select
					border-left-color transparent
					border-top-left-radius 0px
					border-bottom-left-radius 0px
					&:hover, 
					&:focus
						border-left-color #f00
	&__field-markers
		display flex
		flex-wrap wrap
		width 100%
		padding 10px 10px 4px
		background-color white
		border 1px solid #eeedec
		border-radius 6px
	&__field-markers-input
		display block
		height 29px
		color $default
		font-size 14px
		line-height 27px
		white-space nowrap
		background #fff
		border none
		margin-bottom 5px
		&:focus
			outline none
	&__field-text
		flex-shrink 0
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		margin-right 12px
		&:last-child
			margin-right 0
	&__bottom
		display flex
		margin-top 42px
		.btn
			text-transform uppercase
			& + .btn
				margin-left 18px
			&--accent
				font-weight 500
	&--big
		max-width 1436px
	&--new-car &__bottom
		justify-content flex-end
	&--new-prod &__bottom
		justify-content space-between
		.btn
			width calc(50% - 9px)
			margin 0
	&--sales-invoice &__field--half,
	&--incoming-note &__field--half
		max-width 212px
	&--sales-invoice &__bottom,
	&--incoming-note &__bottom
		.btn
			font-size 16px
			font-weight 500
			width 100%
	&--additionally
		max-width 636px
		/.tabs &
			max-width 636px
	&--additionally &__field-textarea
		height 75px
		padding-right 40px
		color #b2b2b2
	&--provider &__field
		max-width 461px
		&:not(:last-child)
			margin-right 20px
	&--provider &__btn-submit
		text-transform uppercase
		white-space nowrap
		padding 12px 18px
		font-weight 500
	&--new-unit, 
	&--new-brand,
	&--new-worker,
	&--new-position
		& ^[0]__bottom
			justify-content flex-end
	&--invoice
		margin-bottom 23px
		@media $mLandscapeMax
			display none
		& ^[0]__field
			width 160px
			margin-right 10px
			margin-bottom 10px
			&--date
				& ^[0]__field-input
					padding-top 18px
					padding-bottom 6px
					line-height 17px
		& ^[0]__field-input
			padding 0 14px
	&--new-product
		& ^[0]__field-button
			height auto
			&:not(:last-child)
				margin-right 25px
	&--template-warranty
		& ^[0]__field-wysiwyg
			height 364px
	&--full-width
		/.tabs &
			max-width none
		& ^[0]__field-textarea
			max-width 1055px
	&--notif
		/ .tabs &
			max-width 100%
		& > ^[0]__row
			border-bottom 1px solid #ececec
			padding-bottom 28px
			/ .popup &
				border-bottom none
				padding-bottom 0
		& ^[0]__row + ^[0]__row
			margin-top 28px
			/ .popup &
				margin-top 27px
		& ^[0]__field
			margin-right 12px
			&:last-child
				margin-right 0
			&--third
				max-width 304px
		& ^[0]__field-content
			max-width 944px
		& ^[0]__btn
			min-width 130px
			margin-left auto

	&--record
		& ^[0]__row
			&--grid-tablet
				@media $desktopMax
					flex-wrap wrap
					justify-content space-between
					margin-bottom -27px
					@media $mLandscapeMax
						margin-bottom 0
		& ^[0]__field
			&--flex
				@media $tPortraitMax
					flex-wrap wrap
			&--quarter
				@media $desktopMax
					width calc(50% - 16px)
					margin-right 0
					margin-bottom 27px
					@media $mLandscapeMax
						width 100%
						margin-bottom 12px
				&:last-child
					@media $mLandscapeMax
						margin-bottom 0
