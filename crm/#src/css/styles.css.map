.data
	&__action
		padding 39px 45px
	&__action-title
		color black
		font-size 22px
		line-height 26px
		font-weight 500
		&:not(:last-child)
			margin-bottom 58px
	&__action-button
		display flex
		align-items center
		width 100%
		max-width 270px
		&:not(:last-child)
			margin-bottom 20px
		&:before
			content ''
			display block
			width 14px
			height 14px
			margin-right 16px
			flex-shrink 0
			background url('data:image/png;base64,') no-repeat center
	&__action-text
		color #919191
		font-size 14px
		line-height 17px
		font-weight 300
	&__form
		max-width 1424px
		padding 4px 45px 81px
		border-bottom 1px solid #f0f0f0
		&:first-child
			padding-top 81px
	&__form-text
		color black
		font-size 16px
		line-height 20px
		font-weight 500
		&:not(:last-child)
			margin-bottom 19px
	&__download-label
		display flex
		justify-content center
		align-items center
		position relative
		width 100%
		height 325px
		background-color snow
		border 1px dashed #ffc3c3
		border-radius 10px
		cursor pointer
		user-select none
		&:hover
		&.drag_over
			border-width 2px
			& ^[0]__download-label-text
				span
					border-bottom-color transparent
	&__download-input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
	&__download-label-text
		display flex
		flex-wrap wrap
		justify-content center
		align-items flex-start
		position relative
		font-size 14px
		line-height 17px
		font-weight 300
		color #b4b4b4
		&:before
			content ''
			display block
			width 12px
			height 19px
			margin-top -2px
			margin-right 10px
			background url('data:image/png;base64,') no-repeat center
		span
			color #ff0101
			border-bottom 1px solid #ff0101
			transition border $duration
			margin-left 6px
