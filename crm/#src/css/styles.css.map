.notif
	display none
	position absolute
	right 0
	top calc(100% + 13px)
	width 668px
	background-color white
	border 1px solid $border
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	z-index 10
	@media $tPortraitMax
		width 580px
	@media $mLandscapeMax
		display none !important
	&__head
		display flex
		justify-content space-between
		align-items center
		width 100%
		padding 13px 27px 13px 24px
		border-bottom 1px solid $border
	&__title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
	&__settings
		display flex
	&__setting
		position relative
		&:not(:first-child)
			margin-left 6px
	&__setting-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 38px
		height 38px
		padding 0
		background none
		border 1px solid $border
		border-radius 50%
		transition transform .2s
		user-select none
		cursor pointer
		&:hover
			& ^[0]__setting-btn-ico
				opacity 1
		&:active
			transform scale(.92)
		&--active
			& ^[0]__setting-btn-ico,
			& + ^[0]__setting-sublist
				opacity 1
			& + ^[0]__setting-sublist
				visibility visible
	&__setting-btn-ico
		align-self center
		max-width 100%
		max-height 100%
		opacity .19
		transition opacity $duration
	&__setting-sublist
		position absolute
		top 51px
		right -1px
		padding 9px 0 12px
		width 204px
		background white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1 
	&__setting-sublist-item
		line-height 14px
	&__setting-sublist-href
		display flex
		align-items center
		width 100%
		padding 11px 20px 12px
		line-height 14px
		transition background $duration
		&:hover
		&--active,
			background-color #fbfaf9
			& ^[0]__setting-sublist-href-overico
				opacity 1
			& ^[0]__setting-sublist-href-title				
				color $default
	&__setting-sublist-href-overico
		display flex
		flex-direction column
		justify-content center
		align-items center
		flex-shrink 0
		width 14px
		height 14px
		margin-right 16px
		opacity .49
		transition opacity $duration
	&__setting-sublist-href-ico
		align-self center
		max-width 100%
		max-height 100%
	&__setting-sublist-href-title
		width 100%
		color #959594
		font-size 12px
		font-weight 500
		line-height 14px
		transition color $duration
	&__axis-y
		max-height 574px
	&__group-title
		padding 11px 44px 13px
		color #d8d6d2
		font-size 14px
		line-height 14px
		font-weight 700
		border-bottom 1px solid $border
	&__item
		display flex
		width 100%
		padding 12px 26px 18px 15px
		border-bottom 1px solid whitesmoke
		transition background $duration
		&:not(.notif__item--active):hover
			background-color #fbfaf9
		&--active
			background-color #fff7f7
			& ^[0]__item-prop
				a
					color $red
					border-bottom-color $red
					&:hover
						border-bottom-color transparent
			& ^[0]__item-read-toggle
				&:before
					background-color white
				&:after
					background-color $red
					border-color white
			& ^[0]__item-section
				font-weight 600
			& ^[0]__item-prop
				a
					font-weight 500
	&__item-read-toggle
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 24px
		height 24px
		margin-right: 11px;
		top: -6px;
		padding 0
		border-radius 12px
		background none
		border none
		transition transform .2s
		&:before,
		&:after
			content ''
			display block
			border-radius 50%
		&:before
			width 14px
			height 14px
			background-color transparent
			transition background $duration
		&:after
			position absolute
			top 50%
			left 50%
			width 7px
			height 7px
			background-color white
			border 1px solid #d8d6d2
			transform translate(-50%, -50%)
			transition border $duration, background $duration
			z-index 1
		&:active
			transform scale(.97)
	&__item-right
		display flex
		justify-content space-between
		width 100%
	&__item-content
		width calc(100% - 110px)
	&__item-top
		display flex
		flex-wrap wrap
		width 100%
	&__item-section
		display flex
		align-items center
		color $default
		font-size 14px
		font-weight 500
		line-height 17px
		margin-right 16px
		&:before
			content ''
			display block
			flex-shrink 0
			margin-right 8px
			background-repeat no-repeat
			background-position center
			background-size contain
		&--storage
			&:before
				width 11px
				height 11px
				background-image url('data:image/png;base64,')
		&--duty
			&:before
				width 11px
				height 13px
				background-image url('data:image/png;base64,')
	&__item-date
		display block
		color #c2c0bd
		font-size 12px
		font-weight 400
		line-height 17px
	&__item-props
		display flex
		width 100%
		&:not(:first-child)
			margin-top 6px
	&__item-prop
		position relative
		color $default
		font-size 14px
		line-height 17px
		font-weight 400
		&:not(:last-child)
			margin-right 36px
			&:after
				@extend .psElem
				top 1px
				right -18px
				width 1px
				height 15px
				background-color #c6c5c2
		a
			color $default
			border-bottom 1px solid $default
			transition color $duration, border $duration
			&:hover
				border-bottom-color transparent
	&__item-actions
		display flex
		flex-shrink 0
		position relative
		top 5px
	&__item-action
		&:not(:first-child)
			margin-left 6px
	&__item-action-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 38px
		height 38px
		padding 0
		border-radius 50%
		background none
		border 1px solid transparent
		cursor pointer
		user-select none
		transition transform $duration
		&:hover
			background white
			border-color $border
		&:before
			content ''
			display block
			background-repeat no-repeat
			background-position center
			transition background $duration
		&:active
			transform scale(.92)
		&--order
			&:before
				width 14px
				height 13px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')
		&--delete
			&:before
				width 11px
				height 13px
				background-image url('data:image/png;base64,')
			&:hover
				&:before
					background-image url('data:image/png;base64,')
