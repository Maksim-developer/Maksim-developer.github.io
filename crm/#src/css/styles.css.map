.months
	display none
	width 100%
	border-top 1px solid $border
	@media $mLandscapeMax
		display flex
	&__axis-x
		width 100%
		overflow-x auto
		padding 0 4px
	&__items
		display flex
	&__item
		flex-shrink 0
	&__item-days
		display flex
	&__item-day-button
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 46px
		height 46px
		padding 0
		background #fff
		border none
		&.active
			background-color $red
			& ^[0]__item-day-title,
			& ^[0]__item-day-number
				color #fff
	&__item-day-title,
	&__item-day-number
		color $default
	&__item-day-title
		margin-bottom 2px
		font-size 8px
		font-weight 400
		line-height 10px
		text-transform uppercase
	&__item-day-number
		font-size 14px
		font-weight 600
		line-height 16px

