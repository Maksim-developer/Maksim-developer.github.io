.login
	display flex
	justify-content center
	align-items center
	width 100%
	padding 48px 24px
	height 100vh
	background #fff
	&__container
		width 100%
		max-width 448px
		/ ^[0]--message &
			max-width 610px
	&__overlogo
		width 59px
		margin-bottom 35px
	&__logo
		max-width 100%
	&__tabs
		width 100%
		position relative
	&__tabs-item
		display none
		&--active
			display block
	&__tabs-content
		display flex
		flex-direction column
		align-items center
		width 100%
	&__tabs-title
		position relative
		text-align center
		color $default
		font-weight 400
		font-size 30px
		line-height 34px
		/ ^[0]--success-changed &
			padding-left 40px
			&:before
				@extend .psElem
				top 4px
				left 0
				width 26px
				height 26px
				background url('data:image/png;base64,') no-repeat center
				z-index 1
	&__tabs-text
		text-align center
		color #b3b3b3
		font-weight 300
		font-size 16px
		line-height 18px
		&:not(:first-child)
			margin-top 24px
	&__tabs-btn,
	&__tabs-back-btn
		display block
		padding 0
		color $default
		font-size 14px
		line-height 17px
		font-weight 300
		background none
		border none
		border-bottom 1px solid #000
		border-radius 0
		transition border $duration
		&:hover
			border-bottom-color transparent
		&:not(:first-child)
			margin-top 20px
	&__form
		width 100%
		&:not(:first-child)
			margin-top 26px
	&__form-field
		position relative
		width 100%
		&:before
			@extend .psElem
			pointer-events none
			background-repeat no-repeat
			background-position center
			transition background $duration
			z-index 1
		&--vin
			&:before
				left 28px
				bottom 18px
				width 17px
				height 19px
				background-image url('data:image/png;base64,')
			&.error
				&:before
					background-image url('data:image/png;base64,')
		&--pass
			&:before
				left 28px
				bottom 18px
				width 17px
				height 19px
				background-image url('data:image/png;base64,')
			&.error
				&:before
					background-image url('data:image/png;base64,')
		&--email
			&:before
				left 28px
				bottom 19px
				width 19px
				height 17px
				background-image url('data:image/png;base64,')
			&.error
				&:before
					background-image url('data:image/png;base64,')
	&__form-field + &__form-field
		margin-top 20px
	&__form-field-label
		display block
		color $default
		margin-bottom 3px
		padding-left 19px
		sup
			top -3px
			color $red
	&__form-field-input
		display block
		width 100%
		height 55px
		padding 0 40px 0 59px
		color $default
		font-family 'Roboto', sans-serif
		font-size 14px
		font-weight 300
		line-height 20px
		border-radius 0
		background #fff
		border 1px solid #d8d8d8
		border-radius 28px
		transition border $duration
		&:hover, &:focus
			border-color #959595
		/.error &
			border-color $red
		+placeholder()
			color #b3b3b3
			transition color $duration
			/.error &
				color $red
	&__form-field-btn
		display inline-block
		position absolute
		top 4px
		right 23px
		color #257ed9
		font-size 12px
		font-weight 300
		line-height 14px
		border-bottom 1px solid #257ed9
		transition border $duration
		z-index 1
		&:hover
			border-bottom-color transparent
	&__form-bottom
		display flex
		flex-direction column
		align-items center
		margin-top 46px
	&__form-submit
		display flex
		justify-content center
		align-items center
		width 100%
		height 55px
		color #fff
		background $red
		border none
		border-radius 28px
		box-shadow 0 0 15px rgba(176, 10, 10, 0)
		transition background $duration, box-shadow $duration
		&:hover
			background #e10000
			box-shadow 0 0 15px rgba(176, 10, 10, 0.45)
