.period
	max-width 354px
	@media $tPortraitMax
		max-width 345px
	@media $mLandscapeMax
		display none
	&__items
		display flex
		justify-content space-between
		margin-bottom 11px
		@media $tPortraitMax
			padding 0 24px
	&__item-btn
		display block
		padding 0
		font-size 12px
		line-height 14px
		font-weight 700
		text-transform uppercase
		color #d8d6d2
		background none
		border none
		border-radius 0
		user-select none
		cursor pointer
		transition color $duration, transform .2s
		@media $tPortraitMax
			font-size 11px
			line-height 13px
		&:not(.period__item-btn--active):not(:active):hover
			color #bfbdb8
		&:active,
		&--active
			color $default
		&:active
			transform scale(.97)
	&__datepicker
		display flex
		align-items center
		position relative
	&__datepicker-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		flex-shrink 0
		width 23px
		height 23px
		padding 0
		background none
		border none
		border-radius 12px
		transition background $duration, transform .2s
		user-select none
		cursor pointer
		z-index 1
		&:active
			transform scale(.97)
		&:hover
			background-color #f9f8f7
			&:before
				opacity 1
		&:before
			content ''
			display block
			width 5px
			height 9px
			background url('data:image/png;base64,') no-repeat center
			opacity .3
			transition opacity $duration
		&--prev
			margin-right 2px
			padding-right 2px
			&:before
				transform scaleX(-1)
		&--next
			margin-left 6px
			padding-left 2px
	&__datepicker-items
		display flex
		justify-content space-between
		position relative
		&:before
			@extend .psElem
			top 13px
			left 50%
			width 7px
			height 1px
			background-color #d9d9d9
			transform translateX(-50%)
			z-index 1
	&__datepicker-item
		position relative
		width calc(50% - 9px)
		transition transform .2s
		&:active
			transform scale(.96)
		&:before
			@extend .psElem
			top 9px
			left 10px
			width 13px
			height 11px
			background url('data:image/png;base64,') no-repeat center
			pointer-events none
			z-index 1
	&__datepicker-input
		display block
		width 100%
		height 30px
		padding 6px 9px 7px 31px
		color $default
		font-size 12px
		font-weight 400
		line-height 12px
		background white
		border 1px solid #eeedec
		border-radius 6px
		cursor pointer
		+placeholder()
			color #d8d6d2

