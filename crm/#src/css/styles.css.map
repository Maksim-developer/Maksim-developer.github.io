.history-orders
	padding-bottom 93px
	/ .bottom-hide &
		padding-bottom 0
	&__group
		&--spare
			& ^[0]__group-head
				background-color #fffcf7
				border-top 1px solid #f9f5ef
				&--active
					border-bottom-color #f9f5ef
			& ^[0]__group-toggle
				border-color #f9f5ef
		&--work
			& ^[0]__group-head
				background-color #f4f6fe
				border-top 1px solid #e9edfc
				&--active
					border-bottom-color #e9edfc
			& ^[0]__group-toggle
				border-color #e9edfc
		&--chat
			& ^[0]__group-head
				background-color #ecfaff
				border-top 1px solid #d4f2fd
				&--active
					border-bottom-color #d4f2fd
			& ^[0]__group-toggle
				border-color #d4f2fd
	&__group-head
		display flex
		align-items center
		width 100%
		padding 16px 26px 17px
		border-bottom 1px solid transparent
		transition border $duration
	&__group-toggle
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 27px
		height 27px
		margin-right 41px
		padding 0
		background-color white
		border-width 1px
		border-style solid
		border-radius 50%
		cursor pointer
		user-select none
		transition transform $duration
		&:before,
		&:after
			@extend .psElem
			left 9px
			top 12px
			width 7px
			height 1px
			background-color $default
		&:after
			transform rotate(90deg)
			transition transform $duration
		&:active
			transform scale(.97)
		&--active
			&:after
				transform rotate(0deg)
	&__group-title
		color $default
		font-size 16px
		font-weight 600
		line-height 27px
	&__group-content
		display none
	&__auth
		padding 22px 26px 21px
	&__item-head
		display flex
		align-items center
		width 100%
		padding 17px 26px 16px
		border-top 1px solid $border
		border-bottom 1px solid transparent
		transition border $duration
		&--active
			border-bottom-color $border
	&__item-toggle
		display flex
		flex-direction column
		justify-content center
		align-items center
		position relative
		width 27px
		height 27px
		margin-right 40px
		padding 0
		background-color white
		border 1px solid #f9f5ef
		border-radius 50%
		cursor pointer
		user-select none
		transition transform $duration
		&:before,
		&:after
			@extend .psElem
			left 9px
			top 12px
			width 7px
			height 1px
			background-color $default
		&:after
			transform rotate(90deg)
			transition transform $duration
		&:active
			transform scale(.97)
		&--active
			&:after
				transform rotate(0deg)
	&__item-chars
		display flex
	&__item-char
		font-size 14px
		line-height 17px
		font-weight 600
		color $default
		&:not(:last-child)
			margin-right 78px
		a
			display inline-block
			vertical-align baseline
			color $blue
			border-bottom 1px solid $blue
			transition border $duration
			&:hover
				border-bottom-color transparent
	&__item-content
		display none
		.table-wrap	
			opacity 0
			transition opacity .25s ease-in
		&--visible
			.table-wrap
				opacity 1
	&__item-text
		max-width 998px
		padding-top 17px
		margin-bottom 24px
		font-size 14px
		line-height 16px
		&:last-child
			margin-bottom 0
	&__item-attachment
		margin-bottom 8px
		&:last-child
			margin-bottom 0
	&__item-attachment-img
		display flex
		align-items center
		padding 0
		font-size 12px
		font-weight 500
		line-height 14px
		background none
		border none
		user-select none
		cursor pointer
		&:before
			content ''
			display block
			flex-shrink 0
			width 21px
			height 19px
			margin-right 13px
			background url('data:image/png;base64,') no-repeat center
		&:hover 
			& ^[0]__item-attachment-img-title
				span
					border-bottom-color transparent
	&__item-attachment-img-title
		position relative
		top -3px
		flex-shrink 0
		color $blue
		margin-right 12px
		span
			position relative
			top 2px
			border-bottom 1px solid $blue
			transition border $duration
	&__item-attachment-img-size
		flex-shrink 0
		color $default

	.table
		&__head .table__cell
			font-weight 600
