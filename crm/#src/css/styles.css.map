.chat-template-settings
	width 100%
	&__head
		display flex
		align-items center
		width 100%
		padding 16px 30px
		border-bottom 1px solid $border
	&__axis-y
		max-height 504px
	&__item
		display flex
		align-items center
		width 100%
		padding 16px 30px
		border-bottom 1px solid $border
		transition background $duration
		&:hover
			background-color #fff7f7
		&:last-child
			border-bottom none
			border-bottom-right-radius 8px
			border-bottom-left-radius 8px
	&__item-cell
		&--content
			width 71%
			padding-right 48px
		&--social
			width 116px
		&--actions
			width 90px
	&__item-head
		display flex
		align-items baseline
		margin-bottom 5px
		width 100%
	&__item-title,
	&__item-text
		display block
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__item-title
		flex-shrink 0
		max-width calc(100% - 144px)
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		margin-right 26px
		&:before
			content ''
			display inline-block
			vertical-align baseline
			width 15px
			height 11px
			margin-right 9px
			background url('data:image/png;base64,') no-repeat center
	&__item-date
		flex-shrink 0
		color #c2c0bd
		font-size 12px
		font-weight 400
		line-height 14px
	&__item-text
		color $default
		font-size 14px
		font-weight 300
		line-height 16px
	&__item-socials
		display flex
		align-items center
	&__item-social
		width 16px
		height 16px
		border-radius 8px
		margin-right 10px
		background-repeat no-repeat
		background-position center
		&:last-child
			margin-right 0
		&--telegram
			background-image url('data:image/png;base64,')
		&--whatsapp
			background-image url('data:image/png;base64,')
		&--email
			background-image url('data:image/png;base64,')
	
	.actions
		justify-content flex-end
