.mailing-check
	width 100%
	flex-grow 1
	&__axis-y
		width 100%
		height 100%
	&__container
		display flex
		align-items flex-start
		width 100%
		max-width 1817px
		height 100%
	&__col
		min-height 100%
		margin 0 30px 0 0
		padding-right 30px
		padding-bottom 32px
		border-right 1px solid #eeedec
		&:last-child
			margin 0
			padding-right 0
			border none
		&--letter
			width calc(50% - 82px)
		&--recipients
			width calc(50% + 32px)
	&__col-title
		color $default
		font-size 16px
		font-weight 500
		line-height 24px
		margin 0 0 24px
		strong
			font-weight 700
	&__recipients
		position relative
		margin-bottom 32px
		&:last-child
			margin-bottom 0
	&__recipients
		padding 22px 24px 25px
		border 1px solid $border
		border-radius 6px
	&__recipients-edit
		position absolute
		top 17px
		right 17px
		width 32px
		height 32px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
		border-radius 0
		transition background $duration, transform .2s
		z-index 1
		&:hover
			background-image url('data:image/png;base64,')
		&:active
			transform scale(.9)
	&__recipients-list-item
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		margin-bottom 20px
		&:last-child
			margin-bottom 0
		span
			font-weight 500
	&__btns
		display flex
		justify-content flex-end
	&__btn
		margin-left 26px
		&:first-child
			margin-left 0
