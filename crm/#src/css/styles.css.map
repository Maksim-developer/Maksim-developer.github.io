.complex-tree-wrap
	position relative
	flex-shrink 0
	width 280px
	height 100%
	padding-top 10px
	border-right 1px solid $border
	transition width $duration
	z-index 3
	/.tabs &
		padding-top 0
	&__axis-y
		width 100%
		max-height 294px
	&__content
		width 280px
		padding-bottom 160px
		transition opacity .3s .15s ease-in, visibility .3s .15s ease-in
	&__toggle-button
		display flex
		align-items center
		position absolute
		top 7px
		right -32px
		width 32px
		height 32px
		padding 0
		background none
		border-radius 0
		border none
		z-index 1
		/.tabs &
			top -6px
		span
			display flex
			flex-direction column
			justify-content center
			align-items center
			position relative
			width 16px
			height 20px
			background-color #d9d9d9
			border-radius 0px 3px 3px 0px
			pointer-events none
			&:before
				content ''
				display block
				width 5px
				height 8px
				background url('data:image/png;base64,') no-repeat center
				transform scaleX(-1)
				transition transform $duration
	&--hide
		width 0
		& ^[0]__toggle-button
			span
				&:before
					transform scaleX(1)
		& ^[0]__content
			opacity 0
			visibility hidden
			transition none
	&--popup
		width 100%
		padding 0
		border-right none
		.complex-tree
			&__head
				&:hover
					background none
			&__items--subitems
				&__item-title
					padding-left 54px
			&__title,
			&__item-title
				color #c3c1bd
			&__title
				font-size 14px
				font-weight 500
			&__item-title
				padding-left 34px
				&:hover,
				&--selected
					color $default
				&:before
					left 22px !important
	& + .table
		.table__head .table__cell
			/.tabs &
				min-height 50px
				padding-top 12px
		.table__edit
			/.tabs &
				padding-top 12px
		.table__cell,
		.table__cell:first-child,
		.table__edit-checkbox
			/.tabs &
				padding-left 26px

.complex-tree
	width 100%
	&__head
		display flex
		align-items center
		width 100%
		min-height 40px
		padding 2px 8px 2px 28px
		transition background $duration
		&:hover
			background-color #fff7f7
	&__title
		display block
		flex-grow 1
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__create-button
		display flex
		width 36px
		height 36px
		margin-left 12px
		padding 0
		background none
		border none
		border-radius 18px
		transition background $duration, transform .2s
		user-select none
		cursor pointer
		&:hover
			background-color #fff
			&:before
				opacity 1
		&:active
			transform scale(.95)
		&:before
			content ''
			display block
			width 12px
			height 12px
			margin auto
			background url('data:image/png;base64,') no-repeat center
			opacity .2
			transition opacity $duration
	&__items
		width 100%
		&--subitems
			display none
			& ^[0]__item-title
				padding-left 46px
	&__item
		display flex
		flex-wrap wrap
		align-items flex-start
		position relative
		width 100%
		min-height 40px
		&--have-subitems
			& > ^[0]__item-title
				&:before
					@extend .psElem
					top 50%
					left 12px
					width 4px
					height 7px
					background url('data:image/png;base64,') no-repeat center
					transform translateY(-50%) rotate(0deg)
					transition transform $duration
					z-index 1
		&--open
			& > ^[0]__item-title
				&:before
					transform translateY(-50%) rotate(90deg)
	&__item-title
		display block
		position relative
		flex-grow 1
		padding 13px 48px 12px 28px
		text-align left
		color $default
		font-size 14px
		line-height 16px
		font-weight 500
		background none
		border none
		transition background $duration, color $duration
		cursor pointer
		&:hover,
		&--selected
			background-color #fff7f7
	&__item-action-button
		display flex
		position absolute
		top 2px
		right 8px
		width 36px
		height 36px
		padding 0
		background none
		border none
		border-radius 18px
		transition background $duration, transform .2s
		cursor pointer
		user-select none
		z-index 1
		&:hover,
		&.active
			background-color #fff
			&:before
				opacity 1
			& ~ ^[0]__item-title
				background-color #fff7f7
		&:active
			transform scale(.95)
		&:before
			content ''
			display block
			width 4px
			height 16px
			margin auto
			background url('data:image/png;base64,') no-repeat center
			opacity .2
			transition opacity $duration
	&__item-dropdown
		width 280px
		left calc(100% - 44px)
		top 44px
	&--select
		padding-top 10px
		padding-bottom 10px
		&	^[0]__head
			&:hover
				background none
		&	^[0]__items--subitems
			&	^[0]__item-title
				padding-left 54px
		&	^[0]__title,
		&	^[0]__item-title
			color #c3c1bd
		&	^[0]__title
			font-size 14px
			font-weight 500
		&	^[0]__item-title
			padding-left 34px
			&:hover,
			&--selected
				color $default
			&:before
				left 22px !important

	