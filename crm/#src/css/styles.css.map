.comments
	width 100%
	&__items,
	&__item
		width 100%
	&__item
		display flex
		width 100%
		margin-bottom 30px
		&:last-child
			margin-bottom 0
	&__item-avatar
		width 37px
		height 37px
		margin-right 15px
		border-radius 50%
		background-color #d8d8d8
	&__item-avatar-img
		width 100%
		height 100%
		object-fit cover
	&__item-container
		display flex
		flex-direction column
		width calc(100% - 52px)
	&__item-content
		align-self flex-start
		margin-bottom 7px
		padding 13px 17px
		background-color #f3f3f3
		border-radius 26px
	&__item-details
		display flex
		align-items baseline
		margin-bottom 4px
	&__item-author,
	&__item-date
		flex-shrink 0
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__item-author
		display block
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		margin-right 9px
	&__item-date
		display block
		color #b1b0ae
		font-size 10px
		line-height 12px
	&__item-text
		color $default
		font-size 14px
		line-height 17px
		p
			margin-bottom 16px
		a[href]
			color $blue
			text-decoration underline
			&:hover
				text-decoration none
		> *
			&:last-child
				margin-bottom 0
	&__item-actions
		display flex
		padding-left 17px
	&__item-action
		position relative
		margin-right 12px
		&:last-child
			margin-right 0
	&__item-action-btn
		display block
		padding 0
		font-size 10px
		color #b1b0ae
		line-height 12px
		background none
		border none
		transition color $duration
		&:hover
			color #696867
	// &__item-action-dropdown
	&__item-wysiwyg
		margin-bottom 31px
		// .custom-wysiwyg
	&__item-bottom
		display flex
		.btn
			margin-right 13px
			&:last-child
				margin-right 0
