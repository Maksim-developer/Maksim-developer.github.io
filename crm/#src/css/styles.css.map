.auto
	max-width 942px
	&__add-button
		display block
		position relative
		margin-bottom 16px
		padding 0 0 0 20px
		color $red
		font-size 12px
		font-weight 500
		line-height 14px
		background none
		border none
		transition color $duration
		&:focus
			outline none
		&:hover
			color #e10000
			&:before
				background-color #e10000
		&:before,
		&:after
			@extend .psElem
		&:before
			top 0
			left 0
			width 14px
			height 14px
			background-color $red
			border-radius 4px
			transition background $duration
			z-index 1
		&:after
			top 3px
			left 3px
			width 8px
			height 8px
			background url('data:image/png;base64,') no-repeat center
			z-index 2
	&__item
		padding 0 30px
		background-color white
		border 1px solid whitesmoke
		border-radius 6px
		&:not(:last-child)
			margin-bottom 15px
		&--active
			& ^[0]__item-toggle
				background-image url('data:image/png;base64,')
				background-color $red
				transform rotate(-180deg)
	&__item-head
		display flex
		align-items flex-start
		width 100%
		padding 20px 0
	&__item-title
		display block
		padding 6px 0
		color #474747
		font-size 18px
		font-weight 400
		line-height 24px
		margin-right 24px
		background none
		border none
		&:focus
			outline none
	&__item-right
		display flex
		margin-top 8px
		margin-left auto
		flex-shrink 0
		button
			& + button
				margin-left 4px
	&__item-delete,
	&__item-toggle
		display block
		width 20px
		height 20px
		padding 0
		background-repeat no-repeat
		background-position center
		background-color whitesmoke
		border-radius 10px
		border none
		transition background $duration, transform $duration
		&:hover
			background-color $red
		&:focus
			outline none
	&__item-delete
		background-image url('data:image/png;base64,')
		&:hover
			background-image url('data:image/png;base64,')
	&__item-toggle
		background-image url('data:image/png;base64,')
		&:hover
			background-image url('data:image/png;base64,')
	&__item-content
		display none
		padding-bottom 42px
