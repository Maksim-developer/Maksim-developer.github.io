.pcr-app
	.pcr-interaction 
		.pcr-result
			flex-basis 100%
		.pcr-save,
		.pcr-clear
			width calc(50% - .4em)
	input:focus, 
	input.pcr-active, 
	button:focus, 
	button.pcr-active
		box-shadow none

.pickr
	.pcr-button
		width 138px
		height 27px
		padding 0
		font-family $baseFontFamily
		border 1px solid #eeedec
		background none
		border-radius 6px
		overflow hidden
		&:before,
		&:after
			box-sizing border-box
		&:before
			content 'Выбрать цвет'
			display block
			top 0
			right 0
			left auto
			width 103px
			height 100%
			padding 7px 11px
			text-align center
			color #131312
			font-size 11px
			font-weight 400
			line-height 11px
			background white
			border-left 1px solid #eeedec
			border-radius 0px 6px 6px 0px
			background-size 100%
		&:after
			width 33px
			height 100%
			border-radius 0px
	input:focus, 
	input.pcr-active, 
	button:focus, 
	button.pcr-active
		box-shadow none
	
	.pcr-button.clear
		background-size 100%;
		&:focus
			box-shadow none
		&:before
			opacity 1
