.cars
	width 100%
	border-top 1px solid $border
	overflow hidden
	&__search
		display flex
		align-items center
		width 100%
		padding 30px
	&__search-title
		flex-shrink 0
		margin-right 26px
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
	&__axis-y
		height 100%
	&__group
		border-bottom 1px solid $border
	&__group-head
		position relative
		padding 17px 24px 19px
		border-bottom 1px solid $border
	&__group-title
		color $default
		font-size 14px
		line-height 17px
		font-weight 600
	&__group-content
		padding 32px 26px
	&__create
		position relative
	&__create-btn
		display flex
		justify-content center
		align-items center
		position relative
		width 42px
		height 42px
		padding 0
		background #fff
		border 1px solid $border
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		user-select none
		&:hover,
		&.active
			background-color $red
			border-color $red
			&:before
				background-image url('data:image/png;base64,')
		&:active
			transform scale(.97)
		&:before
			content ''
			display block
			width 12px
			height 12px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAMAAABhq6zVAAAAM1BMVEUAAAAyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjIyMjK5CPmRAAAAEHRSTlMA6wRCSfLRtS7idTUlHBUJQAiCmQAAAEhJREFUCNdljUkOgDAMA52t7OD/v5aoorRS5xArUWyjsmwXGkp6X4SGH+HxnVUfoaekVxIychZwALeZeXBPWVvAOUXPpShR/1+zYgJWuDBrBQAAAABJRU5ErkJggg==') no-repeat center
			transition background $duration
	&__create-dropdown
		width 300px
		z-index 2
	&__tile
		display flex
		flex-wrap wrap
		margin-right -26px
		margin-bottom -15px
	&__tile-cell
		margin-right 26px
		margin-bottom 15px
		&--full
			display flex
			flex-wrap wrap
			width 100%
		&--create
			display flex
			align-items center
	&__edit
		display flex
		align-items center
		position absolute
		top 0
		left 0
		width 100%
		height 100%
		padding 20px 26px
		background #fff
		z-index 1
		overflow hidden
	&__edit-count
		margin-right 36px
		color $default
		font-size 14px
		line-height 16px
		font-weight 700
	&__edit-actions
		display flex
	&__edit-action
		line-height 16px
		&:not(:last-child)
			margin-right 55px
	&__edit-action-btn
		display block
		color $default
		font-size 14px
		line-height 16px
		font-weight 700
		transition color $duration, transform .2s
		&:hover
			color #4a4a47
		&:active
			transform scale(.97)
	&--popup
		height calc(100vh - 260px)
		border-top none
		& ^[0]__search
			border-bottom 1px solid $border
			& + ^[0]__axis-y
				height calc(100% - 109px)
		& ^[0]__group-head,
		& ^[0]__group-content,
		& ^[0]__edit
			padding-left 30px
			padding-right 30px
		& ^[0]__tile
			margin-right -34px
		& ^[0]__tile-cell
			margin-right 34px
		& ^[0]__group
			&:last-child
				border-bottom none
