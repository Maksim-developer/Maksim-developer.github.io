.toast
	display flex
	justify-content space-between
	align-items center
	position relative
	width 100%
	max-width 1122px
	padding 11px 20px 10px
	background-color #f2fff2
	border 1px solid #2caf2c
	border-radius 6px
	&:before
		content ''
		display block
		flex-shrink 0
		margin-right 11px
		background-repeat no-repeat
		background-position center
		background-size contain
	&--warning
		background-color #fffaf6
		border 1px solid #ff7800
		&:before
			width 15px
			height 14px
			background-image url('data:image/png;base64,')
		& ^[0]__text
			color #ff7800
	&__text
		flex-grow 1
		font-weight 500
		font-size 12px
		line-height 14px
	&__actions
		display flex
		justify-content flex-end
		margin-left 24px
		flex-shrink 0
	&__action
		margin-left 24px
	&__action-btn
		display block
		color $blue
		font-weight 600
		font-size 12px
		line-height 14px
		text-transform uppercase
		user-select none
		border-bottom 1px solid transparent
		transition border $duration, transform .2s
		cursor pointer
		&:hover
			border-bottom-color $blue
		&:active
			transform scale(.97)
