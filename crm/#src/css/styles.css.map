.page-quantity
	display flex
	align-items center
	&__text
		color grey
		font-size 12px
		line-height 15px
		font-weight 300
		margin-right 12px
	&__list
		display flex
	&__list-item
		margin-right -1px
	&__list-button
		display block
		padding 6px 10px 7px
		color $default
		font-size 12px
		font-weight 300
		line-height 12px
		white-space nowrap
		background-color #fff
		border 1px solid #d9d9d9
		transition background $duration, border $duration
		cursor pointer
		user-select none
		&:focus
			outline none
		&:hover,
		&--active
			background-color #fff4f4
			border-color #e3cbcb
