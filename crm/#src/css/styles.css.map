.product-card
	display flex
	flex-direction column
	position absolute
	top -39px
	right -615px
	width 615px
	height 100%
	height calc(100vh - 277px)
	background-color white
	border 1px solid $border
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	transition right $duration
	z-index 100
	/ .product-card-visible &
		right 0
	&__toggle-btn
		display flex
		justify-content flex-end
		align-items center
		position absolute
		top 10px
		left -32px
		width 32px
		height 32px
		padding 0
		background none
		border-radius 0
		border none
		cursor pointer
		z-index 1
		span
			display flex
			flex-direction column
			justify-content center
			align-items center
			position relative
			width 16px
			height 20px
			background-color #d9d9d9
			border-radius 3px 0px 0px 3px
			pointer-events none
			&:before
				content ''
				display block
				width 5px
				height 8px
				background url('data:image/png;base64,') no-repeat center
				transition transform $duration
				transform scaleX(-1)
				/ .product-card-visible &
					transform scaleX(1)
	&__axis-y
		height 100%
	&__content
		display flex
		flex-direction column
		flex-grow 1
		padding 18px 0px 30px 24px
		border-bottom 1px solid #F4F4F1
		overflow hidden
		.tabs
			display flex
			flex-direction column
			&__controls
				& + .tabs__items
					margin-top 24px
			&__items
				flex-grow 1
			&__item
				height 100%
		.table-wrap
			border-top none
			width calc(100% - 12px)
			&__axis-x.os-host-overflow-x
				padding-bottom 14px
		.table
			min-width none !important
			&__head .table__cell
				min-height 38px
			&__body .table__row:not(.table__row--no-hover)
				&:nth-child(odd)
					background-color #fcfbfa
			&__cell
				padding-top 11px
				padding-bottom 9px
				padding-right 44px
	&__bottom
		padding 30px 24px
	&__last-edit
		padding 20px 24px
		color #c2c0bd
		font-size 12px
		line-height 14px
		font-weight 400
	&__title
		padding 11px 24px
		color $default
		font-size 16px
		font-weight 700
		line-height 24px
		background-color #fafafa
	&__group
		padding 25px 0 30px
		border-bottom 1px solid #F4F4F1
		&:first-child
			padding-top 0
		&:last-child
			padding-bottom 0
			border-bottom none
	&__group-head
		display flex
		align-items flex-end
		justify-content space-between
		width 100%
		margin-bottom 16px
		padding-right 24px
	&__group-title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		span
			margin-left 14px
			font-weight 400
	&__max-price
		font-size 14px
		line-height 24px
		color #cac8c6
		font-weight 500
		text-align right
		strong
			color $default
			font-weight 600
	&__info
		display flex
		align-items flex-start
		width 100%
	&__preview
		display block
		position relative
		flex-shrink 0
		width 157px
		height 107px
		margin-right 32px
		background-repeat no-repeat
		background-position center
		background-size contain
		border-radius 6px
		cursor pointer
		overflow hidden
		&:hover
			& ^[0]__preview-content
				opacity 1
				visibility visible
	&__preview-content
		display flex
		flex-direction column
		position absolute
		top 0
		right 0
		bottom 0
		left 0
		padding 7px
		background-color rgba(#000, .4)
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1
	&__preview-name,
	&__preview-size
		color white
		font-size 12px
		line-height 14px
		font-weight 500
	&__preview-bottom
		display flex
		justify-content space-between
		align-items center
		width 100%
		margin-top auto
	&__preview-size
		display block
		max-width calc(100% - 32px)
		line-height 19px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
		&:before
			content ''
			display inline-block
			vertical-align middle
			flex-shrink 0
			width 21px
			height 19px
			margin-right 7px
			background url('data:image/png;base64,') no-repeat center
	&__props
		display table
		margin-bottom -14px
		&--numbers
			margin-bottom -21px
			& ^[0]__prop-title,
			& ^[0]__prop-data
				padding-bottom 21px
	&__prop
		display table-row
		width 100%
	&__prop-title,
	&__prop-data
		display table-cell
		padding-bottom 14px
		font-size 14px
		line-height 16px
	&__prop-title
		font-weight 500
		padding-right 14px
	&__prop-data
		font-weight 400
	&__buttons
		display flex
		justify-content flex-end
		width 100%
		.btn + .btn
			margin-left 4px
	&--procenka
		top 107px
		height calc(100vh - 167px)
