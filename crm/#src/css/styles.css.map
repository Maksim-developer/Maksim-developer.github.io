.header
	display flex
	align-items center
	position fixed
	top 0
	left 0
	width 100%
	height 60px
	padding-right 36px
	background-color #fff
	border-bottom 1px solid #F5F4F1
	z-index 101
	@media $desktopMax
		padding-right 12px
	@media $mLandscapeMax
		height 44px
		padding-right 10px
		background-color $default
		border none
	&__left
		display none
		@media $mLandscapeMax
			display flex
	&__burger,
	&__logo
		width 44px
		height 44px
	&__burger
		display flex
		padding 0
		background $default
		border none
		border-radius 0
		&.active
			span
				background-color transparent
				&:before,
				&:after
					transition top .25s, bottom .25s, transform .25s .25s
				&:before
					top 0
					transform rotate(45deg)
				&:after
					bottom 0
					transform rotate(-45deg)
		span
			display block
			position relative
			margin auto
			width 16px
			height 2px
			background-color #E1DFDB
			&:before,
			&:after
				@extend .psElem
				left 0
				width 16px
				height 2px
				background-color #E1DFDB
				transition top .25s .25s, bottom .25s .25s, transform .25s
			&:before
				top -5px
			&:after
				bottom -5px
	&__logo
		display block
	&__logo-img
		width 100%
		height 100%
	&__right
		display flex
		align-items center
		flex-shrink 0
		margin-left auto
	&__users
		display flex
		align-items center
		@media $mLandscapeMax
			display none
	&__users-status
		display flex
		align-items center
		position relative
		flex-shrink 0
		height 31px
		margin-right 6px
		padding 11px 12px
		color $red
		font-size 12px
		font-weight 500
		line-height 14px
		background-color #fff7f7
		border-radius 15px
		&:before
			content ''
			display block
			flex-shrink 0
			width 10px
			height 10px
			margin-right 4px
			border-radius 5px
			background-color $red
		&--online
			color #2caf2c
			background-color #f2fff2
			&:before
				background-color #2caf2c
	&__users-items
		display flex
	&__users-item
		width 32px
		height 32px
		position relative
		border 1px solid white
		background-repeat no-repeat
		background-position center
		background-size cover
		background-color #e2e2e2
		border-radius 15px
		&:not(:first-child)
			margin-left -10px
		for num in (1..20)
			&:nth-child({num})
				z-index 21 - num
	&__notif
		position relative
		margin-left 42px
		@media $mLandscapeMax
			margin-left 0
	&__notif-toggle
		display flex
		justify-content center
		align-items center
		position relative
		width 32px
		height 32px
		padding 0
		background none
		border 0
		cursor pointer
		&:before
			content ''
			display block
			width 18px
			height 22px
			background url('data:image/png;base64,') no-repeat center
		span
			position absolute
			top 6px
			right 3px
			text-align center
			min-width 13px
			height 13px
			color #fff
			font-size 10px
			line-height 14px
			font-weight 300
			border-radius 7px
			background $red
			opacity 0
			pointer-events none
			transition opacity $duration
			z-index 1
		&--not-empty
			&:before
				background-image url('data:image/png;base64,')
				@media $mLandscapeMax
					background-image url('data:image/png;base64,')
			span
				opacity 1
	&__profile
		position relative
		margin-left 32px
		padding-right 31px
		cursor pointer
		@media $mLandscapeMax
			display none
		&:after
			@extend .psElem
			top 13px
			right 4px
			border-style solid
			border-width 5px 3.5px 0 3.5px
			border-color #000000 transparent transparent transparent
			z-index 1
	&__profile-avatar
		width 30px
		height 30px
		background-repeat no-repeat
		background-position center
	&__search
		display none
		margin-left 12px
		@media $mLandscapeMax
			display block
	&__search-toggle
		display block
		width 32px
		height 32px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
		border-radius 0
	&__search-form
		display none
		position absolute
		top 0
		left 0
		width 100%
		height 100%
		padding 3px
		background-color $default
		z-index 1
	&__search-form-close,
	&__search-form-submit
		display block
		width 38px
		height 38px
		padding 0
	&__search-form-close
		flex-shrink 0
		margin-right 4px
		background url('data:image/png;base64,') no-repeat center
		border none
		border-radius 0
	&__search-form-input
		flex-grow 1
		display block
		width 100%
		height 38px
		padding 0 55px 0 15px
		font-size 12px
		line-height 38px
		color $default
		background-color white
		border none
		box-shadow none
		border-radius 6px
		placeholder()
			color #d8d6d2
	&__search-form-submit
		position absolute
		top 3px
		right 3px
		background url('data:image/png;base64,') no-repeat center, $red
		border none
		border-radius 0px 6px 6px 0px
		z-index 1
	&__search-dropdown
		position fixed
		top 44px
		left 0
		width 100%
		height calc(100% - 44px)
		background-color #fff
		z-index 11
		.table
			&__cell
				&:last-child
					@media $tPortraitMax
						padding-right 14px
	&__search-axis-y
		height 100%
