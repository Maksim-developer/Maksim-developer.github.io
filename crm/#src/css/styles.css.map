.messenger-buttons
	display flex
	align-items center
	flex-shrink 0
	/ .main__top &
		margin-right auto
	&__item
		margin-right 24px
		&:last-child
			margin-right 0
	&__btn
		display flex
		position relative
		width 47px
		height 47px
		padding 0
		border 1px solid #eeedec
		background-color transparent
		background-repeat no-repeat
		background-position center
		background-size 104% 104%
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		*
			pointer-events none
		&:before,
		&:after
			content ''
			display block
		&:before
			margin auto
			background-repeat no-repeat
			background-position center
			transition background $duration, transform .2s
		&:after
			position absolute
			left 50%
			bottom -21px
			transform translateX(-50%)
			width 70px
			height 2px
			background-color red
			opacity 0
			visibility hidden
			transition opacity $duration, visibility $duration
			z-index 1
		&:hover,
		&--active
			border-color transparent
		&--active
			&:after
				opacity 1
				visibility visible
		&:active
			&:before
				transform scale(.93)
		&--phone
			&:before
				width 19px
				height 19px
				background-image url('data:image/png;base64,')
				background-size contain
		&--phone:hover,
		&--phone&--active
			border-color #eeedec
		&--whatsapp
			&:before
				width 23px
				height 23px
				background-image url('data:image/png;base64,')
		&--whatsapp:hover,
		&--whatsapp&--active
			background-color #f2fff2
			background-image linear-gradient(248deg, #8ccc4e 0%, #2caf2c 100%, #2caf2c 100%)
			&:before
				background-image url('data:image/png;base64,')
		&--telegram
			&:before
				width 19px
				height 16px
				background-image url('data:image/png;base64,')
		&--telegram:hover,
		&--telegram&--active
			background-color #f2fff2
			background-image linear-gradient(68deg, #b9ecff 0%, #f4fcff 100%, #f4fcff 100%)
			&:before
				background-image url('data:image/png;base64,')
		&--mail
			&:before
				width 20px
				height 20px
				background-image url('data:image/png;base64,')
		&--mail:hover,
		&--mail&--active
			background-color #f2fff2
			background-image linear-gradient(30deg, #f3e3cf 0%, #fffcf7 100%, #fffcf7 100%)
			&:before
				background-image url('data:image/png;base64,')
	&__btn-number
		position absolute
		top 2px
		right -7px
		min-width 17px
		height 17px
		padding 0 2px
		text-align center
		color #fff
		font-size 10px
		font-weight 600
		line-height 17px
		background-color red
		border-radius 9px
		z-index 2

	&--min
		& ^[0]__item
			margin-right 18px
			&:last-child
				margin-right 0
		& ^[0]__btn
			width 37px
			height 37px
			background-size 108% 108%
			&:after
				bottom -15px
				width 45px
			&--phone,
			&--whatsapp,
			&--telegram,
			&--mail
				&:before
					background-size contain
			&--phone
				&:before
					width 13px
					height 13px
			&--whatsapp
				&:before
					width 18px
					height 18px
			&--telegram
				&:before
					width 15px
					height 13px
			&--mail
				&:before
					width 15px
					height 15px
		& ^[0]__btn-number
			top 1px
			right -2px
			min-width 12px
			height 12px
			font-size 8px
			line-height 12px
	
	&--chat
		margin-right auto
		& ^[0]__btn
			width 32px
			height 32px
			&--whatsapp,
			&--mail
				&:before
					width 13px
					height 13px
			&--telegram
				&:before
					width 13px
					height 11px

	&--order,
	&--chat
		& ^[0]__btn
			&:after
				content none
				display none
