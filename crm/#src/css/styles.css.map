.datepicker-period
	position relative
	&:not(:last-child)
		margin-right 15px
	&:before
		@extend .psElem
		top 8px
		left 10px
		width 13px
		height 11px
		background url('data:image/png;base64,') no-repeat center
		pointer-events none
		z-index 1
	&__input
		display block
		width 174px
		height 27px
		padding 6px 9px 7px 31px
		color $default
		font-size 12px
		font-weight 300
		line-height 12px
		background white
		border 1px solid #d9d9d9
		cursor pointer
		+placeholder()
			color $default

	&+.checkbox-oval
		margin-top 6px
