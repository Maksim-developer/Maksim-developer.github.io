.orders-info
	&__items
		display flex
	&__item
		width 278px
		border-right 1px solid #f5f4f1
	&__item-top
		display flex
		align-items center
		height 44px
		padding 18px
		border-bottom 1px solid #f5f4f1
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__item-provider
		flex-shrink 0
		width 10px
		height 10px
		margin-right 6px
	&__item-provider-img
		width 100%
		height 100%
		object-fit cover
	&__item-title
		color $default
		font-size 14px
		font-weight 600
		line-height 14px
	// &__item-content
	&__item-row
		display flex
		align-items center
		width 100%
		padding 14px 19px
		cursor pointer
		&:hover
			background-color #fff7f7
	&__item-cell
		color $default
		font-size 12px
		line-height 14px
		&--title
			width 132px
			flex-shrink 0
		&--value
			flex-grow 1
			text-align right
		&--success
			color $green
		&--warning
			color #f95050
