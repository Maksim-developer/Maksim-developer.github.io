.download-button
	display flex
	padding 6px 10px 7px
	color $default
	font-size 12px
	font-weight 300
	line-height 12px
	white-space nowrap
	background-color #fff
	border 1px solid #d9d9d9
	transition background $duration, border $duration
	cursor pointer
	user-select none
	&:focus
		outline none
	&:hover,
	&.active
		background-color #fff4f4
		border-color #e3cbcb
	&:before
		content ''
		display block
		width 11px
		height 11px
		margin-right 8px
		background url('data:image/png;base64,') no-repeat center
