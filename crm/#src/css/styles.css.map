.pagination
	display flex
	justify-content center
	align-items center
	&__item
		margin 0 9px
	&__href
		display block
		text-align center
		position relative
		width 24px
		height 24px
		font-size 12px
		font-weight 300
		line-height 24px
		color grey
		border-radius 50%
		transition background $duration, color $duration, opacity $duration
		user-select none
		&:not(.pagination__href--active):hover
			color $red
		&--active
			color black
			background-color #f6f6f6
			pointer-events none
		&--prev,
		&--next
			width auto
			border-radius 0
		&--prev
			margin-left 0
			margin-right 10px
		&--next
			margin-left 10px
			margin-right 0
		&--disabled
			pointer-events none
			cursor default
			opacity .5
