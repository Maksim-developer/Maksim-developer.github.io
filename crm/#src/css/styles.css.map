.os-theme-dark>.os-scrollbar>.os-scrollbar-track>.os-scrollbar-handle
	background-color #eae8e4
	border-radius 3px
	cursor pointer

.os-theme-dark>.os-scrollbar,
.os-theme-light>.os-scrollbar
	padding 0

.os-theme-dark>.os-scrollbar-horizontal,
.os-theme-light>.os-scrollbar-horizontal
	height 12px

.os-theme-dark>.os-scrollbar-vertical, 
.os-theme-light>.os-scrollbar-vertical
	width 12px

.os-theme-dark>.os-scrollbar>.os-scrollbar-track,
.os-theme-light>.os-scrollbar>.os-scrollbar-track
	background #fcfbf9

.os-theme-dark.os-host-transition>.os-scrollbar.os-scrollbar-vertical>.os-scrollbar-track>.os-scrollbar-handle, 
.os-theme-light.os-host-transition>.os-scrollbar.os-scrollbar-vertical>.os-scrollbar-track>.os-scrollbar-handle
	width 6px
	left 3px
	overflow hidden
	&.active
		width 8px
		left 2px

.os-theme-dark.os-host-transition>.os-scrollbar.os-scrollbar-horizontal>.os-scrollbar-track>.os-scrollbar-handle, 
.os-theme-light.os-host-transition>.os-scrollbar.os-scrollbar-horizontal>.os-scrollbar-track>.os-scrollbar-handle
	height  6px
	top 3px
	overflow hidden
	&.active
		height 8px
		top 2px
