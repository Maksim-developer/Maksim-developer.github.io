.marker-status
	display inline-flex
	align-items center
	vertical-align baseline
	position relative
	height 28px
	padding 7px 8px
	text-align left
	color #2caf2c
	font-size 14px
	font-weight 400
	line-height 14px
	font-family $fontConsolas
	background #f2fff2
	border none
	border-radius 6px
	@media $desktopMax
		padding 5px 9px
		font-size 11px
		line-height 13px
	@media $tPortraitMax
		font-size 10px
	&--brown
		color #d0935d
		background-color #fef9f4
	&--red
		color $red
		background-color #f7e8e8
	&--blue
		color #5467a9
		background-color #f4f6fe
	&--gray
		color #9f9f9f
		background-color whitesmoke
	&--burgundy
		color #af2c4e
		background-color #fff2f2
	&--violet
		color #9267d3
		background-color #f9f5ff
	&--turquoise
		color #23b3a4
		background-color #f3fffe
	&--olive
		color #90ab5b
		background-color #fbfff3
	&--telegram
		color #27aee3
		background-color #ecfaff
		&:before
			content ''
			display block
			width 12px
			height 10px
			margin-right 10px
			background url('data:image/png;base64,') no-repeat center
	&--notif
		&:after
			@extend .psElem
			top 7px
			right -22px
			width 13px
			height 14px
			background url('data:image/png;base64,') no-repeat center
			z-index 1

.marker-statuses
	display flex
	align-items center
	position relative
	&--no-mt
		margin-top 0
	&__items
		display flex
		align-items flex-start
		margin-bottom -6px
		.marker-status
			margin 0 6px 6px 0
			&:last-child
				margin-right 0
				margin-bottom 0
	&__item
		display flex
		align-items center
		margin 0 6px 6px 0
		&:last-child
			margin-right 0
			margin-bottom 0
		.marker-status
			margin 0 4px 0 0
			&:last-child
				margin-right 0
	&__more
		position relative
		margin-left 6px
	&__more-toggle
		display flex
		align-items center
		justify-content center
		width 29px
		height 29px
		padding 0
		color $default
		font-size 10px
		line-height 10px
		background white
		border 1px solid $border
		border-radius 50%
		transition color $duration, background $duration, transform .2s
		&:hover,
		&--active
			color #fff
			background $red
		&:active
			transform scale(.97)
	&__more-dropdown
		display none
		position absolute
		top calc(100% + 2px)
		right 0
		width 318px
		padding 15px 46px 15px 15px
		background white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 1
		&--right
			left 0
			right auto
		& ^[0]__items
			width 100%
			flex-wrap wrap
	&__edit-btn
		display block
		position absolute
		right 15px
		bottom 15px
		width 25px
		height 25px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border 1px solid transparent
		border-radius 50%
		transition background $duration, border $duration, transform .2s
		z-index 1
		&:hover,
		&.active
			background-image url('data:image/png;base64,')
			border-color $border
		&:active
			transform scale(.97)
	.common-dropdown
		&__list-href
			padding-top 7px
			padding-bottom 6px
