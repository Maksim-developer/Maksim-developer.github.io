.contractor
	max-width 314px
	&:not(:first-child)
		margin-left 23px
	&__name
		display block
		color $default
		font-size 22px
		line-height 24px
		font-weight 600
		letter-spacing -.01em
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__cars
		position relative
		margin-top 4px
	&__cars-toggle
		display block
		position relative
		top 2px
		padding 2px 19px 2px 0
		color #c2c0bd
		font-size 12px
		font-weight 400
		line-height 16px
		white-space nowrap
		text-overflow ellipsis
		background none
		border none
		transition color $duration, transform $duration
		overflow hidden
		cursor pointer
		&:after
			@extend .psElem
			top 7px
			right 0
			width 9px
			height 5px
			background url('data:image/png;base64,') no-repeat center
			transition background $duration, transform $duration
		&:hover,
		&.active
			color #7c7c7a
			&:after
				background-image url('data:image/png;base64,')
		&.active
			&:after
				transform scaleY(-1)
			& + ^[0]__cars-dropdown
				opacity 1
				visibility visible
		&:active
			transform scale(.97)
	&__cars-dropdown
		position absolute
		left 0
		top calc(100% + 2px)
		width 410px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		z-index 1
	&__cars-list
		padding 8px 0
	&__cars-list-item
		line-height 17px
	&__cars-list-href
		display block
		padding 10px 12px
		color $default
		font-size 14px
		line-height 17px
		&:hover
			background-color #fff7f7
