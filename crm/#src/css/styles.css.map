.record-date
	display flex
	align-items center
	@media $mLandscapeMax
		margin-left auto
	&__today-btn
		display flex
		align-items center
		text-align left
		margin-right 30px
		padding 12px 24px
		color $default
		font-size 14px
		font-weight 500
		line-height 16px
		background #f4f4f4
		border none
		border-radius 6px
		transition color $duration, background $duration, transform .2s
		@media $mLandscapeMax
			display none
		&:hover
			color #fff
			background-color $red
			border-color $red
	&__change-btns
		display flex
		align-items center
		margin-right 30px
		@media $mLandscapeMax
			display none
	&__change-btn
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 34px
		height 34px
		margin-right 12px
		background #fff
		border 1px solid #ECEBE9
		border-radius 17px
		transition background $duration, border $duration, trnasform .2s
		&:before
			content ''
			display block
			width 5px
			height 9px
			background url('data:image/png;base64,') no-repeat center
			transition background $duration
		&:hover
			background-color $red
			border-color $red
			&:before
				background-image url('data:image/png;base64,')
		&:active
			transform scale(.97)
		&:last-child
			margin-right 0
		&--prev
			&:before
				transform scaleX(-1)
	&__current
		position relative
	&__current-item
		display block
		padding 0
		color $default
		font-size 16px
		font-weight 600
		line-height 20px
		background none
		border none
		transition color $duration
		@extend .textOverflow
		&:hover
			color $red
	&__current-dropdown
		width 448px
		@media $tPortraitMax
			left auto
			right 0
	&__period
		display flex
		justify-content space-between
		width 100%
		padding 25px 23px 12px
	&__period-aside
		width 106px
	// &__period-items
	&__period-item
		margin-bottom 12px
		&:last-child
			margin-bottom 0
	&__period-btn
		display inline-block
		vertical-align top
		width 100%
		padding 0
		text-align left
		font-size 12px
		font-weight 700
		line-height 14px
		text-transform uppercase
		color #d8d6d2
		background none
		border none
		transition color $duration
		&:hover,
		&--active
			color $default
	&__period-content
		width calc(100% - 124px)
	&__period-selects
		display flex
		justify-content space-between
		width 100%
		margin-bottom 16px
	&__period-select
		&--month
			width calc(100% - 108px)
		&--year
			width 96px
		.jq-selectbox
			&__reset,
			&__select,
			&__select-text
				height 40px
			&__reset
				width 20px
				right 23px
			&__select,
			&__select-text
				font-size 12px
				font-weight 700
				line-height 40px
			&__select-text.placeholder
				font-weight 500
			&__select
				padding-right 42px
			&__select-text
				padding-left 14px
			&__trigger
				width 20px
			&__trigger-arrow
				top 18px
				right 10px
	&__period-datepicker
		.datepicker
			width 100%
			border none
			&--nav,
			&--content
				padding 0
			&--nav
				min-height 40px
				border-bottom none
			&--cells
				margin-right -8px
			&--cell-day
				margin-left 8px
				margin-right 8px
