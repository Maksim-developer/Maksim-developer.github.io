.checkbox-custom
	display flex
	align-items center
	position relative
	&__input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
		&:checked ~ label
			&:after
				content 'Включено'
			span
				background $red
				&:before
					left 20px
	&__label
		display flex
		align-items flex-start
		cursor pointer
		user-select none
		&:after
			content 'Отключено'
			display block
			color black
			font-size 12px
			line-height 16px
			font-weight 300
			transition content $duration
		span
			display block
			position relative
			width 34px
			height 16px
			margin-right 11px
			border-radius 8px
			background-color gainsboro
			transition background $duration
			&:before
				@extend .psElem
				top 2px
				left 2px
				width 12px
				height 12px
				border-radius 6px
				background #fff
				transition left $duration
	&--no-label
		& ^[0]__label
			&:after
				content none
				display none
		& ^[0]__input
			&:checked ~ label
				&:after
					content none
					display none
