.quantity
	display inline-flex
	vertical-align middle
	position relative
	&__btn
		display flex
		align-items center
		justify-content center
		position relative
		flex-shrink 0
		width 26px
		height 26px
		padding 0
		border-radius 13px
		background-color white
		border 1px solid $border
		cursor pointer
		user-select none
		transition background $duration, border $duration, transform .2s
		@media $desktopMax
			display none
		&:hover
			background-color $red
			border-color $red
		&:focus
			outline none
		&:active
			transform scale(.97)
		&--minus,
		&--plus
			&:before
				content ''
				display block
				width 7px
				height 1px
				background-color $default
				transition background $duration
			&:hover
				&:before,
				&:after
					background-color #fff
		&--plus
			&:after
				@extend .psElem
				top 9px
				left 12px
				width 1px
				height 7px
				background-color $default
				transition background $duration
	&__input
		display block
		flex-shrink 0
		width 80px
		height 26px
		margin 0 11px
		padding 6px 10px
		font-size 14px
		line-height 14px
		color $default
		border 1px solid $border
		border-radius 6px
		transition border $duration
		@media $desktopMax
			margin 0
			font-size 13px
		@media $mLandscapeMax
			display none
		&:hover,
		^[0]--warning &
			border-color $red
	&__warning
		display none
		position absolute
		left 37px
		top 100%
		padding 4px 10px 3px
		color white
		font-size 10px
		line-height 14px
		white-space nowrap
		font-weight 500
		background-color $red
		border-radius 6px
		z-index 1
		@media $desktopMax
			left 0
		@media $mLandscapeMax
			display none
		^[0]--warning &
			display block
			@media $mLandscapeMax
				display none
		&:before
			@extend .psElem
			top -5px
			left 9px
			width 0
			height 0
			border-style solid
			border-width 0 6.5px 7px 6.5px
			border-color transparent transparent $red transparent
			z-index 1
	&__mobile
		display none
		color $default
		font-size 12px
		line-height 14px
		@media $mLandscapeMax
			display block
	&--min
		& ^[0]__input
			@media $desktopMax
				width 50px
