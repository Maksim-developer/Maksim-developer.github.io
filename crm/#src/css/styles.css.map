.container
	width 100%
	margin 0 auto
	max-width 1200px

.row
	display flex
	flex-wrap wrap
	margin-left -12px
	margin-right -12px
	@media $mLandscapeMax
		margin-left 0
		margin-right 0
		

[class*="col-"]
	margin 0 12px

	figure:not([class])
		&:first-child
			margin-top 0
		&:last-child
			margin-bottom 0


for num in (1..12)
	.col-{num}
		width 'calc(100%/%s - 24px)' %(12/num)

.col-3,
.col-4,
.col-6
	@media $mLandscapeMax
		width 100%
		margin 0 0 16px
		&:last-child
			margin-bottom 0
