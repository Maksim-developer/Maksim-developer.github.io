.form-search
	display block
	position relative
	width 100%
	max-width 1204px
	&:not(:last-child)
		margin-right 28px
		@media $tPortraitMax
			margin-right 16px
	&__input
		display block
		width 100%
		height 48px
		padding 10px 60px 10px 17px
		color $default
		font 500 14px/28px 'Montserrat', sans-serif
		background #fff
		border 1px solid #eeedec
		border-radius 10px
		transition border .2s
		@media $tPortraitMax
			height 34px
			padding 3px 48px 3px 14px
			font-size 12px
		&:active,
		&:focus
			border 2px solid $red
			outline none
		+placeholder()
			color #d8d6d2
	&__clear-button
		display flex
		justify-content center
		align-items center
		width 48px
		height 48px
		position absolute
		top 0
		right 0
		padding 0
		background none
		border none
		border-top-right-radius 10px
		border-bottom-right-radius 10px
		opacity 0
		visibility hidden
		transition opacity $Duration, visibility $Duration, transform .2s
		z-index 1
		@media $tPortraitMax
			width 34px
			height 34px
		&:active
			transform scale(.9)
		&:hover
			&:before
				opacity 1
		&:before
			content ''
			display block
			width 10px
			height 10px
			background url('data:image/png;base64,') no-repeat center
			background-size contain
			opacity .25
			transition opacity $duration
			z-index 1
	&__dropdown
		display none
		position absolute
		left 0
		right 0
		top calc(100% + 4px)
		width 100%
		max-height 321px
		background-color white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		overflow hidden
		z-index 99
	&__axis-y
		max-height 321px
	&__list-title
		color #acacac
		font-size 14px
		line-height 16px
		font-weight 600
		padding 10px 13px 7px
	&__list
		padding 8px 0
	&__list-item
		&:last-child
			& ^[0]__list-href
				.spare-parts,
				.marker-statuses
					&__more-dropdown
						top auto
						bottom calc(100% + 2px)
	&__list-href
		display block
		position relative
		padding 9px 16px 8px
		color $default
		font-size 14px
		line-height 16px
		font-weight 500
		background-color #fff
		transition background $duration
		&:hover
			background-color #fff7f7
			& ^[0]__list-item-add
				opacity 1
				visibility visible
		.spare-parts,
		.marker-statuses
			margin-top 10px
			&__more-dropdown
				right auto
				left 0
	&__list-item-add
		display block
		position absolute
		top 50%
		transform translateY(-50%)
		right 26px
		width 30px
		height 30px
		padding 0
		background url('data:image/png;base64,') no-repeat center, $red
		border-radius 15px
		border none
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration, transform .2s
		z-index 1
		&:active
			transform translateY(-50%) scale(.97)
	&__source
		position absolute
		top 0
		left 0
		height 100%
		z-index 100
		&:after
			@extend .psElem
			top 12px
			right 0
			width 1px
			height 24px
			background-color #F5F4F1
			@media $tPortraitMax
				top 5px
	&__source-toggle
		display flex
		align-items center
		width 120px
		height 100%
		padding 0 34px 0 14px
		text-align left
		color $default
		font-family Montserrat
		font-size 14px
		font-weight 500
		white-space nowrap
		background none
		border none
		border-top-left-radius 10px
		border-bottom-left-radius 10px
		cursor pointer
		user-select none
		&:focus
			outline none
		&.active
			&:after
				transform scaleY(-1)
		&:after
			@extend .psElem
			top 22px
			right 15px
			width 9px
			height 5px
			background url('data:image/png;base64,') no-repeat center
			transition transform .4s
			pointer-events none
			z-index 1
			@media $tPortraitMax
				top 15px
		span
			display block
			white-space nowrap
			text-overflow ellipsis
			overflow hidden
			pointer-events none
	&--accent,
	&--not-empty
		& ^[0]__input
			border 2px solid $red
			outline none
	&--not-empty
		& ^[0]__clear-button
			opacity 1
			visibility visible
	&--work,
	&--goods,
	&--procenka
		& ^[0]__list-title,
		& ^[0]__list-href
			display flex
		& ^[0]__list-href-cell
			display block
			padding-right 24px
		& ^[0]__list-href-text
			display block
			white-space nowrap
			text-overflow ellipsis
			overflow hidden
	&--work
		& ^[0]__list-href-cell
			&:first-child
				width 37%
			&:nth-child(2)
				width 16%
			&:nth-child(3)
				width 47%
	&--goods,
	&--procenka
		& ^[0]__list-href-cell
			&:first-child
				width 34%
				@media $tPortraitMax
					width 60%
			&:nth-child(2)
				width 14%
				@media $tPortraitMax
					width 20%
			&:nth-child(3)
				width 14%
				@media $tPortraitMax
					width 20%
			&:nth-child(4)
				width 38%
				@media $tPortraitMax
					width 20%
	&--have-source
		& ^[0]__input
			padding-left 136px
	&--update-history
		max-width 1444px
	&--spare-parts
		max-width 1032px
	&--center-position
		margin auto
	&--large
		& ^[0]__input
			height 58px
			padding-top 13px
			padding-bottom 13px
			font-size 16px
			@media $tPortraitMax
				height 34px
				padding-top 3px
				padding-bottom 3px
				font-size 12px
		& ^[0]__clear-button
			height 58px
			@media $tPortraitMax
				height 34px
