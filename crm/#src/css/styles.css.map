.button-group
	display flex
	flex-wrap wrap
	width 100%
	margin-bottom 24px
	@media $mLandscapeMax
		margin-bottom 0
		padding 0 16px 5px
		border-bottom 1px solid $border
	&__item
		position relative
		margin-bottom 11px
		margin-right 16px
		@media $mLandscapeMax
			margin-bottom 10px
			margin-right 10px
			line-height normal
		// &--back
		&--post
			@media $mLandscapeMax
				order 10
				margin-left auto
		&--save
			@media $mLandscapeMax
				order 11
				margin-right 0
		&--print
			@media $mLandscapeMax
				display none
		&--status
			.tags-dropdown
				@media $tPortraitMax
					left -40px
	&__btn
		display flex
		align-items center
		height 46px
		@media $mLandscapeMax
			height 30px
		&--status
			padding 0 25px
			font-size 14px
			font-weight 500
			background-color #f4f4f4
			border none
			border-radius 6px
			user-select none
			@media $mLandscapeMax
				padding 0 20px
				font-size 12px
