.task-search
	display block
	position relative
	width 100%
	max-width 1378px
	height 48px
	padding 5px
	background #fff
	border 1px solid #eeedec
	border-radius 10px
	transition border .2s
	@media $tPortraitMax
		height 34px
	&:not(:last-child)
		margin-right 28px
		@media $tPortraitMax
			margin-right 16px
	&--active,
	&--focus
		border 2px solid $red
	&__dropdown
		display none
		position absolute
		left 0
		top calc(100% + 4px)
		width 100%
		max-width 720px
		min-height 326px
		background white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 2
	&__dropdown-content
		display flex
		width 100%
	&__filter
		display flex
		flex-direction column
		width 208px
		border-right 1px solid $border
	&__filter-top
		display flex
		justify-content center
		align-items center
		width 100%
		height 36px
		border-bottom 1px solid $border
	&__filter-title
		color #acacac
		font-size 9px
		font-weight 600
		line-height 12px
		text-align center
		text-transform uppercase
	&__filter-item
		display flex
		justify-content space-between
		align-items center
		width 100%
		padding 8px 12px 8px 12px
		border-bottom 1px solid $border
		&--active
			& ^[0]__filter-btn
				font-weight 600
	&__filter-btn
		display block
		padding 0
		height 24px
		color $default
		font-size 12px
		font-weight 400
		line-height 24px
		white-space nowrap
		text-overflow ellipsis
		background none
		border none
		overflow hidden
		transition font .2s
		&:hover
			font-weight 600
	&__filter-actions
		display flex
		justify-content flex-end
		margin-left 12px
		flex-shrink 0
	&__filter-action
		margin-left 4px
		&:first-child
			margin-left 0
	&__filter-action-btn
		display flex
		justify-content center
		align-items center
		width 16px
		height 16px
		padding 0
		background none
		border none
		transition transform .2s
		&:hover
			&:before
				opacity 1
		&:active
			transform scale(.93)
		&:before
			content ''
			display block
			width 10px
			height 10px
			background-repeat no-repeat
			background-position center
			opacity .4
			transition background $duration, opacity $duration
		&--move
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAHBAMAAADDgsFQAAAAD1BMVEUAAAATExITExITExITExJj28GFAAAABHRSTlMACe32A0yHnQAAABxJREFUCNdjEHYBAgZkIGQMBAyMgkAAFWFSAgIAQ1oC0VukjbIAAAAASUVORK5CYII=')
		&--edit
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAIBAMAAAA2IaO4AAAAMFBMVEUAAAATExITExITExITExITExITExITExITExITExITExITExITExITExITExITExLpL3/+AAAAD3RSTlMAgB7q/LXi1sJ4ZFhSNAvqGyn6AAAAKklEQVQI12NgYOBzBRJ3+hkYmL6sZmBQ/i/AwGT/EcJgiAcyGMomMDAAALD9CUySc07mAAAAAElFTkSuQmCC')
		&--delete
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAIBAMAAAA2IaO4AAAAIVBMVEUAAAATExITExITExITExITExITExITExITExITExITExKG8Y2lAAAACnRSTlMA7XNfXDlqZz41lpN2HgAAADFJREFUCNdjEGdgKGTQcmBZxMC8NMqAgSFqKQMDw6yVDAwsK7ocGLQMmBcxiDEwJAIAnB0H+SksS1wAAAAASUVORK5CYII=')
	&__filter-bottom
		display flex
		justify-content space-between
		align-items center
		width 100%
		margin-top auto
		padding 12px
	&__filter-create-btn,
	&__filter-settings-btn
		display flex
		align-items center
		padding 0
		background none
		border none
		&:hover
			&:before
				opacity 1
		&:before
			content ''
			display block
			flex-shrink 0
			width 12px
			height 15px
			background-repeat no-repeat
			background-position center
			opacity .4
			transition background $duration, opacity $duration
	&__filter-create-btn
		color #acacac
		font-size 12px
		font-weight 600
		line-height 14px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
		transition color $duration
		&:hover
			color $default
		&:before
			margin-right 10px
			background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMAQMAAABsu86kAAAABlBMVEUAAAATExIpUZQ8AAAAAXRSTlMAQObYZgAAABJJREFUCNdjYGNAQf8/ABGaIABKJQQb5VHmHwAAAABJRU5ErkJggg==')
	&__filter-settings-btn
		justify-content center
		width 24px
		height 24px
		transition transform .2s
		&:active
			transform scale(.93)
		&:before
			background-image url('data:image/png;base64,')
		&--active
			&:before
				opacity 1
	&__settings
		width calc(100% - 208px)
		padding 12px 15px 30px
		.task-statuses__item-input
			min-width 100px
	&__settings-items
		margin-bottom 30px
	&__settings-item
		margin-bottom 20px
		&:last-child
			margin-bottom 0
	&__settings-item-title
		margin-bottom 10px
		color #acacac
		font-size 9px
		font-weight 600
		line-height 12px
		text-transform uppercase
	&__settings-item-field
		position relative
		width 100%
		padding 5px
		border 1px solid $border
		border-radius 6px
		&.active
			&:after
				transform scaleY(1)
		&:after
			@extend .psElem
			right 10px
			bottom 10px
			width 7px
			height 4px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAEBAMAAACw6DhOAAAAIVBMVEUAAACsrKysrKysrKysrKysrKysrKysrKysrKysrKysrKwAeKvPAAAACnRSTlMAXOyabm1jV1JPBdNtjwAAABxJREFUCNdjUGNgVGCIEpByYGBfvJCBgWFWAwMAGzcDcXX/Z+QAAAAASUVORK5CYII=') no-repeat center
			transform scaleY(-1)
			transition transform $duration
			pointer-events none
			z-index 1
	&__settings-item-dropdown
		display none
		width 100%
		z-index 2
		&.common-dropdown
			.checkbox--with-label
				.checkbox__label
					font-size 12px
	&__settings-buttons
		display flex
		justify-content flex-end
		margin-top auto
		.btn + .btn
			margin-left 16px
