.mailing-steps
	display flex
	align-items center
	position absolute
	top 31px
	right 42px
	z-index 1
	&__item
		display flex
		align-items center
		flex-shrink 0
		margin-right 20px
		color #d8d6d2
		font-size 14px
		font-weight 600
		line-height 16px
		transition color $duration
		&:before,
		&:after
			content ''
			display block
			flex-shrink 0
			transition background $duration, border $duration
			box-sizing border-box
		&:before
			width 46px
			height 46px
			margin-right 19px
			background-color white
			background-repeat no-repeat
			background-position center
			border 1px solid #eeedec
			border-radius 6px
		&:after
			width 0
			height 0
			margin-left 20px
			border-style solid
			border-width 3px 0 3px 3px
			border-color transparent transparent transparent #d8d6d2
		&:last-child
			margin-right 0
			&:after
				content none
				display none
		&--create
			&:before
				background-image url('data:image/png;base64,')
			&^[0]__item--active
				&:before
					background-image url('data:image/png;base64,')
		&--recipients
			&:before
				background-image url('data:image/png;base64,')
			&^[0]__item--active
				&:before
					background-image url('data:image/png;base64,')
		&--send
			&:before
				background-image url('data:image/png;base64,')
			&^[0]__item--active
				&:before
					background-image url('data:image/png;base64,')
		&--active
			color $default
			&:after
				border-color transparent transparent transparent $default
		&--completed
			color #2caf2c
			&:before
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABEAAAANBAMAAAC9V5gpAAAAKlBMVEUAAAAsrywsrywsrywsrywsrywsrywsrywsrywsrywsrywsrywsrywsryw9mHY8AAAADXRSTlMAzin59sgt0yQomJJOQ+7WWgAAAERJREFUCNdjgALWABhL9gKUwXg5ASZkBBO6ogATcgISp8GqQEK1BUAhM5BEynWoEAOHb1CsJ0R1y12QEETQCGbRLIjxAC/dDmpsEXlzAAAAAElFTkSuQmCC')
				background-color #f2fff2
				border-color #f2fff2
			&:after
				border-color transparent transparent transparent #f2fff2
