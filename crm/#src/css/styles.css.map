.filter-item
	position relative
	&:not(:last-child)
		margin-right -1px
	&--letter
		& ^[0]__popup
			display none
			align-items center
			position absolute
			top 100%
			left 0
			padding 6px
			background #fff
			border 1px solid #ebebeb
			border-radius 3px
			box-shadow 0 0 35px rgba(0, 0, 0, 0.1)
			z-index 1
		& ^[0]__list
			display flex
		& ^[0]__list-button
			width 24px
			height 24px
			padding 0
			text-align center
			color $default
			font-size 12px
			font-weight 300
			line-height 24px
			border-radius 12px
			background #fff
			border none
			transition background $duration, border $duration
			cursor pointer
			user-select none
			&:focus
				outline none
			&:hover,
			&.active
				background-color #fef3f3
		& ^[0]__popup-close
			width 24px
			height 24px
			padding 0
			background url('data:image/png;base64,') no-repeat center #fff
			border none
			border-radius 12px
			transition opacity $duration
			opacity .3
			cursor pointer
			user-select none
			&:focus
				outline none
			&:hover
				opacity 1
	&--columns
		& ^[0]__popup
			display none
			position absolute
			top 100%
			left 0
			width 378px
			padding 27px 24px 39px
			background #fff
			border 1px solid #ebebeb
			border-radius 8px
			box-shadow 0 0 35px rgba(0, 0, 0, 0.1)
			z-index 1
		& ^[0]__popup-close
			position absolute
			top 8px
			right 8px
			width 24px
			height 24px
			padding 0
			background url('data:image/png;base64,') no-repeat center #fff
			border none
			border-radius 12px
			transition opacity $duration
			opacity .3
			cursor pointer
			user-select none
			&:focus
				outline none
			&:hover
				opacity 1
		& ^[0]__list-item
			line-height 17px
			&:not(:last-child)
				margin-bottom 14px
	&__toggle
		display block
		padding 6px 10px 7px
		color $default
		font-size 12px
		font-weight 300
		line-height 12px
		white-space nowrap
		background-color #fff
		border 1px solid #d9d9d9
		transition background $duration, border $duration
		cursor pointer
		user-select none
		&:focus
			outline none
		&:hover,
		&.active
			background-color #fff4f4
			border-color #e3cbcb
	&__popup-title
		color black
		font-size 14px
		line-height 17px
		font-weight 400
		margin-bottom: 27px;
	&__save-button
		width 100%
		margin-top 38px
	&__checkbox
		display inline-block
		vertical-align top
		position relative
	&__checkbox-input
		position absolute
		top 0
		left 0
		opacity 0
		z-index -1
		&:checked ~ label
			&:before
				background-color #ffe7e7
				border-color #d6b7b7
			&:after
				opacity 1
	&__checkbox-label
		display block
		position relative
		padding-left 33px
		color black
		font-size 14px
		line-height 17px
		font-weight 300
		cursor pointer
		user-select none
		&:hover
			&:before
				background-color #ffe7e7
				border-color #d6b7b7
		&:before
			@extend .psElem
			top 0px
			left 0px
			width 15px
			height 15px
			background-color white
			border 1px solid #ececec
			border-radius 2px
			transition background $duration, border $duration 
			user-select none
			cursor pointer
		&:after
			@extend .psElem
			top 5px
			left 4px
			width 8px
			height 4px
			border-left 1px solid #000
			border-bottom 1px solid #000
			transform rotate(-45deg)
			opacity 0
			transition opacity $duration
			cursor pointer
