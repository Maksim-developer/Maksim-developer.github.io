.payment-table
	margin-top 76px
	@media $tPortraitMax
		margin-top 25px
	@media $mLandscapeMax
		margin-top 52px
	&:first-child
		margin-top 0
	&__title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		margin-bottom 20px
		@media $mLandscapeMax
			font-size 12px
			font-weight 700
			line-height 14px
			margin-bottom 10px
		& + .table-wrap
			.table__cost
				@media $mLandscapeMax
					top 16px
	&__total-summ
		margin-top 25px
		color $default
		font-size 14px
		font-weight 300
		line-height 21px
		span
			font-size 16px
			font-weight 500
