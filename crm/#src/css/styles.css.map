.document-info
	display flex
	width 100%
	margin-bottom 25px
	padding-top 5px
	&__left
		margin-right 49px
	&__title
		margin-top -5px
		margin-bottom 6px
	&__client
		color #c2c0bd
		font-size 14px
		font-weight 400
		line-height 14px
		strong
			margin 0 3px 0 5px
	&__tags
		display flex
	&__tags-item
		position relative
		&:not(:last-child)
			margin-right 10px
	&__tags-item-marker,
	&__tags-item-btn
		display flex
		align-items center
		height 40px
		padding 0 25px
		font-size 14px
		font-weight 500
		border-radius 6px
		user-select none
	&__tags-item-marker
		color $default
		background-color #f4f4f4
	&__tags-item-btn
		color #2caf2c
		background-color #f2fff2
		cursor pointer
