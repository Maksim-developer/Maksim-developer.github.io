.record-table
	width 100%
	height calc(100vh - 160px)
	border-top 1px solid $border
	@media $desktopMax
		height calc(100vh - 130px)
	@media $mLandscapeMax
		height calc(100vh - 154px)
	&__container
		display flex
		flex-direction column
		flex-shrink 0
		min-width 100%
		height 100%
	&__head
		& ^[0]__column:not(.record-table__column--time)
			& ^[0]__cell
				&:before
					content ''
					display block
					width 30px
					height 22px
					margin-top 4px
					margin-right 10px
					background url('data:image/png;base64,') no-repeat center
					@media $mPortraitMax
						margin-top 0px
						margin-right 12px
						width 20px
						height 20px
						background-size contain
		& ^[0]__cell
			display flex
			height 70px
			padding 19px 10px
			color $default
			font-size 14px
			font-weight 600
			line-height 14px
			@media $mPortraitMax
				height 42px
				padding 10px 8px
				font-size 10px
				line-height 12px
				font-weight 700
			span
				@media $mLandscapeMax
					display none
	&__body
		height calc(100% - 70px)
		@media $mPortraitMax
			height calc(100% - 42px)
		& ^[0]__column--time
			& ^[0]__cell
				padding-top 9px
				@media $mPortraitMax
					padding-right 4px
		& ^[0]__cell
			height 93px
			padding 4px
			@media $mPortraitMax
				height 79px
				padding 2px
	&__axis-x
		height 100%
	&__axis-y
		height 100%
	&__time-indicator
		position absolute
		top 0
		left 72px
		width calc(100% - 72px)
		height 2px
		background-color $red
		opacity 0
		visibility hidden
		pointer-events none
		z-index 1
		@media $LargeDesktopMax
			left 52px
			width calc(100% - 52px)
		@media screen and (max-width:1023px)
			left 46px
			width calc(100% - 46px)
		&--visible
			opacity 1
			visibility visible
			transition opacity .2s, visibility .2s
		&:before
			@extend .psElem
			top -3px
			left -7px
			width 0
			height 0
			border-style solid
			border-width 4px 0 4px 8px
			border-color transparent transparent transparent $red
	&__columns
		display flex
		position relative
		width 100%
	&__column
		flex-shrink 0
		border-right 1px solid #f5f4f1
		&:not(.record-table__column--time)
			width 420px
			@media $LargeDesktopMax
				width 300px
			@media screen and (max-width:1023px)
				width 216px
			@media $mLandscapeMax
				width calc(100%/3 - 17px)
		&--time
			width 66px
			@media $LargeDesktopMax
				width 46px
			@media screen and (max-width:1023px)
				width 40px
	&__cell
		border-bottom 1px solid #f5f4f1
		@media $desktopMax
			user-select none
		&:hover
			& ^[0]__add-record-btn
				opacity 1
				visibility visible
				transition opacity .2s, visibility .2s
	&__cell-time
		text-align right
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		@media $mPortraitMax
			font-size 10px
			line-height 12px
	&__add-record-btn
		display flex
		width 100%
		height 100%
		background $border
		border none
		border-radius 6px
		opacity 0
		visibility hidden
		@media $desktopMax
			display none
		span
			display flex
			justify-content center
			align-items center
			width 35px
			height 100%
			margin-left auto
			background-color red
			border-radius 6px
			&:before
				content ''
				display block
				width 12px
				height 12px
				background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAMAAABhq6zVAAAAM1BMVEUAAAD///////////////////////////////////////////////////////////////+3leKCAAAAEHRSTlMAB+pCSfLs0bUu4nU1JRwVzlQ/IgAAAElJREFUCNdljVkOgEAIQ5Ft3O39T2tDHMfE90EDoa0U83pKZwJ8LAmTF8X+nEnCOelV1QSC0gQf5DIzD2yUpQccI1ph/9KiRf3ftukCYq1ewbkAAAAASUVORK5CYII=') no-repeat center
	&__item
		display flex
		flex-direction column
		position relative
		width 100%
		height 100%
		padding 6px 10px
		background-color #f2fff2
		border 1px solid #2caf2c
		border-radius 6px
		box-shadow 0 6px 9px 1px #d9d9d9
		cursor pointer
		@media $mLandscapeMax
			padding 4px 4px 4px 6px
		&:hover
			box-shadow 0 6px 9px 1px rgba(255,255,255, 0)
			transition box-shadow .2s
		&:before
			@extend .psElem
			top 0
			left 0
			width 4px
			height 100%
			background-color #2caf2c
			border-radius 4px 0px 0px 4px
		&--big
			& ^[0]__item-top
				& ^[0]__item-type
					display none
			& ^[0]__item-car-row
				flex-direction column
				justify-content flex-start
				align-items flex-start
			& ^[0]__item-car-title
				margin-right 0
				margin-bottom 4px
			& ^[0]__item-repairman
				@media $LargeDesktopMax
					display block
			& ^[0]__item-bottom
				display block
		&--gray
			background-color #e8e8e9
			border-color #8e8e91
			&:before
				background-color #8e8e91
			& ^[0]__item-time
				&:hover
					background-color #cdcdcd
			& ^[0]__item-type
				color #8e8e91
			& ^[0]__item-order
				background-image url('data:image/png;base64,')
		&--blue
			background-color #c2daf6
			border-color #0079fe
			&:before
				background-color #0079fe
			& ^[0]__item-time
				&:hover
					background-color #acc5e1
			& ^[0]__item-type
				color #0079fe
			& ^[0]__item-order
				background-image url('data:image/png;base64,')
		&--red
			background-color #ffefef
			border-color red
			&:before
				background-color red
			& ^[0]__item-time
				&:hover
					background-color #f6cbcb
			& ^[0]__item-type
				color red
			& ^[0]__item-order
				background-image url('data:image/png;base64,')
	&__item-top
		display flex
		width 100%
		margin-bottom 5px
		@extend .textOverflow
		@media $mLandscapeMax
			margin-bottom 0
	&__item-time
		height 15px
		flex-shrink 0
		margin-right 8px
		padding-left 3px
		padding-right 3px
		color $default
		font-size 12px
		font-weight 500
		line-height 15px
		border-radius 3px
		transition background $duration
		user-select none
		cursor move
		@media $mPortraitMax
			font-size 10px
			line-height 12px
		&:hover
			background-color #00800026
	&__item-top-right
		display flex
		align-items flex-start
		margin-left auto
		@extend .textOverflow
		@media $mLandscapeMax
			display none
	&__item-type
		color #2caf2c
		font-size 9px
		font-weight 600
		line-height 9px
		text-transform uppercase
		@extend .textOverflow
		@media $mLandscapeMax
			display none
	&__item-order
		flex-shrink 0
		display block
		width 16px
		height 16px
		margin-left 8px
		background url('data:image/png;base64,') no-repeat center
		border none
		user-select none
		cursor pointer
	&__item-car-number
		display inline-block
		vertical-align top
		min-width 100px
		height 25px
		margin-bottom 8px
		padding-left 7px
		padding-right 7px
		color $default
		font-size 14px
		font-weight 500
		line-height 23px
		white-space nowrap
		background-color #fefefe
		border 1px solid #d5d5d5
		border-radius 3px
		@media $mPortraitMax
			min-width 74px
			height 20px
			padding-left 2px
			padding-right 2px
			font-size 11px
			line-height 18px
		span
			font-weight 700
	&__item-car-row
		display flex
		justify-content space-between
		width 100%
	&__item-car-title,
	&__item-repairman
		max-width 100%
		@extend .textOverflow
	&__item-car-title
		color $default
		font-size 12px
		font-weight 500
		line-height 14px
		margin-right 12px
		@media $LargeDesktopMax
			margin-right 0
		@media $mPortraitMax
			font-size 10px
			line-height 12px
	&__item-repairman
		color #8e8e91
		font-size 12px
		font-weight 400
		line-height 14px
		border-bottom 1px solid transparent
		transition border $duration
		@media $LargeDesktopMax
			display none
		&:hover
			border-bottom-color rgba(142, 142, 145, .5)
	&__item-bottom
		display none
		margin-top auto

	// &--number-lifts-3
	&--number-lifts-2
		& ^[0]__column
			&:not(.record-table__column--time)
				@media $mLandscapeMax
					width calc(50% - 22px)
