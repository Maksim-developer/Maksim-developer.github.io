.jq-selectbox
	width 100%
	/ .readonly &
		pointer-events none
		cursor default
	&.focused .jq-selectbox__select
		border 1px solid red
		box-shadow 0px 0px 0px 1px red
	&.opened
		z-index 10 !important
		.jq-selectbox
			&__select
				border 1px solid red
				box-shadow 0px 0px 1px 1px red
			&__trigger-arrow
				transform scaleY(-1)
	&:not(.dropup)
		& ^[0]__dropdown
			top 51px
			@media $mLandscapeMax
				top 42px
	&__axis-y
		overflow hidden
		ul
			height auto !important
			max-height none !important
	&__axis-y,
	ul
		max-height 300px
		padding 0
	li
		position relative
		padding 9px 16px 8px
		color #131312
		font 500 14px/16px 'Montserrat', sans-serif
		white-space normal
		border none
		transition color .3s
		cursor pointer
		&:not(:first-child)
			border-top 1px solid #f2f2f2
		&.sel, &.selected, &:hover
			background-color #fff7f7
			color #131312
		&.sel, &.selected
			font-weight 500
		& + li
			margin-top 0
		&:before
			display none
			content none
	&__select
		position relative
		width 100%
		min-width auto
		height 50px
		padding-right 54px
		padding-top 0
		padding-left 0
		line-height 48px
		background #fff
		border 1px solid #eeedec
		border-radius 6px
		box-shadow 0px 0px 0px 1px transparent
		transition border $duration, box-shadow $duration
		@media $mLandscapeMax
			height 38px
			line-height 36px
		/ .readonly &
			background-color #f9f9f9
			border-color #eeedec
			box-shadow 0px 0px 0px 0px transparent
		&-text
			height 50px
			color #131312
			font-size 14px
			line-height 48px
			font-weight 500
			font-family 'Montserrat', sans-serif
			padding 0 0 0 17px
			max-width 100%
			width 100% !important
			@media $mLandscapeMax
				height 38px
				font-size 12px
				line-height 36px
			&.placeholder
				color #d8d6d2
				font-weight 500
		&:hover,
		&:focus
			border-color red
			box-shadow 0px 0px 0px 1px red
			background #fff
		&:active
			box-shadow none
	&__trigger
		position absolute
		top 0
		right 0
		width 36px
		height 100%
		border-left none
		&-arrow
			width 8px
			height 5px
			position absolute
			top 22px
			right 14px
			border none
			@media $mLandscapeMax
				top 16px
			&:before
				@extend .psElem
				width 9px
				height 5px
				background url('data:image/png;base64,') no-repeat center
	&__dropdown
		width auto !important
		min-width 100%
		max-width none
		padding 0
		margin 0
		font-family 'Montserrat', sans-serif
		background white
		border 1px solid #f6f5f3
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		box-shadow none
		overflow hidden
	&__bottom
		border-top 1px solid #f4f4f4
		padding 22px 18px
		a
			display inline-flex
			align-items center
			padding 0
			color #131312
			font-weight 600
			font-size 14px
			line-height 16px
			white-space nowrap
			user-select none
			transition color $duration
			&:hover
				color #4a4a47
				&:before
					background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAHCAQAAABuW59YAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QA/4ePzL8AAAAJcEhZcwAACxIAAAsSAdLdfvwAAAAHdElNRQfmARcSIhK3zlTfAAAALklEQVQI14XKoRWAMBTAwGv3H5GHgjlS8RWKmDORpGtcAVmwfdoeCcn7N0/3cAAu2BKB1wy/7gAAAABJRU5ErkJggg==')
					background-color red
					border-color red
			&:before
				content ''
				display block
				width 17px
				height 17px
				margin-right 12px
				background url('data:image/png;base64,') no-repeat center white
				border 1px solid #f6f5f3
				border-radius 10px
				transition background $duration, border $duration
	&__reset
		width 36px
		height 50px
		padding 0
		position absolute
		top 0
		right 25px
		background url('data:image/png;base64,') no-repeat center
		border none
		opacity 0
		visibility hidden
		z-index 1
		@media $mLandscapeMax
			height 38px
		&:focus
			outline none
	&__search
		width 100%
		margin 0
		border-bottom 1px solid #f6f5f3
		input
			display block
			width 100%
			height 45px
			padding 16px
			color #131312
			font-size 12px
			font-weight 500
			line-height 14px
			background #fff
			border none
			border-radius 0
			border-top-left-radius 6px
			border-top-right-radius 6px
			box-sizing border-box
			box-shadow none
			&::-webkit-input-placeholder
				font 500 14px/14px 'Montserrat', sans-serif
				color #d8d6d2
			&:-moz-placeholder
				font 500 14px/14px 'Montserrat', sans-serif
				color #d8d6d2
			&::-moz-placeholder
				font 500 14px/14px 'Montserrat', sans-serif
				color #d8d6d2
			&:-ms-input-placeholder
				font 500 14px/14px 'Montserrat', sans-serif
				color #d8d6d2
	&__not-found
		margin 0
		padding 9px 16px 8px
		color #131312
		font 500 14px/16px 'Montserrat', sans-serif
		background #fff
	&.changed
		& ^[0]__reset
			opacity 1
			visibility visible
	&--actions
		li
			position relative
			padding 11px 110px 11px 16px
			.actions
				position absolute
				top 1px
				right 16px
				opacity 0
				visibility hidden
				z-index 1
			&:hover
				.actions
					opacity 1
					visibility visible
					transition opacity $duration, visibility $duration
