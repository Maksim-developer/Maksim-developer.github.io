.common-select
	position relative
	width 100%
	&__head
		display flex
		position relative
		width 100%
		min-height 50px
		background #fff
		border 1px solid #ececec
		border-radius 6px
		box-shadow 0px 0px 0px 1px transparent
		transition border $duration, box-shadow $duration
		cursor pointer
		@media $mLandscapeMax
			min-height 38px
		&:hover
			@media $desktop
				border-color $red
				box-shadow 0px 0px 0px 1px $red
		&:focus,
		^[0].opened &,
		/.error &
			border-color $red
			box-shadow 0px 0px 0px 1px $red
		/.readonly &
			background-color #f9f9f9
			border-color #eeedec
			box-shadow 0px 0px 0px 0px transparent
			cursor default
			&:hover,
			&:focus
				box-shadow 0px 0px 0px 0px transparent
	&__selected-items
		display flex
		flex-wrap wrap
		position relative
		max-width 100%
		z-index 2
		^[0].not-empty &
			padding 9px 54px 4px 17px
		& + ^[0]__text
			position absolute
			top 0
			left 0
			^[0].not-empty &
				color transparent
	&__selected-item
		display flex
		align-items center
		position relative
		margin-right 10px
		margin-bottom 5px
		padding 7px 40px 7px 10px
		color #f93d3d
		font 500 14px/16px $baseFontFamily
		background-color #f7e8e8
		border-radius 6px
		text-overflow ellipsis
		transition opacity $duration, visibility $duration
		overflow hidden
	&__selected-item-remove
		position absolute
		top 3px
		right 10px
		width 24px
		height 24px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
		user-select none
		cursor pointer
		transition transform .25s
		z-index 1
		&:active
			transform scale(.87)
	&__text
		display block
		width 100%
		padding 0 54px 0 17px
		text-align left
		color #d8d6d2
		font 500 14px/48px $baseFontFamily
		text-overflow ellipsis
		white-space nowrap
		background none
		border none
		transition color $duration
		overflow hidden
		user-select none
		cursor pointer
		z-index 1
		@media $mLandscapeMax
			font-size 12px
			line-height 36px
	&__reset,
	&__toggle
		position absolute
		top 0
		width 36px
		height 100%
		background none
		border none
		cursor pointer
		user-select none
	&__reset
		right 24px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		opacity 0
		visibility hidden
		z-index 3
		^[0].not-empty &
			opacity 1
			visibility visible
	&__toggle
		display flex
		justify-content center
		align-items center
		right 0
		padding 0 2px 0 0
		z-index 2
		&:before
			@extend .psElem
			width 9px
			height 5px
			background url('data:image/png;base64,') no-repeat center
		^[0].opened &
			&:before
				transform scaleY(-1)
	&__dropdown
		width 100%
	&.not-empty
		& ^[0]__text
			color $default
