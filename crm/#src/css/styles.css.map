.tags-dropdown
	display none
	position absolute
	left 0
	top calc(100% + 4px)
	width 312px
	background-color white
	border 1px solid $border
	border-radius 6px
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	z-index 11
	@media $mPortraitMax
		width 290px
	&--min
		& ^[0]__axis-y
			max-height 194px
	&__axis-y
		max-height 440px
	&__list
		padding 7px 0
	&__list-item
		display flex
		justify-content space-between
		align-items center
		width 100%
		padding 10px
		transition background $duration
		&:hover
			background-color #fbfaf9
	&__list-item-tag
		display block
		max-width 190px
		text-align left 
		font-size 14px
		line-height 16px
		font-weight 500
		padding 11px 25px 13px
		border none
		border-radius 6px
		cursor pointer
		user-select none
	&__bottom
		display flex
		justify-content flex-start
		align-items center
		height 69px
		padding-left 10px
		padding-right 10px
		border-top 1px solid #F5F4F1
	&__create-tag-btn
		display flex
		align-items flex-start
		padding 8px 0
		color $default
		font-size 14px
		line-height 16px
		font-weight 600
		user-select none
		cursor pointer
		transition color $duration, transform $duration
		&:hover
			color #4a4a47
			span
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAcAAAAHCAQAAABuW59YAAAABGdBTUEAALGPC/xhBQAAACBjSFJNAAB6JgAAgIQAAPoAAACA6AAAdTAAAOpgAAA6mAAAF3CculE8AAAAAmJLR0QA/4ePzL8AAAAJcEhZcwAACxIAAAsSAdLdfvwAAAAHdElNRQfmARcSIhK3zlTfAAAALklEQVQI14XKoRWAMBTAwGv3H5GHgjlS8RWKmDORpGtcAVmwfdoeCcn7N0/3cAAu2BKB1wy/7gAAAABJRU5ErkJggg==')
				background-color $red
				border-color $red
		span
			display block
			width 17px
			height 17px
			margin-right 16px
			background url('data:image/png;base64,') no-repeat center white
			border 1px solid $border
			border-radius 10px
			transition background $duration, border $duration
		&:active
			transform scale(.97)
	.os-host-overflow-y
		& ^[0]__list-item
			padding-right 20px

	.actions
		&__item-btn:hover
			background-color #fff
