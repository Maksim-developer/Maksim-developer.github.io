.datepicker
	width 316px
	font-family 'Montserrat'
	background-color #fff
	border 1px solid #f6f5f3
	border-radius 6px
	box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
	z-index 1046
	&--pointer
		display none
		content none
	&--nav
		align-items center
		min-height 60px
		padding 4px 16px
	&--nav-action
		width 23px
		height 23px
		border-radius 12px
		overflow hidden
		&:hover
			background-color #f9f8f7
		svg
			margin-left -3px
			margin-top -2px
	&--nav-title
		color #131312
		font-size 12px
		font-weight 700
		text-transform uppercase
		line-height 14px
		&:hover
			background none
		i
			color #131312
	&--content
		padding 10px 15px 8px
	&--days-names
		margin-bottom 10px
	&--day-name,
	&--cell
		&.-current-
			color red
	&--day-name
		font-size 12px
		color #131312
		font-weight 700
	&--cells-days
		margin-right -9px
	&--cell
		font-size 12px
		color #e1dfdc
		font-weight 500
		&.-current-,
		&.-current-.-focus-
			color red
			border 1px solid red
			background #fff
		&.-focus-,
		&.-selected-,
		&.-selected-.-focus-,
		&.-selected-.-current-
			color #fff
			background red
		&.-in-range-
			color #131312
			background #fff4f4
	&--cell-day
		width 23px
		height 23px
		margin 0 9px 11px
		border-radius 50%
		&.-other-month-
			color #aeaeae
			&.-focus-
				color #fff
	
	&--only-timepicker
		.datepicker
			&--nav,
			&--content
				display none
			&--time
				border-top none

.-selected-.datepicker--cell-day.-other-month-, 
.-selected-.datepicker--cell-year.-other-decade-
	color #fff
	background red

.-in-range-.datepicker--cell-day.-other-month-, 
.-in-range-.datepicker--cell-year.-other-decade-
	color #131312
	background #fff4f4

.datepicker--time-row input[type=range]:focus::-webkit-slider-thumb
	background red
	border-color red

.datepicker--time-row input[type=range]:focus::-moz-range-thumb
	background red
	border-color red

.datepicker--time-row input[type=range]:focus::-ms-thumb
	background red
	border-color red
