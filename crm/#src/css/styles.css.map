
.table-wrap
	position relative
	width 100%
	border-top 1px solid $border
	overflow hidden
	&__axis-x
		width 100%
		height 100%
		overflow-x auto
		&.os-host-overflow-x
			padding-bottom 6px
	&__axis-y
		min-width 100%
		height 100%
		overflow-y auto
		&.os-host-overflow-y
			padding-right 12px
	&__container
		display flex
		width 100%
		height 100%
	&__title
		color $default
		font-size 16px
		font-weight 600
		line-height 24px
		margin-bottom 24px
	&__empty
		padding 64px
		flex-direction column
		justify-content center
		position relative
		&:before
			content ''
			display block
			width 331px
			height 310px
			margin 0 auto 20px
			background url('../../static/images/not-found.png') no-repeat center
	&__empty-text
		text-align center
		color $default
		font-size 24px
		line-height 30px
		font-weight 500
	& + .form
		margin-top 20px
	&--no-overflow
		overflow visible

.table
	flex-grow 1
	min-width 100%
	height 100%
	&--worker
		.table__head .table__cell
			min-height auto
		.table__body .table__cell:first-child
			text-align left
	&--payment
		& ^[0]__head
			& ^[0]__cell
				min-height auto
				color #acacac
		& ^[0]__body 
			& ^[0]__cell
				&:first-child
					text-align left
	&--task
		& ^[0]__body
			& ^[0]__row
				.link--hover
					font-weight 400
				&:hover
					.link--hover
						font-weight 400
						border-bottom-color #000
	&__head
		position relative
		border-bottom 1px solid $border
		& ^[0]__cell
			position relative
			font-weight 700
			min-height 40px
			padding 12px 52px 12px 16px
			@media $desktopMax
				padding-right 20px
				padding-left 14px
			@media $tPortraitMax
				padding-right 14px
				padding-left 12px
			&:first-child
				padding-left 24px
				@media $tPortraitMax
					padding-left 12px
				/.tabs &
					padding-left 0
			&--checkbox
				padding-right 16px
				@media $desktopMax
					padding-right 14px
				@media $tPortraitMax
					padding-right 12px
			&--df
				align-items flex-start
			&--number
				padding-right 36px
				@media $desktopMax
					padding-right 10px
				/.tabs &
					padding-left 26px
					@media $desktopMax
						padding-left 14px
					@media $tPortraitMax
						padding-left 12px
		& ^[0]__cell-title
			position relative
			&[data-sort]
				cursor pointer
				&:after
					content ''
					display inline-block
					vertical-align baseline
					position relative
					top -2px
					width 0
					height 0
					margin-left 2px
					border-style solid
					border-width 4px 4px 0 4px
					border-color $default transparent transparent transparent
					transition transform $duration
			&[data-sort="ASK"]
				&:after
					transform scaleY(-1)
	&__body
		height calc(100% - 42px)
		& ^[0]__row
			border-bottom 1px solid $border
			&:last-child,
			&:nth-last-child(2)
				&:not(:first-child)
					.spare-parts__more-dropdown,
					.marker-statuses__more-dropdown
						top auto
						bottom calc(100% - 30px)
					.spare-parts__more-dropdown
						left 32px
						right auto
			&:last-child
				&:not(:first-child)
					.actions__item-btn:after
						top auto
						bottom calc(100% + 2px)
			&:not(.table__row--no-hover):not(.table__row--active):hover
				background-color #fbfaf9
				.table__cell-btn-add--show-on-hover
					opacity 1
					visibility visible
			&--no-border
				border-bottom-color transparent
			&--active
				background-color #fff7f7
			&--gray
				& ^[0]__cell
					color #d8d6d2
					.spare-parts
						&__item
							color #d8d6d2
							background-color #f1f1f1
						&__more-toggle
							color #d8d6d2
							border-color $border
					.quantity
						&__btn
							border-color $border
							&:before,
							&:after
								background-color #d8d6d2
						&__input,
						&__warning,
						&__mobile
							color #d8d6d2
						&__input
							border-color #f7f6f4
				& ^[0]__cell-prod-prop
					color #d8d6d2
			&--red
				background-color #fff9f9
				& ^[0]__cell,
				& ^[0]__cell-time,
				& ^[0]__cell-provider-title,
				& ^[0]__cell-provider-order
				.link
					color #f93d3d
				& ^[0]__cell-time
					&--vertical
						time
							color #f93d3d
				& ^[0]__cell-provider-title,
				.link
					border-bottom-color #f93d3d
					&:hover
						border-bottom-color transparent
			&--delim
				height 30px
		& ^[0]__cell
			&:first-child
				/.tabs &
					padding-left 0
			&--df
				&:first-child
					justify-content flex-start
		.table__axis-y
			height 100%
			&.os-host-overflow-y
				padding-right 12px
	&__cost
		display none
		position absolute
		top 0
		right 4px
		z-index 1
		@media $mLandscapeMax
			display block
	&__cost-item
		color $default
		font-size 14px
		font-weight 600
		line-height 14px
	&__edit
		display flex
		align-items center
		position absolute
		top 0
		left 0
		width 100%
		height 100%
		background #fff
		z-index 2
		overflow hidden
	&__edit-checkbox
		padding 18px 38px 18px 26px
		@media $desktopMax
			padding-right 12px
		/.tabs &
			padding-left 0
	&__edit-count
		margin-right 34px
		color $default
		font-size 14px
		line-height 16px
		font-weight 700
		@media $desktopMax
			font-size 12px
			line-height 14px
	&__edit-actions
		display flex
	&__edit-action
		line-height 16px
		@media $desktopMax
			line-height 14px
		&:not(:last-child)
			margin-right 55px
			@media $desktopMax
				margin-right 32px
	&__edit-action-btn
		display block
		color $default
		font-size 14px
		line-height 16px
		font-weight 700
		transition color $duration, transform .2s
		@media $desktopMax
			font-size 12px
			line-height 14px
		&:hover
			@media $desktop
				color #4a4a47
		&:active
			transform scale(.97)
	&__row
		display flex
		position relative
		min-width 100%
		&--no-border
			border-bottom-color transparent
		&--toast
			padding-top 19px
			padding-bottom 19px
	&__cell
		flex-shrink 0
		padding 12px 52px 12px 16px
		color $default
		font-size 14px
		line-height 16px
		white-space nowrap
		border-right 1px solid $border
		@media $desktopMax
			padding-right 20px
			padding-left 14px
			font-size 12px
			line-height 14px
		@media $tPortraitMax
			padding-right 14px
			padding-left 12px
			font-size 11px
			line-height 13px
		&:first-child
			padding-left 24px
			@media $tPortraitMax
				padding-left 12px
		&:last-child
			border-right-color transparent
		&--checkbox
			padding-right 16px
			@media $desktopMax
				padding-right 14px
			@media $tPortraitMax
				padding-right 12px
		&--success
			color $green
		&--warning
			color $red
		&--gray
			color #9e9e9e
		&--df
			display flex
			align-items center
			&:first-child
				align-items flex-start
				justify-content flex-start
		&--btn-add
			position relative
			min-width 424px
			padding-right 118px
		&--number
			padding-right 36px
			@media $desktopMax
				padding-right 20px
			@media $tPortraitMax
				padding-right 14px
			/.tabs &
				padding-left 26px
				@media $desktopMax
					padding-left 14px
				@media $tPortraitMax
					padding-left 12px
		&--best-offer
			position relative
			z-index 1
			&:before
				@extend .psElem
				left 0
				top 0
				width 560px
				height 100%
				background -moz-linear-gradient(left, rgb(233,250,236) 0%, rgba(255,255,255, 0) 100%)
				background -webkit-linear-gradient(left, rgb(233,250,236) 0%,rgba(255,255,255, 0) 100%)
				background linear-gradient(to right, rgb(233,250,236) 0%,rgba(255,255,255, 0) 100%)
				z-index -1
			& ~ ^[0]__cell
				position relative
				z-index 1
		.checkbox:first-child:not(:last-child)
			margin-right 27px
		b,
		strong
			font-weight 600
		a
			&[href*="tel:"]
				color $default
				border-bottom 1px solid $default
				transition border $duration
				&:hover
					border-bottom-color transparent
			&[href*="mailto:"]
				color $blue
				border-bottom 1px solid $blue
				transition border $duration
				&:hover
					border-bottom-color transparent
		.actions
			margin-top -6px
			margin-bottom -5px
		.quantity
			margin-right 12px
			@media $mLandscapeMax
				margin-right 16px
		.spare-parts,
		.marker-statuses,
		.marker-status,
		.rating
			margin-top 8px
			@media $tPortraitMax
				margin-top 6px
		.marker-statuses
			&--no-mt
				margin-top 0
		.marker-status
			&:first-child
				margin-top 0
	&__cell-content
		&--mobile
			display none
			align-items flex-end
			width 100%
			margin-top 6px
			@media $mLandscapeMax
				display flex
	&__cell-subtext
		display block
		margin-top 9px
		color #c2c0bd
		font-size 12px
		font-weight 300
		line-height 14px
		@media $desktopMax
			margin-top 8px
		@media $tPortraitMax
			font-size 11px
		&--price-success,
		&--price-warning
			font-size 14px
			font-weight 600
			line-height 16px
			text-align right
			@media $desktopMax
				font-size 12px
				line-height 14px
			@media $tPortraitMax
				font-size 11px
				line-height 13px
		&--price-success
			color $green
		&--price-warning
			color $red
	&__cell-car-number
		font-size 14px
		line-height 18px
		font-weight 500
		margin-bottom 6px
		&:last-child
			margin-bottom 0
		strong
			font-weight 700
	&__cell-car-props
		display table
	&__cell-car-prop
		display table-row
		span
			display table-cell
			font-size 12px
			line-height 18px
			font-weight 400
			color $default
			&:first-child
				color #cfcecb
				font-weight 300
				padding-right 4px
	&__cell-prod-props
		display flex
		flex-wrap wrap
		align-items flex-end
		width 100%
		margin-bottom -5px
	&__cell-prod-prop
		display flex
		align-items center
		margin-right 8px
		margin-bottom 5px
		color $default
		font-size 12px
		line-height 14px
		&:last-child
			margin-right 0
			&:after
				content none
				display none
		&:after
			content '·'
			display block
			margin-left 8px
			color #edeceb
			font-size 12px
			font-weight bold
			line-height 14px
		&--success
			color $green
		&--warning
			color $red
	&__cell-field
		display flex
		width 100%
		& ^[0]__cell-select
			min-width 140px
		&--combi
			& ^[0]__cell-select
				max-width calc(100% - 100px)
				min-width 76px
				.jq-selectbox__select
					border-top-right-radius 0
					border-bottom-right-radius 0
			& ^[0]__cell-input
				border-top-left-radius 0
				border-bottom-left-radius 0
				border-left-color transparent
				&:hover,
				&:focus
					border-left-color $red
	&__cell-input
		display inline-block
		vertical-align top
		width 100px
		flex-shrink 0
		height 26px
		padding 0 11px
		color $default
		font-size 14px
		font-weight 400
		line-height 24px
		border 1px solid $border
		border-radius 6px
		transition border $duration
		&:hover
			border-color $red
	&__cell-select
		&.jq-selectbox
			ul
				padding 10px 0
			li
				display block
				padding 9px 16px 8px
				font-size 14px
				font-weight 500
				line-height 16px
				white-space nowrap
				background-color #fff
				transition background $duration
				&.sel, 
				&.selected,
				&:hover
					background-color #fff7f7
					color $default
				&.sel,
				&.selected
					font-weight 600
				&:not(:first-child)
					border none
			&:not(.dropup) .jq-selectbox__dropdown
				top 30px
		.jq-selectbox
			&__select,
			&__select-text
				height 26px
				font-size 14px
				line-height 24px
				font-weight 400
			&__select
				padding-right 24px
				&:hover,
				&:focus
					box-shadow none
			&__select-text
				padding-left 11px
			&__trigger
				width 24px
			&__trigger-arrow	
				top 9px
				right 10px
			&__reset
				display none
			&__dropdown
				background white
				border 1px solid $border
				border-radius 6px
				box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		&.opened,
		&.focused
			.jq-selectbox__select
				box-shadow none
	&__cell-time
		display flex
		align-items flex-start
		@media $tPortraitMax
			flex-direction column
		a
			@media $tPortraitMax
				align-self flex-start
		a,
		time
			flex-shrink 0
		time
			margin-left 4px
			font-size 14px
			color $default
			font-weight 400
			@media $desktopMax
				font-size 12px
			@media $tPortraitMax
				font-size 11px
				margin-left 0
				margin-top 8px
			&:first-child
				margin-left 0
		&--vertical
			flex-direction column
			time
				margin-left 0
				margin-top 8px
				color #9b9794
				font-family $fontConsolas
	&__cell-time-title
		display flex
		align-items center
	&__cell-props
		display flex
		margin-top 10px
		&--burgundy
			strong
				color #cb4040
		&--brown
			strong
				color #d29864
		&--green
			strong
				color $green
	&__cell-prop
		flex-shrink 0
		margin-right 13px
		padding-right 13px
		border-right 1px solid #c8c6c4
		white-space nowrap
		&:last-child
			padding-right 0
			margin-right 0
			border-right none
	&__cell-btn-add
		display block
		position absolute
		top 50%
		right 64px
		width 30px
		height 30px
		padding 0
		background url('data:image/png;base64,') no-repeat center $red
		border none
		border-radius 15px
		cursor pointer
		user-select none
		transform translateY(-50%)
		transition transform .2s
		z-index 1
		&:active
			transform translateY(-50%) scale(.97)
		&--show-on-hover
			opacity 0
			visibility hidden
			transition opacity $duration, visibility $duration, transform .2s
	&__cell-notif-source
		margin-bottom 8px
	&__cell-notif-prop
		color $default
		font-size 12px
		font-weight 400
		line-height 14px
		margin-bottom 4px
		&:last-child
			margin-bottom 0
		a
			position relative
			top -3px
			color $default
			font-size 12px
			font-weight 600
			line-height 14px
			span
				position relative
				top 2px
				border-bottom 1px solid $default
				transition border $duration
			&:hover
				span
					border-bottom-color transparent
		& > span
			display inline-block
			vertical-align baseline
			min-width 92px
			color #cfcecb
	&__cell-provider
		display flex
		align-items flex-start
		text-decoration none
	&__cell-provider-overimg
		width 25px
		height 25px
		flex-shrink 0
		margin-right 14px
		border-radius 3px
		overflow hidden
	&__cell-provider-img
		width 100%
		height 100%
		object-fit cover
	&__cell-provider-content
		display flex
		flex-direction column
	&__cell-provider-title
		position relative
		align-self flex-start
		top -3px
		font-size 14px
		font-weight 600
		line-height 16px
		color $blue
		border-bottom 1px solid $blue
		transition border $duration, font $duration
		span
			position relative
			top 2px
		&:hover
			border-bottom-color transparent
	&__cell-provider-order
		margin-top 8px
		color #9b9794
		font 400 14px/12px $fontConsolas
		transition color $duration
		&:hover
			color #7d7a78
	&__cell-price
		display flex
		align-items center
		color $default
		font-size 14px
		font-weight 600
		line-height 16px
		&--average,
		&--expensive
			&:after
				content ''
				display block
				margin-left 6px
				width 6px
				height 6px
				border-radius 3px
		&--best
			color $green
		&--average
			&:after
				background-color #fecb2f
		&--expensive
			&:after
				background-color red
	&__toggle-rows
		display block
		position relative
		margin-top 10px
		padding 0
		text-align left
		color #9b9794
		font-size 11px
		font-weight 400
		line-height 13px
		white-space nowrap
		background none
		border none
		border-bottom 1px solid #9b9794
		transition border $duration
		&:hover
			border-bottom-color transparent
		&--collapse
			&:after
				transform scaleY(-1)
		&:after
			@extend .psElem
			top 4px
			right -12px
			width 8px
			height 5px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAFBAMAAACKv7BmAAAAJ1BMVEUAAACjn5yjn5yjn5yjn5yjn5yjn5yjn5yjn5yjn5yjn5yjn5yjn5w6ZJs1AAAADHRSTlMA5dqfOvCmlnQxIQxRQTGnAAAAIUlEQVQI12OwYmDgYIjZwJDDwHSA+QgDg2KNAwMD40kGADoSBOvjA7AIAAAAAElFTkSuQmCC') no-repeat center
			z-index 1
	&__task-status
		padding 6px 22px 5px
		color $default
		font-size 12px
		font-weight 300
		line-height 12px
		white-space nowrap
		background-color #f4f4f4
		border-radius 3px
		&--done
			color #fff
			background-color #68ce68
	&__add-new-worker
		display inline-flex
		align-items center
		height 32px
		padding 0
		color $red
		font-weight 300
		font-size 12px
		line-height 14px
		white-space nowrap
		user-select none
		&:before
			content ''
			display block
			margin-right 7px
			width 14px
			height 14px
			background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAA4AAAAOBAMAAADtZjDiAAAAIVBMVEX/AAD/AAD/AAAAAAD/AAD/AAD/AAD/////0dH/09P/y8t+ps9CAAAABnRSTlPxrScAKCUTY3tgAAAAQ0lEQVQI12MwFUhLS2MMZlBIAwEmBjEwncjAlpbWkZaWwADklAMxgs4oLy9fBqXb0tDlQfo6gfrg5jiAaRYGI7A9ygDHmCOHRkHetAAAAABJRU5ErkJggg==') no-repeat center
	
	& + .form
		margin-top 20px
