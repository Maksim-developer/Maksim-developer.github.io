.creating-letter
	width 100%
	&__actions
		display flex
		margin-left auto
		padding-left 12px
	&__action
		margin-right 16px
		&:last-child
			margin-right 0
	&__action-button
		display flex
		justify-content center
		align-items center
		width 28px
		height 28px
		background none
		border none
		&:before
			content ''
			display block
			background-repeat no-repeat
			background-position center
			transition opacity $duration
		&:hover
			&:before
				opacity .7
		&--collapse
			&:before
				width 16px
				height 2px
				background-color $default
				border-radius 1px
				transform translateY(4px)
		&--close
			&:before
				width 12px
				height 12px
				background-image url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAwAAAAMCAMAAABhq6zVAAAAM1BMVEUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAACjBUbJAAAAEHRSTlMAn4WQqvjzvLWoi2qjf3dyNLLnKQAAAENJREFUCNdljDkWwCAQhRjjbpZ//9OmGH0WUkEDuTC5E6bofqlCUHQ38HL36u9yGFJg8Ukd1ucZ+2nns0Hbz0KuTCz9p4oCI5c4MsQAAAAASUVORK5CYII=')
	&__field
		display flex
		align-items center
		padding 12px 18px
		border-bottom 1px solid $border
	&__field-label
		width 54px
		padding-right 10px
		color $default
		font-size 12px
		font-weight 600
		line-height 28px
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
	&__field-content
		display flex
		align-items center
		width calc(100% - 50px)
	&__field-list-items
		display flex
		flex-wrap wrap
		width 100%
		margin-right 8px
		margin-bottom -4px
		&:last-child
			margin-right 0
	&__field-list-item
		margin-right 12px
		margin-bottom 4px
		&:last-child
			margin-right 0
		&--input
			flex-grow 1
	&__field-address
		display flex
		align-items center
		height 28px
		padding-left 14px
		padding-right 2px
		background-color #eeedec
		border-radius 14px
	&__field-address-text
		color #7f7d7c
		font-size 12px
		font-weight 400
		line-height 12px
		text-decoration underline
	&__field-address-delete
		width 24px
		height 24px
		padding 0
		margin-left 6px
		background url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAMAAADz0U65AAAAPFBMVEUAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADQLyYwAAAAE3RSTlMARvnsp3pqYl44JfXms6yAcC0RrARkoAAAADhJREFUCNcdykkCgCAQxMAMCIq79v//SkNdE3LFvkzRBrsuWBW/FizSUZikBqM/Mb7m7u/lvLGaOjltAaKvV7u9AAAAAElFTkSuQmCC') no-repeat center
		border none
		opacity .4
		transition opacity $duration
		&:hover
			opacity 1
	&__field-input
		display block
		width 100%
		min-width 200px
		height 28px
		padding 0
		color $default
		font 400 14px/28px $baseFontFamily
		background none
		border none
		border-radius 0
	&__attachment
		padding 8px 20px
	&__attachment-button
		display flex
		align-items center
		position relative
		height 24px
		padding 0
		background none
		border none
		cursor pointer
		user-select none
		&:before
			content ''
			display block
			width 11px
			height 11px
			margin-right 6px
			background url('data:image/png;base64,') no-repeat center
		*
			pointer-events none
		& + .uploaded-list
			margin-top 10px
			margin-bottom 8px
	&__attachment-button-title
		color black
		font-size 12px
		font-weight 600
		line-height 14px
	&__attachment-button-input
		position absolute
		left 0
		top 0
		width 0
		height 0
		font-size 0
		opacity 0
		color transparent
		z-index -1
	&__foot
		display flex
		width 100%
		padding-top 24px
		.btn + .btn
			margin-left 16px
	.custom-wysiwyg
		min-height 542px
		border-radius 0

	&--order
		&	^[0]__field,
		&	^[0]__attachment
			padding-left 0
			@media screen and (max-width: 700px)
				padding-left 16px
				padding-right 16px
		&	^[0]__attachment-button + .uploaded-list
			@media screen and (max-width: 700px)
				margin-bottom 0
		&	^[0]__foot
			@media screen and (max-width: 700px)
				padding 16px 16px 0
			.btn
				@media screen and (max-width: 700px)
					padding 7px 11px
					font-size 12px
				& + .btn
					@media screen and (max-width: 700px)
						margin-left 8px
		.custom-wysiwyg
			min-height 320px
			border-left none
			border-right none
			&__head,
			&__text,
			&__signature
				padding-left 0
				@media screen and (max-width: 700px)
					padding-left 16px
					padding-right 16px
		
