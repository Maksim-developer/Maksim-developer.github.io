.car
	display block
	position relative
	outline 2px solid transparent
	transition background $duration, border $duration
	cursor pointer
	&:hover
		background-color #fafafa
		& ^[0]__top
			opacity 1
			visibility visible
	&--active
		outline-color $red
		& ^[0]__top
			opacity 1
			visibility visible
	&__top
		display flex
		justify-content space-between
		width 100%
		position absolute
		top 0
		left 0
		opacity 0
		visibility hidden
		transition opacity $duration, visibility $duration
		user-select none
		z-index 2
	&__action
		position relative
		&.position-right
			& ^[0]__action-dropdown
				left auto
				right 0
	&__action-toggle
		display flex
		justify-content center
		align-items center
		width 17px
		height 17px
		padding 0
		background url('data:image/png;base64,') no-repeat center
		border none
		cursor pointer
		user-select none
	&__action-dropdown
		display none
		position absolute
		top calc(100% + 4px)
		left 0
		width 153px
		background white
		border 1px solid $border
		border-radius 6px
		box-shadow 0 25px 25px rgba(211, 207, 202, 0.25)
		z-index 5
	&__action-items
		padding 15px 0
	&__action-href
		display block
		color black
		font-size 12px
		font-weight 500
		line-height 14px
		padding 12px 20px 11px
		transition background $duration
		&:hover
			background-color #fff7f7
	&__period
		display block
		width 100%
		position absolute
		top 45px
		left 0
		padding 0 10px
		color #b8b6b2
		font-size 12px
		line-height 12px
		font-weight 500
		white-space nowrap
		text-overflow ellipsis
		overflow hidden
		z-index 1
	&__overimg
		display flex
		flex-direction column
		justify-content center
		align-items center
		width 100%
		height 100%
		padding 10px
		user-select none
	&__img
		align-self center
		max-width 100%
		max-height 100%
	&__bottom
		display flex
		flex-direction column
		position absolute
		left 0
		right 0
		bottom 0
		z-index 1
	&__title
		align-self flex-start
		color $default
		font-size 14px
		line-height 16px
		font-weight 600
	&__count-modif
		color #b8b6b2
		font-size 12px
		line-height 14px
		font-weight 500
		&:not(:first-child)
			margin-top 6px
	&__props
		display flex
		margin-bottom -4px
		&:not(:first-child)
			margin-top 8px
	&__props-item
		position relative
		margin-right 16px
		margin-bottom 4px
		padding-left 6px
		color #b8b6b2
		font-size 12px
		line-height 14px
		font-weight 500
		&:before
			@extend .psElem
			top 6px
			left 0
			width 2px
			height 2px
			background-color $red

	&--brands
		width 98px
		height 117px
		background white
		border-radius 10px
		box-shadow 0 10px 10px rgba(211, 207, 202, 0.25)
		& ^[0]__top
			padding 8px 2px 0 8px
		& ^[0]__overimg
			padding 10px 10px 27px
		& ^[0]__bottom
			padding 0 8px 7px
		& ^[0]__title
			align-self center
			text-transform uppercase
	
	&--models,
	&--modif
		width 171px
		height 198px
		border-radius 6px
		& ^[0]__top
			padding 15px 4px 0 10px

	&--models
		& ^[0]__overimg
			padding 10px 10px 29px
		& ^[0]__title
			border-bottom 1px solid $default
		& ^[0]__bottom
			padding 0 11px 15px
	
	&--modif
		& ^[0]__overimg
			padding 10px 10px 8px
		& ^[0]__bottom
			padding 0 11px 13px

	.checkbox
		flex-shrink 0
