.task-participants
	display block
	width 100%
	height 100%
	&__items
		display flex
		flex-wrap wrap
		flex-grow 1
		margin-bottom -6px
	&__item
		display flex
		align-items center
		flex-shrink 0
		height 30px
		margin-right 6px
		margin-bottom 6px
		padding 4px 16px 4px 4px
		color $default
		font-size 12px
		font-weight 400
		line-height 14px
		white-space nowrap
		text-overflow ellipsis
		background #f3f3f3
		border none
		border-radius 15px
		overflow hidden
		&:last-child
			margin-right 0
		&:before
			content ''
			display block
			flex-shrink 0
			width 22px
			height 22px
			margin-right 15px
			background url('data:image/png;base64,') no-repeat center, #d8d8d8
			border-radius 11px
